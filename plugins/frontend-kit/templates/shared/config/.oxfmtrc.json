{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "trailingComma": "all",
  "ignorePatterns": [
    ".claude/**",
    "CLAUDE.md",
    "dist/**",
    ".output/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    ".vitest/**",
    "src/routeTree.gen.ts",
    "package-lock.json"
  ]
}
