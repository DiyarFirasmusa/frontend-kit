{
  "description": "wajiha-kit guards (git, live site, secrets, deploy config), format + lint on edit, and quality gates. Project values come from .claude/wajiha-kit.json.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-context.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/prompt-hints.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/skill-suggest.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/mode-prompt.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Monitor|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Skill|EnterWorktree|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/mode-guard.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|PowerShell|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-bash.sh",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/commit-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|LSP|mcp__(plugin_[A-Za-z0-9_-]+_)?(chrome-devtools|playwright)__.+|mcp__claude-in-chrome__file_upload)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-paths.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^(WebFetch|mcp__(plugin_[A-Za-z0-9_-]+_)?chrome-devtools__(navigate|navigate_page|new_page|install_pwa|launch_pwa|mock_network)|mcp__(plugin_[A-Za-z0-9_-]+_)?playwright__(browser_navigate|browser_tabs)|mcp__claude-in-chrome__(navigate|tabs_create_mcp|browser_batch)|mcp__(remote-devices__)?Claude_Browser__(navigate|preview_start|browser_batch))$",
        "hooks": [
          {
            "type": "command",
            "command": "bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-url.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/bash-edit-track.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/post-edit.sh",
            "timeout": 60,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/bash-edit-track.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(wajiha-kit:)?(frontend-dev|test-engineer|refactor-architect)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/subagent-gate.sh",
            "timeout": 180,
            "statusMessage": "Typecheck before the agent reports back"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stop-gate.sh",
            "timeout": 120,
            "statusMessage": "Quality gate: typecheck + related tests"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-end.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/subagent-context.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/mode-subagent.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(wajiha-kit:)?refactor-architect$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/subagent-gate.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
