{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "outputStyle": "wajiha-kit:Frontend report",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:check)",
      "Bash(npm run fmt)",
      "Bash(npm run fmt:check)",
      "Bash(npm run test)",
      "Bash(npm run test -- *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e -- *)",
      "Bash(npm run i18n:validate)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run check:full)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx oxlint *)",
      "Bash(npx oxfmt *)",
      "Bash(npx playwright test *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin {{DEFAULT_BRANCH}})",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git branch -a)",
      "Bash(git branch --list *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git remote get-url *)",
      "Bash(lsof -nP -iTCP:{{DEV_PORT}} *)",
      "Bash(git rebase origin/{{DEFAULT_BRANCH}})",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git stash list)",
      "Bash(git stash push *)",
      "Bash(git stash apply *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.envrc)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./.netrc)",
      "Read(./.git-credentials)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(./.env.test)",
      "Edit(./.env.staging)",
      "Edit(./.github/**)",
      "Edit(./deploy/**)",
      "Edit(./package-lock.json)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(gh pr create)",
      "Bash(gh pr create *)",
      "Bash(gh pr new *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(git merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push -u origin master)",
      "Bash(git push -u origin master *)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push origin HEAD:master *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:master)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify *)",
      "Bash(git push * --no-verify*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean -xf*)",
      "Bash(git clean -xdf*)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Skill(wajiha-kit:web-create-feature)",
      "Skill(wajiha-kit:web-create-route)",
      "Skill(wajiha-kit:web-seo-page)",
      "Skill(wajiha-kit:web-server-fn)",
      "Skill(wajiha-kit:dash-create-crud)",
      "Skill(wajiha-kit:dash-create-detail)",
      "Skill(wajiha-kit:dash-create-filter-bar)",
      "Skill(wajiha-kit:dash-create-route)",
      "Skill(wajiha-kit:dash-create-settings-form)",
      "Skill(wajiha-kit:dash-create-table)"
    ]
  },
  "sandbox": {
    "network": {
      "deniedDomains": [
        "{{LIVE_HOST}}"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "wajiha-kit": {
      "source": {
        "source": "github",
        "repo": "DiyarFirasmusa/wajiha-kit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "wajiha-kit@wajiha-kit": true
  }
}
