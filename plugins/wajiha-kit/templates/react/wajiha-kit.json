{
  "projectName": "{{PROJECT_NAME}}",
  "projectDescription": "{{PROJECT_DESCRIPTION}}",
  "profile": "react",
  "mode": "existing",
  "liveHosts": [
    "{{LIVE_HOST}}"
  ],
  "uatHost": "{{UAT_HOST}}",
  "githubRepo": "{{GITHUB_REPO}}",
  "defaultBranch": "{{DEFAULT_BRANCH}}",
  "protectedBranches": [
    "main",
    "master"
  ],
  "devPort": "{{DEV_PORT}}",
  "e2ePort": "{{E2E_PORT}}",
  "apiBaseEnv": "{{API_BASE_ENV}}",
  "protectedPaths": [
    ".env",
    ".env.*",
    ".github/**",
    "deploy/**",
    "server/**",
    "package-lock.json"
  ],
  "generatedPaths": [".next/**", "next-env.d.ts", ".react-router/**"],
  "srcDirs": [
    "{{SRC_DIR}}"
  ],
  "stack": {
    "packageManager": "{{PACKAGE_MANAGER}}",
    "framework": "{{FRAMEWORK}}",
    "router": "{{ROUTER}}",
    "data": "{{DATA_LIB}}",
    "state": "{{STATE_LIB}}",
    "styling": "{{STYLING}}",
    "tests": "{{TEST_RUNNER}}",
    "e2e": "{{E2E_RUNNER}}",
    "lint": "{{LINTER}}",
    "format": "{{FORMATTER}}",
    "i18n": "{{I18N_LIB}}"
  },
  "commands": {
    "typecheck": "{{TYPECHECK_CMD}}",
    "relatedTests": "{{RELATED_TESTS_CMD}}",
    "i18nValidate": "{{I18N_VALIDATE_CMD}}"
  }
}
