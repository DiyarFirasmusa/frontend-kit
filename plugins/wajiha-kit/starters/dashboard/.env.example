# Copy to .env and set real values. Variables are baked into the bundle at build time.
VITE_ENV="development"
VITE_API_BASE_URL="https://api.example.com"
# Leave empty when the auth service is on the same origin as the API.
VITE_AUTH_BASE_URL=""
# Empty = error monitoring off.
VITE_SENTRY_DSN=""
# "true" starts the in-browser mock API (demo data, no backend needed).
VITE_USE_MOCK="false"
# "true" turns the optional PWA module on (see src/modules/pwa/README.md).
VITE_PWA="false"
