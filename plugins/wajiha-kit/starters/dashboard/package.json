{
  "name": "my-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Admin dashboard starter: React 19, Vite, TanStack Router and Query, Tailwind 4, Arabic (RTL) and English.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "tokens": "node scripts/generate-tokens.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "icons": "node scripts/generate-icons.ts",
    "i18n:extract": "i18next-cli extract",
    "i18n:validate": "node scripts/validate-i18n.ts",
    "check": "npm run typecheck && npm run lint:check && npm run fmt:check && npm run test",
    "check:full": "npm run check && npm run test:e2e && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@sentry/react": "^10.74.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/router-core": "^1.171.30",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.14",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.38",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.56.9",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0",
    "yaml": "2.8.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
