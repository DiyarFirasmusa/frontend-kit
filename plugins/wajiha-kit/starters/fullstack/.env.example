# Copy to .env.local for local work (npm run setup:env does it). Never commit a real .env file.
# npm run dev, npm run build and npm start all read .env.local. On a real server or in Docker, set real
# environment variables instead (the Docker image does not contain this file).
# Every key below is validated by src/shared/env/schema.ts: at build time (vite.config.ts) and when the
# server starts (src/shared/server/check-env-plugin.ts). A bad value stops the build or the server.
# scripts/check-env-example.ts fails when this file and the schema list different keys.

# --- Public values (VITE_*): baked into the browser bundle at build time. Never put a secret here. ---

# Origin of the deployed site, no path and no trailing slash. Used for canonical, hreflang, sitemap and share tags.
VITE_SITE_URL=http://localhost:5190

# "true" only on the real production site. Anything else serves noindex pages and "Disallow: /" in robots.txt,
# so a staging copy can never be indexed by mistake.
VITE_ALLOW_INDEXING=false

# Admin (/ar/admin, /en/admin): where its API lives. A path on this site (/api) or an absolute URL, no trailing slash.
VITE_ADMIN_API_URL=/api

# "true" = the admin talks to a mock API inside the browser (MSW): any login works and the data is demo data that
# resets on reload. For local work, demos and the e2e tests only; "false" (the default) for a real backend.
VITE_ADMIN_API_MOCK=true

# --- Server only (never exposed to the browser) ---

# "enforce" sends Content-Security-Policy; "report-only" sends Content-Security-Policy-Report-Only (use it for a first rollout).
CSP_MODE=enforce

# Where the contact form posts each message as JSON ({ name, email, phone, message }); any 2xx answer counts
# as delivered. Empty = demo mode: messages are accepted and discarded, with a warning in the server log.
# Required on the real site: with VITE_ALLOW_INDEXING=true the server refuses to start without it.
CONTACT_WEBHOOK_URL=
