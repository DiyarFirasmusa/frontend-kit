{
  "name": "my-project",
  "version": "0.0.0",
  "private": true,
  "description": "Fullstack starter: a public website and an admin dashboard in one TanStack Start project (Arabic RTL and English).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "i18n:validate": "node scripts/validate-i18n.ts",
    "check:env": "node scripts/check-env-example.ts",
    "check:css": "node scripts/check-logical-css.ts",
    "check:tooling": "node scripts/check-tooling.ts",
    "check": "npm run typecheck && npm run lint:check && npm run fmt:check && npm run i18n:validate && npm run check:env && npm run check:css && npm run check:tooling && npm run test",
    "check:full": "npm run check && npm run build && npm run test:e2e",
    "audit": "npm audit --audit-level=high",
    "setup:env": "node scripts/setup-env.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/cairo": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "i18next": "^27.2.9",
    "nitro": "3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "msw": "^2.15.0",
    "oxfmt": "~0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.20.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
