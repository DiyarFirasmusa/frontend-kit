# Copy to .env.local for local work (npm run setup:env does it). Never commit a real .env file.
# Every key below is validated by src/shared/env/schema.ts: at build time (vite.config.ts) and at runtime.
# scripts/check-env-example.ts fails when this file and the schema list different keys.

# --- Public values (VITE_*): baked into the browser bundle at build time. Never put a secret here. ---

# Origin of the deployed site, no path and no trailing slash. Used for canonical, hreflang, sitemap and share tags.
VITE_SITE_URL=http://localhost:5190

# "true" only on the real production site. Anything else serves noindex pages and "Disallow: /" in robots.txt,
# so a staging copy can never be indexed by mistake.
VITE_ALLOW_INDEXING=false

# --- Server only (never exposed to the browser) ---

# "enforce" sends Content-Security-Policy; "report-only" sends Content-Security-Policy-Report-Only (use it for a first rollout).
CSP_MODE=enforce

# Optional. Where the contact form posts the message as JSON. Leave empty to accept and discard messages (demo mode).
CONTACT_WEBHOOK_URL=
