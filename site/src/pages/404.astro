---
import Header from '../components/Header.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Layout from '../layouts/Layout.astro'
import type { Route } from '../lib/routes.ts'

const route: Route = { kind: 'home' }
---

<Layout locale="en" route={route} title="Page not found | Wajiha Kit" description="This page does not exist." indexable={false}>
  <div data-chrome="en"><Header locale="en" route={{ kind: 'page', id: 'guide' }} /></div>
  <div data-chrome="ar" hidden><Header locale="ar" route={{ kind: 'page', id: 'guide' }} /></div>
  <main id="content" class="missing" tabindex="-1">
    <!-- An empty board: the same layout as every part of the site, with nothing in it. -->
    <div class="board tone-ink side-ink missing-board">
      <p class="board-top">
        <svg viewBox="0 0 64 64" width="28" height="28" aria-hidden="true">
          <rect x="5" y="5" width="54" height="12" rx="4" fill="rgb(241 237 231 / 0.28)"></rect>
          <rect x="5" y="21" width="36" height="20" rx="4" fill="rgb(241 237 231 / 0.28)"></rect>
          <rect x="45" y="21" width="14" height="38" rx="4" fill="rgb(241 237 231 / 0.28)"></rect>
          <rect x="5" y="45" width="36" height="14" rx="4" fill="rgb(241 237 231 / 0.28)"></rect>
        </svg>
        <span class="board-count" dir="ltr">404</span>
        <span data-missing-label>Not found</span>
      </p>
      <div class="board-main">
        <h1 data-missing-title>This page does not exist.</h1>
        <p class="missing-help" data-missing-help>Check the address, or search the guide with Ctrl K.</p>
        <p class="missing-other" lang="ar" dir="rtl" data-missing-other>هذه الصفحة غير موجودة.</p>
      </div>
      <div class="board-side">
        <p class="board-side-title" data-missing-near>Pages near here</p>
        <ul class="board-list" data-missing-links>
          <li><a href="/">Start</a></li>
          <li><a href="/get-started/">Get started</a></li>
          <li><a href="/questions/">Questions</a></li>
          <li><a href="/docs/">Guide</a></li>
        </ul>
      </div>
      <div class="board-note">
        <p data-missing-note>Nothing is saved or lost: only this address is empty.</p>
        <a class="hero-start" href="/" data-missing-home>Back to the start</a>
      </div>
    </div>
  </main>
  <div data-chrome="en"><SiteFooter locale="en" /></div>
  <div data-chrome="ar" hidden><SiteFooter locale="ar" /></div>
  <script is:inline>
      // One static 404 serves both languages: under /ar/ the Arabic sentence leads and the page turns right to left.
      if (location.pathname.indexOf('/ar/') === 0) {
        document.documentElement.lang = 'ar'
        document.documentElement.dir = 'rtl'
        document.querySelectorAll('[data-chrome="en"]').forEach(function (e) { e.hidden = true })
        document.querySelectorAll('[data-chrome="ar"]').forEach(function (e) { e.hidden = false })
        document.title = 'الصفحة غير موجودة | واجهة'
        var q = function (s) { return document.querySelector(s) }
        var title = q('[data-missing-title]')
        var other = q('[data-missing-other]')
        var english = title.textContent
        title.textContent = other.textContent
        other.textContent = english
        other.lang = 'en'
        other.dir = 'ltr'
        q('[data-missing-label]').textContent = 'غير موجودة'
        q('[data-missing-help]').textContent = 'تحقق من العنوان، أو ابحث في الدليل بـ Ctrl K.'
        q('[data-missing-near]').textContent = 'صفحات قريبة'
        q('[data-missing-note]').textContent = 'لم يُحفظ شيء ولم يضع شيء: العنوان وحده فارغ.'
        var home = q('[data-missing-home]')
        home.textContent = 'العودة إلى البداية'
        home.setAttribute('href', '/ar/')
        var names = ['البداية', 'ابدأ', 'الأسئلة', 'الدليل']
        var paths = ['/ar/', '/ar/get-started/', '/ar/questions/', '/ar/docs/']
        document.querySelectorAll('[data-missing-links] a').forEach(function (a, i) {
          a.textContent = names[i]
          a.setAttribute('href', paths[i])
        })
      }
  </script>
</Layout>
