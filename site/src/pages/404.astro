---
import PageIndex from '../components/guide/PageIndex.astro'
import Header from '../components/Header.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Layout from '../layouts/Layout.astro'
import type { Route } from '../lib/routes.ts'

const route: Route = { kind: 'home' }
---

<Layout locale="en" route={route} title="Page not found | Wajiha Kit" description="This page does not exist." indexable={false}>
  <Header locale="en" route={{ kind: 'page', id: 'guide' }} />
  <main id="content" class="missing" tabindex="-1">
    <h1>This page does not exist.</h1>
    <p lang="ar" dir="rtl">هذه الصفحة غير موجودة.</p>
    <PageIndex locale="en" />
    <script is:inline>
      // One static 404 serves both languages: under /ar/ the Arabic sentence leads and the page turns right to left.
      if (location.pathname.indexOf('/ar/') === 0) {
        document.documentElement.lang = 'ar'
        document.documentElement.dir = 'rtl'
        document.title = 'الصفحة غير موجودة | واجهة'
        var h = document.querySelector('.missing h1')
        var p = document.querySelector('.missing > p')
        var english = h.textContent
        h.textContent = p.textContent
        p.textContent = english
        p.lang = 'en'
        p.dir = 'ltr'
        var home = document.createElement('p')
        home.innerHTML = '<a href="/ar/">الرئيسية</a>'
        p.after(home)
      }
    </script>
  </main>
  <SiteFooter locale="en" />
</Layout>
