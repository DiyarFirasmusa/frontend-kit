---
import '@fontsource-variable/familjen-grotesk/index.css'
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css'
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css'
import '@fontsource/ibm-plex-mono/latin-500.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/header.css'
import '../styles/scenes.css'
import '../styles/film.css'
import '../styles/details.css'
import '../styles/guide.css'
import '../styles/doc.css'
import { content } from '../content/index.ts'
import type { Locale } from '../content/types.ts'
import { asset, routeUrl } from '../lib/links.ts'
import { REPO_URL, version } from '../lib/plugin.ts'
import type { Route } from '../lib/routes.ts'

interface Props {
  locale: Locale
  route: Route
  title: string
  description: string
  indexable?: boolean
}

const { locale, route, title, description, indexable = true } = Astro.props
const home = route.kind === 'home' && indexable
const copy = content[locale]
const absolute = (path: string) => new URL(path, Astro.site).href
const product = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'frontend-kit',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  softwareVersion: version,
  description: copy.meta.description,
  inLanguage: locale,
  url: absolute(routeUrl(locale, route)),
  sameAs: REPO_URL,
})
---

<!doctype html>
<html lang={locale} dir={copy.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#050607" />
    <link rel="canonical" href={absolute(routeUrl(locale, route))} />
    <link rel="alternate" hreflang="en" href={absolute(routeUrl('en', route))} />
    <link rel="alternate" hreflang="ar" href={absolute(routeUrl('ar', route))} />
    <link rel="alternate" hreflang="x-default" href={absolute(routeUrl('en', route))} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="sitemap" href={asset('sitemap.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="frontend-kit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(routeUrl(locale, route))} />
    <meta property="og:image" content={absolute(asset('og.jpg'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_IQ' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {home && <script type="application/ld+json" set:html={product} />}
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    {
      home && (
        <script is:inline>
      // The page is complete without the film. It is only laid out as a film when this device can play it.
      ;(() => {
        const root = document.documentElement
        let choice = null
        try {
          choice = localStorage.getItem('kit-motion')
        } catch {
          // Storage is blocked: follow the system setting.
        }
        if (!('WebGL2RenderingContext' in window)) return root.classList.add('no-film')
        const weak = Boolean(navigator.connection?.saveData) || (navigator.deviceMemory && navigator.deviceMemory <= 2)
        const wanted = choice ? choice === 'on' : !matchMedia('(prefers-reduced-motion: reduce)').matches && !weak
        if (!wanted) return
        root.classList.add('film', 'film-loading')
        // Only time the visitor can see counts: a tab opened in the background is throttled, not stuck.
        let seconds = 0
        const watch = setInterval(() => {
          if (!root.classList.contains('film-loading')) return clearInterval(watch)
          if (document.hidden || ++seconds < 9) return
          clearInterval(watch)
          root.classList.remove('film', 'film-loading')
        }, 1000)
      })()
        </script>
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import '../client/site.ts'
    </script>
  </body>
</html>
