---
import '@fontsource-variable/familjen-grotesk/index.css'
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css'
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css'
import '@fontsource/ibm-plex-mono/latin-500.css'
import grotesk from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url'
import arabic400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url'
import arabic500 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-500-normal.woff2?url'
import mono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/header.css'
import '../styles/details.css'
import '../styles/guide.css'
import '../styles/doc.css'
import '../styles/stage.css'
import '../styles/home.css'
import '../styles/colour.css'
import '../styles/rounded.css'
import '../styles/motion.css'
import '../styles/identity.css'
import '../styles/chat.css'
import '../styles/sections.css'
import '../styles/loops.css'
import '../styles/docs-space.css'
import '../styles/theme-light.css'
import { ClientRouter } from 'astro:transitions'
import { content } from '../content/index.ts'
import type { Locale } from '../content/types.ts'
import { asset, routeUrl } from '../lib/links.ts'
import { REPO_URL, version } from '../lib/plugin.ts'
import type { Route } from '../lib/routes.ts'

interface Props {
  locale: Locale
  route: Route
  title: string
  description: string
  indexable?: boolean
  /** The trail shown on a guide page, for search engines: the guide, the section, this page. */
  crumbs?: { name: string; href: string }[]
}

const { locale, route, title, description, indexable = true, crumbs = [] } = Astro.props
const home = route.kind === 'home' && indexable
const copy = content[locale]
const absolute = (path: string) => new URL(path, Astro.site).href
// The picture that shows when the link is shared, in each language: the logo for the home page, and for each page of the
// guide its own title and colour (scripts/make-og.mjs). A skill, specialist, rule or check uses its section's picture.
const SECTION = { skill: 'skills', agent: 'agents', rule: 'rules', hook: 'checks' } as const
const lang = locale === 'ar' ? '-ar' : ''
const share = route.kind === 'home' ? `og${lang}.jpg` : `og/${route.kind === 'page' ? route.id : SECTION[route.kind]}${lang}.jpg`
// What a search engine learns about the site: the program (free, made by Diyar Firas, from GitHub) and the site's own name in both scripts.
const product = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Wajiha Kit',
      alternateName: 'واجهة',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      softwareVersion: version,
      description: copy.meta.description,
      inLanguage: locale,
      url: absolute(routeUrl(locale, route)),
      sameAs: REPO_URL,
      downloadUrl: REPO_URL,
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Diyar Firas', url: 'https://github.com/DiyarFirasmusa' },
    },
    {
      '@type': 'WebSite',
      name: 'Wajiha Kit',
      alternateName: ['واجهة', 'Wajiha'],
      url: absolute('/'),
      inLanguage: ['en', 'ar'],
    },
  ],
})
const trail =
  crumbs.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map(({ name, href }, i) => ({ '@type': 'ListItem', position: i + 1, name, item: absolute(href) })),
      })
    : ''
---

<!doctype html>
<html lang={locale} dir={copy.dir} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#050607" />
    <script is:inline>
      // The chosen mode is put on the page before it is painted, so there is no flash; dark is the default.
      ;(function () {
        try {
          if (localStorage.getItem('wajiha-theme') === 'light') document.documentElement.dataset.theme = 'light'
        } catch (e) {}
        document.addEventListener('astro:before-swap', function (event) {
          var now = document.documentElement.dataset.theme
          if (now) event.newDocument.documentElement.dataset.theme = now
          else delete event.newDocument.documentElement.dataset.theme
        })
      })()
    </script>
    {
      indexable && (
        <>
          <link rel="canonical" href={absolute(routeUrl(locale, route))} />
          <link rel="alternate" hreflang="en" href={absolute(routeUrl('en', route))} />
          <link rel="alternate" hreflang="ar" href={absolute(routeUrl('ar', route))} />
          <link rel="alternate" hreflang="x-default" href={absolute(routeUrl('en', route))} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="sitemap" href={asset('sitemap.xml')} />
    <meta property="og:type" content={route.kind === 'home' ? 'website' : 'article'} />
    <meta property="og:site_name" content="Wajiha Kit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(routeUrl(locale, route))} />
    <meta property="og:image" content={absolute(asset(share))} />
    <meta property="og:image:alt" content={route.kind === 'home' ? copy.meta.title : title} />
    <meta name="twitter:image" content={absolute(asset(share))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_IQ' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ar' ? 'en_US' : 'ar_IQ'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image:type" content="image/jpeg" />
    <link rel="preload" as="font" type="font/woff2" href={grotesk} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={mono} crossorigin />
    {locale === 'ar' && <link rel="preload" as="font" type="font/woff2" href={arabic400} crossorigin />}
    {locale === 'ar' && <link rel="preload" as="font" type="font/woff2" href={arabic500} crossorigin />}
    <ClientRouter fallback="swap" />
    {home && <script type="application/ld+json" set:html={product} />}
    {trail && <script type="application/ld+json" set:html={trail} />}
    <script is:inline>
      document.documentElement.classList.add('js')
      // A page swapped in without a reload brings its own <html>: mark it again, or the tabs show every panel.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'))
    </script>
  {import.meta.env.PROD && <script is:inline defer src="/_vercel/speed-insights/script.js" />}
  </head>
  <body>
    <slot />
    <script>
      import '../client/app.ts'
    </script>
  </body>
</html>
