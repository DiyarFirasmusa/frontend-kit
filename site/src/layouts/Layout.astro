---
import '@fontsource-variable/familjen-grotesk/index.css'
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css'
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css'
import '@fontsource/ibm-plex-mono/latin-500.css'
import grotesk from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url'
import arabic400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url'
import arabic500 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-500-normal.woff2?url'
import mono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/header.css'
import '../styles/details.css'
import '../styles/guide.css'
import '../styles/doc.css'
import '../styles/stage.css'
import '../styles/home.css'
import '../styles/colour.css'
import '../styles/rounded.css'
import '../styles/motion.css'
import { ClientRouter } from 'astro:transitions'
import { content } from '../content/index.ts'
import type { Locale } from '../content/types.ts'
import { asset, routeUrl } from '../lib/links.ts'
import { REPO_URL, version } from '../lib/plugin.ts'
import type { Route } from '../lib/routes.ts'

interface Props {
  locale: Locale
  route: Route
  title: string
  description: string
  indexable?: boolean
}

const { locale, route, title, description, indexable = true } = Astro.props
const home = route.kind === 'home' && indexable
const copy = content[locale]
const absolute = (path: string) => new URL(path, Astro.site).href
// The picture that shows when the link is shared: one look for the home page, one for the documentation, in each language.
const share = `og${route.kind === 'home' ? '' : '-docs'}${locale === 'ar' ? '-ar' : ''}.jpg`
const product = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Wajiha Kit',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  softwareVersion: version,
  description: copy.meta.description,
  inLanguage: locale,
  url: absolute(routeUrl(locale, route)),
  sameAs: REPO_URL,
})
---

<!doctype html>
<html lang={locale} dir={copy.dir} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#050607" />
    <link rel="canonical" href={absolute(routeUrl(locale, route))} />
    <link rel="alternate" hreflang="en" href={absolute(routeUrl('en', route))} />
    <link rel="alternate" hreflang="ar" href={absolute(routeUrl('ar', route))} />
    <link rel="alternate" hreflang="x-default" href={absolute(routeUrl('en', route))} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="sitemap" href={asset('sitemap.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wajiha Kit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(routeUrl(locale, route))} />
    <meta property="og:image" content={absolute(asset(share))} />
    <meta property="og:image:alt" content={copy.meta.title} />
    <meta name="twitter:image" content={absolute(asset(share))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_IQ' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={grotesk} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={mono} crossorigin />
    {locale === 'ar' && <link rel="preload" as="font" type="font/woff2" href={arabic400} crossorigin />}
    {locale === 'ar' && <link rel="preload" as="font" type="font/woff2" href={arabic500} crossorigin />}
    <ClientRouter fallback="swap" />
    {home && <script type="application/ld+json" set:html={product} />}
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../client/app.ts'
    </script>
  </body>
</html>
