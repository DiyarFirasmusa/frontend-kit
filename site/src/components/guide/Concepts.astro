---
import { concepts } from '../../content/guide/concepts.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { facts } from '../../lib/plugin.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<ul class="concepts">
  {
    concepts.map(({ name, count, like, text, example, page }) => (
      <li>
        <a href={pageUrl(locale, page)}>
          <span class="concept-top">
            <strong>{name[locale]}</strong>
            <span>{count ? facts[count] : 4}</span>
          </span>
          <em>{like[locale]}</em>
          <span>{text[locale]}</span>
          <span class="concept-example">{example[locale]}</span>
        </a>
      </li>
    ))
  }
</ul>
