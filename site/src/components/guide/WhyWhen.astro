---
import type { Purpose } from '../../content/guide/purpose.ts'
import { ui } from '../../content/guide/ui.ts'
import type { Locale } from '../../content/types.ts'
import Block from './Block.astro'

interface Props {
  purpose: Purpose
  locale: Locale
  /** Arabic speaks of a skill as she and of an agent as he. */
  masculine?: boolean
}

const { purpose, locale, masculine = false } = Astro.props
---

<Block id="why" title={(masculine ? ui.whyHe : ui.why)[locale]}><p class="big">{purpose.why[locale]}</p></Block>
<Block id="when" title={(masculine ? ui.whenHe : ui.when)[locale]}><p class="big">{purpose.when[locale]}</p></Block>
