---
import { t } from '../../content/guide/text.ts'
import type { Locale } from '../../content/types.ts'
import Block from './Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const words = {
  difference: t('How is an agent different from a skill?', 'شنو الفرق بين الوكيل والمهارة؟'),
  skill: t('A skill is knowledge. The same assistant reads the steps and does the job itself.', 'المهارة معرفة: نفس المساعد يقرا الخطوات ويسوي الشغل بنفسه.'),
  agent: t('An agent is a worker. A separate assistant does the job without seeing the conversation, which is why its review is honest.', 'الوكيل شغّيل: مساعد منفصل يسوي الشغل بدون ما يشوف المحادثة، ولهذا مراجعته نزيهة.'),
  start: t('How an agent starts', 'شلون يبدأ الوكيل'),
  ways: [
    t('By itself: frontend-reviewer runs after the quality gate passes.', 'لحاله: frontend-reviewer يشتغل بعد ما تنجح بوابة الجودة.'),
    t('Through a skill: review starts a reviewer for you.', 'عن طريق مهارة: review تشغّل المراجع بدالك.'),
    t('By asking: name the agent in your sentence.', 'تطلبه انت: اذكر اسم الوكيل بجملتك.'),
  ],
}
---

<Block id="difference" title={words.difference[locale]}>
  <div class="pair"><p>{words.skill[locale]}</p><p>{words.agent[locale]}</p></div>
</Block>
<Block id="start" title={words.start[locale]}>
  <ul class="ticks">{words.ways.map((way) => <li>{way[locale]}</li>)}</ul>
</Block>
