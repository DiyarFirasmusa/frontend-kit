---
interface Props {
  title: string
  id?: string | undefined
  lead?: string | undefined
}

const { title, id, lead } = Astro.props
---

<section {id} class="block">
  <h2>
    {title}
    {id && <a class="heading-link" href={`#${id}`} aria-hidden="true" tabindex="-1">#</a>}
  </h2>
  {lead && <p class="block-lead">{lead}</p>}
  <slot />
</section>
