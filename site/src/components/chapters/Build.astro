---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
}

import Slot from '../Slot.astro'

const { build } = Astro.props.copy
---

<section id="build" class="chapter split build" data-chapter data-world="mint">
  <div class="copy">
    <h2 class="title">{build.title}</h2>
    <ol class="steps">
      {build.steps.map(({ title, text }, i) => (
        <li>
          <span class="step-number" aria-hidden="true">{i + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
  <Slot stage="exploded" />
</section>
