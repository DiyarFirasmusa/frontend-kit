---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
}

import Slot from '../Slot.astro'

const { refactor } = Astro.props.copy
---

<section id="refactor" class="chapter split refactor" data-chapter data-world="sky">
  <div class="copy">
    <h2 class="title">{refactor.title}</h2>
    <p class="lead">{refactor.lead}</p>
    <ol class="phases">
      {refactor.steps.map(([command, text]) => <li><code dir="ltr">{command}</code><p>{text}</p></li>)}
    </ol>
    <p class="after">{refactor.note}</p>
  </div>
  <Slot stage="rebuild" />
</section>
