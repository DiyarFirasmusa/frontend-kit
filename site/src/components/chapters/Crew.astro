---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
  locale: Locale
}

import { agents } from '../../content/catalogue.ts'
import type { Locale } from '../../content/types.ts'
import { facts } from '../../lib/plugin.ts'
import Slot from '../Slot.astro'

const { copy, locale } = Astro.props
const { crew } = copy
---

<section id="crew" class="chapter split flip crew" data-chapter data-world="yellow">
  <div class="copy">
    <h2 class="title">{crew.title}</h2>
    <p class="lead">{crew.lead(facts)}</p>
    <ul class="roster">
      {Object.entries(agents).map(([name, job]) => (
        <li>
          <button type="button" aria-pressed="false" data-agent>
            <bdi class="agent-name">{name}</bdi>
            <span>{job[locale]}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
  <Slot stage="crew" />
</section>
