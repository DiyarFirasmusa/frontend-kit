---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
}

import Slot from '../Slot.astro'

const { hero } = Astro.props.copy
---

<section id="top" class="chapter hero" data-chapter data-world="lilac">
  <h1 class="wordmark" dir="ltr" aria-label="frontend-kit">
    <span class="wordmark-first" aria-hidden="true">frontend</span><span class="wordmark-last" aria-hidden="true">-kit</span>
  </h1>
  <Slot stage="bot" />
  <div class="hero-copy">
    <p class="hero-line">{hero.line}</p>
    <p class="hero-lead">{hero.lead}</p>
    <div class="actions">
      <a class="press press-ink" href="#install"><span>{hero.install}</span></a>
      <button class="press press-jump" type="button" data-jump><span>{hero.jump}</span></button>
    </div>
  </div>
</section>
