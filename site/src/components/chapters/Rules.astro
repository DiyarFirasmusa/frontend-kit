---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
}

import { facts, ruleGroups } from '../../lib/plugin.ts'

const { rules } = Astro.props.copy
---

<section id="rules" class="chapter rules" data-chapter data-world="sheet">
  <div class="heading">
    <h2 class="title">{rules.title}</h2>
    <p class="lead">{rules.lead(facts)}</p>
  </div>
  <div class="rule-map">
    {ruleGroups.map(({ group, names }) => (
      <div class="rule-group">
        <h3>{rules.groups[group]}</h3>
        <ul dir="ltr">{names.map((name) => <li><code>{name}</code></li>)}</ul>
      </div>
    ))}
  </div>
</section>
