---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
  locale: Locale
}

import { runners } from '../../content/catalogue.ts'
import type { Locale } from '../../content/types.ts'
import { facts, manualSkills } from '../../lib/plugin.ts'

const { copy, locale } = Astro.props
const { parts } = copy
---

<section id="parts" class="chapter parts" data-chapter data-world="sheet">
  <div class="heading">
    <h2 class="title">{parts.title}</h2>
    <p class="lead">{parts.lead(facts)}</p>
  </div>
  <div class="parts-body">
    <div class="sheets">
      {runners.map(({ code, tone, title, skills }) => (
        <div class="sheet" data-tone={tone}>
          <h3><span class="sheet-code" aria-hidden="true">{code}</span>{title[locale]}</h3>
          <ul dir="ltr">
            {Object.entries(skills).map(([name, what], i) => (
              <li>
                <button
                  type="button"
                  aria-pressed="false"
                  data-part
                  data-code={`${code}${i + 1}`}
                  data-name={name}
                  data-tone={tone}
                  data-what={what[locale]}
                  data-how={manualSkills.has(name) ? parts.manual : parts.auto}
                >
                  <span class="part-code" aria-hidden="true">{code}{i + 1}</span>
                  {name}
                  <span class="part-description" dir={copy.dir}>{what[locale]}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <aside class="detail" aria-live="polite" data-detail>
      <p class="detail-code" dir="ltr" data-code></p>
      <p class="detail-name" dir="auto" data-name>{parts.empty}</p>
      <p data-what>{parts.emptyText}</p>
      <p class="detail-how" data-how></p>
      <code class="detail-command" dir="ltr" data-command></code>
    </aside>
  </div>
</section>
