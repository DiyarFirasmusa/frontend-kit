---
import { chapters, tourWords } from '../../content/guide/tour.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<nav class="guide-bar" aria-label={tourWords.chapter[locale]} data-guide-bar>
  <ol class="guide-track">
    {chapters.map(({ id, name }) => (
      <li>
        <a href={`#${id}`} title={name[locale]} data-chapter-link>
          <span class="sr-only">{name[locale]}</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="guide-now">
    <strong data-chapter-name>{chapters[0]?.name[locale]}</strong>
    <span dir="ltr" data-chapter-count></span>
  </p>
  <a class="guide-next" href={`#${chapters[1]?.id}`} data-chapter-next>
    <span>{tourWords.next[locale]}</span>
    <span data-chapter-next-name>{chapters[1]?.name[locale]}</span>
  </a>
</nav>
