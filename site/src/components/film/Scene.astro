---
import { below, chapters } from '../../content/guide/tour.ts'
import type { Scene } from '../../content/scenes.ts'
import type { Copy, Details, HookEvent, Locale } from '../../content/types.ts'
import { facts, hookEvents } from '../../lib/plugin.ts'
import { PAGES } from '../../content/guide/pages.ts'
import { asset, pageUrl } from '../../lib/links.ts'
import Commands from '../Commands.astro'
import Explanation from '../tour/Explanation.astro'

interface Props {
  scene: Scene
  copy: Copy & Details
  locale: Locale
  first: boolean
  last: boolean
}

const { scene, copy, locale, first, last } = Astro.props
const { title, text, points, steps } = copy.scenes[scene.id]
const words = (typeof title === 'string' ? title : title(facts)).split(' ')
const Heading = first ? 'h1' : 'h2'
const more = below[scene.id]
// Long enough that the stage has wholly turned aside when the first moment is read.
const LEAD_IN = 0.92
const chapter = chapters.findIndex(({ id }) => id === scene.id)
// A little more before the first moment, or a screen more at the end of the page.
const holdScreens = scene.hold + (more ? LEAD_IN : last ? 1 : 0)
const moments = (Object.keys(copy.session.events) as HookEvent[]).filter((event) => hookEvents.includes(event))
const counts = [
  [facts.skills, copy.facts.skills],
  [facts.agents, copy.facts.agents],
  [facts.rules, copy.facts.rules],
  [facts.events, copy.facts.events],
] as const
---

<section
  id={scene.id}
  class:list={['scene', `scene-${scene.layout}`, `scene-${scene.id}`]}
  data-scene
  data-chapter={chapter >= 0 ? chapter : undefined}
  data-shape={scene.shape}
  data-layout={scene.layout}
  data-hold={scene.hold}
  data-travel={scene.travel}
>
  <div class="scene-pin">
    <div class="scene-copy" data-copy-block>
      <Heading class="scene-title">
        {words.map((word, i) => <>{i > 0 && ' '}<span class="mask"><span data-word>{word}</span></span></>)}
      </Heading>
      {text && <p class="scene-text" data-part>{text}</p>}
      {points && <ul class="points">{points.map((point) => <li data-part>{point}</li>)}</ul>}
      {
        steps && (
          <ol class="steps">
            {steps.map(([name, about]) => (
              <li data-part data-active>
                <strong>{name}</strong>
                <p>{about}</p>
              </li>
            ))}
          </ol>
        )
      }
      {
        scene.id === 'checks' && (
          <ol class="sequence" data-part>
            {moments.map((event) => <li data-active>{copy.session.events[event][2]}</li>)}
          </ol>
        )
      }
      {
        first && (
          <dl class="counts" data-part>
            {counts.map(([amount, name]) => (
              <div>
                <dt>{amount}</dt>
                <dd>{name}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {first && <div data-part><Commands install={copy.install} first /></div>}
      {(first || last) && (
        <a class="to-docs" href={pageUrl(locale, 'docs')} data-part>
          {PAGES.docs.title[locale]}
        </a>
      )}
      {last && <div data-part><Commands install={copy.install} /><p class="needs">{copy.install.needs}</p></div>}
      {
        more && (
          <p class="keep-going" data-part>
            <i aria-hidden="true" />
            {more[locale]}
          </p>
        )
      }
    </div>
    <img
      class="scene-still"
      src={asset(`stills/${scene.shape}.jpg`)}
      width="1000"
      height="620"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="scene-hold" style={`--screens: ${holdScreens}`} aria-hidden="true"></div>
  {
    more && (
      <div class="tour" id={first ? 'what' : undefined} data-tour>
        {first && <h2 class="sr-only">{chapters[0]?.name[locale]}</h2>}
        <Explanation scene={scene.id} locale={locale} />
      </div>
    )
  }
  <div class="scene-travel" style={`--screens: ${scene.travel}`} aria-hidden="true"></div>
</section>
