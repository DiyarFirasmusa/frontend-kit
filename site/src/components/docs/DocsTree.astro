---
import { agents, skillGroups } from '../../content/catalogue.ts'
import { KEYWORDS } from '../../content/guide/keywords.ts'
import { PAGES, SECTIONS } from '../../content/guide/pages.ts'
import { hookPurpose } from '../../content/guide/purpose.ts'
import { ruleGuides } from '../../content/guide/rules.ts'
import { t } from '../../content/guide/text.ts'
import { ui } from '../../content/guide/ui.ts'
import { content } from '../../content/index.ts'
import type { Bilingual } from '../../content/catalogue.ts'
import type { HookEvent, Locale } from '../../content/types.ts'
import { agentUrl, hookUrl, pageUrl, routeUrl, ruleUrl, skillUrl } from '../../lib/links.ts'
import { hookEvents, ruleGroups } from '../../lib/plugin.ts'
import type { Route } from '../../lib/routes.ts'

interface Props {
  locale: Locale
  route: Exclude<Route, { kind: 'home' }>
}

interface Leaf {
  name: string
  href: string
  about: Bilingual
  under?: string | undefined
  /** Words people type that are not in the name. */
  extra?: string | undefined
}

const { locale, route } = Astro.props
// The checks, in the order the plugin's own list gives them.
const hookOrder = (Object.keys(content.en.session.events) as HookEvent[]).filter((event) => hookEvents.includes(event))
const copy = content[locale]
const here = routeUrl(locale, route)
const words = {
  guides: t('Start here', 'ابدأ من هنا'),
  hooks: t('Safety checks', 'فحوص الأمان'),
  search: t('Search: table, Arabic, upload…', 'ابحث: جدول، عربي، رفع…'),
  found: t('pages found', 'صفحات وُجدت'),
  none: t('Nothing matches.', 'لا توجد نتائج.'),
}
const groups: { name: string; kind: Route['kind']; leaves: Leaf[] }[] = [
  {
    name: words.guides[locale],
    kind: 'page',
    leaves: SECTIONS.slice(0, 2).flatMap(({ pages }) => pages).map((id) => ({ name: PAGES[id].name[locale], href: pageUrl(locale, id), about: PAGES[id].lead, extra: KEYWORDS[id] })),
  },
  {
    name: t('Advanced pages', 'صفحات متقدمة')[locale],
    kind: 'page',
    leaves: SECTIONS.slice(2).flatMap(({ pages }) => pages).map((id) => ({ name: PAGES[id].name[locale], href: pageUrl(locale, id), about: PAGES[id].lead, extra: KEYWORDS[id] })),
  },
  {
    name: PAGES.skills.name[locale],
    kind: 'skill',
    leaves: skillGroups.flatMap(({ title, skills }) =>
      Object.entries(skills).map(([name, about], i) => ({ name, href: skillUrl(locale, name), about, under: i === 0 ? title[locale] : undefined })),
    ),
  },
  {
    name: PAGES.agents.name[locale],
    kind: 'agent',
    leaves: Object.entries(agents).map(([name, about]) => ({ name, href: agentUrl(locale, name), about })),
  },
  {
    name: PAGES.rules.name[locale],
    kind: 'rule',
    leaves: ruleGroups.flatMap(({ group, names }) =>
      names.map((name, i) => ({
        name,
        href: ruleUrl(locale, group, name),
        about: ruleGuides[`${group}/${name}`]!,
        under: i === 0 ? copy.rules.groups[group] : undefined,
      })),
    ),
  },
  {
    name: words.hooks[locale],
    kind: 'hook',
    leaves: hookOrder.map((event) => ({ name: event, href: hookUrl(locale, event), about: hookPurpose[event] })),
  },
]
---

<details class="tree" data-tree data-found={words.found[locale]}>
  <summary>{ui.allPages[locale]}</summary>
  <label class="tree-search">
    <span class="sr-only">{words.search[locale]}</span>
    <input type="search" placeholder={words.search[locale]} autocomplete="off" data-tree-input />
  </label>
  <p class="tree-none" role="status" data-tree-empty hidden>{words.none[locale]}</p>
  <nav aria-label={PAGES.docs.name[locale]} data-tree-list>
    {
      groups.map(({ name, kind, leaves }) => (
        <details open={kind === route.kind ? kind !== 'page' || leaves.some((leaf) => leaf.href === here) : leaves.some((leaf) => leaf.href === here)} data-tree-group data-kind={kind}>
          <summary>
            {name} <span>{leaves.length}</span>
          </summary>
          <ul>
            {leaves.map((leaf) => (
              <li data-tree-item data-search={[leaf.name, leaf.about.en, leaf.about.ar, leaf.extra ?? ''].join(' ').toLowerCase()}>
                {leaf.under && <small>{leaf.under}</small>}
                <a href={leaf.href} class:list={{ 'is-name': kind !== 'page' }} aria-current={leaf.href === here ? 'page' : undefined}>
                  <bdi>{leaf.name}</bdi>
                </a>
                <span class="leaf-about">{leaf.about[locale]}</span>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </nav>
</details>
<!-- Open beside the page on a wide screen, folded above it on a narrow one: decided before the page is drawn, so nothing jumps. -->
<script is:inline>
  document.currentScript.previousElementSibling.open = matchMedia('(min-width: 901px)').matches
</script>
