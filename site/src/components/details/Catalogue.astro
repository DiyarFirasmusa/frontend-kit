---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
  locale: Locale
}

import { agents, skillGroups } from '../../content/catalogue.ts'
import type { Locale } from '../../content/types.ts'
import { facts, manualSkills, ruleGroups } from '../../lib/plugin.ts'
import Chapter from './Chapter.astro'

const { copy, locale } = Astro.props
const { parts, crew, rules } = copy
---

<Chapter id="all-skills" title={parts.title} lead={parts.lead(facts)}>
  {skillGroups.map(({ title, skills }) => (
    <div class="group">
      <h3>{title[locale]}</h3>
      <dl class="described named">
        {Object.entries(skills).map(([name, what]) => (
          <div>
            <dt><bdi>{name}</bdi></dt>
            <dd>{what[locale]}{manualSkills.has(name) && <em>{parts.manual}</em>}</dd>
          </div>
        ))}
      </dl>
    </div>
  ))}
</Chapter>

<Chapter id="all-agents" title={crew.title} lead={crew.lead(facts)}>
  <dl class="described named">
    {Object.entries(agents).map(([name, job]) => <div><dt><bdi>{name}</bdi></dt><dd>{job[locale]}</dd></div>)}
  </dl>
</Chapter>

<Chapter id="all-rules" title={rules.title} lead={rules.lead(facts)}>
  <div class="two">
    {ruleGroups.map(({ group, names }) => (
      <div>
        <h3>{rules.groups[group]}</h3>
        <ul class="files" dir="ltr">{names.map((name) => <li><code>{name}</code></li>)}</ul>
      </div>
    ))}
  </div>
</Chapter>
