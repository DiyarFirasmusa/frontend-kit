---
import { t } from '../../content/guide/text.ts'
import type { Copy, Details, Locale } from '../../content/types.ts'
import { facts } from '../../lib/plugin.ts'
import Commands from '../Commands.astro'
import Concepts from '../guide/Concepts.astro'
import Journey from '../guide/Journey.astro'
import PageIndex from '../guide/PageIndex.astro'
import SiteFooter from '../SiteFooter.astro'
import Chapter from './Chapter.astro'

interface Props {
  copy: Copy & Details
  locale: Locale
}

const { copy, locale } = Astro.props
const { box, install } = copy
const words = {
  plain: t('In plain words.', 'بكلمات بسيطة.'),
  plainLead: t('frontend-kit is an add-on for Claude Code. These six words explain all of it. Open one to go deeper.', 'frontend-kit إضافة لـ Claude Code، وهذه الكلمات الست تشرحها كلها. افتح أياً منها للتفاصيل.'),
  journey: t('One sentence, start to finish.', 'جملة واحدة من البداية إلى النهاية.'),
  journeyLead: t('What really happens in a dashboard project when you ask for a page.', 'ما يحدث فعلاً في مشروع لوحة تحكم عندما تطلب صفحة.'),
  read: t('Read it in detail.', 'اقرأها بالتفصيل.'),
  readLead: t('A page for every part, and a page for every skill and agent.', 'صفحة لكل جزء، وصفحة لكل مهارة ووكيل.'),
}
---

<div class="details" id="details" data-details>
  <Chapter id="plain" title={words.plain[locale]} lead={words.plainLead[locale]}><Concepts locale={locale} /></Chapter>
  <Chapter id="example" title={words.journey[locale]} lead={words.journeyLead[locale]}><Journey locale={locale} /></Chapter>
  <Chapter id="contents" title={box.title} lead={box.lead}>
    <dl class="inventory">{box.contents(facts).map(([amount, label]) => <div><dt>{amount}</dt><dd>{label}</dd></div>)}</dl>
  </Chapter>
  <Chapter id="pages" title={words.read[locale]} lead={words.readLead[locale]}><PageIndex locale={locale} /></Chapter>
  <Chapter id="install-commands" title={install.title} lead={install.lead}>
    <Commands install={install} />
    <p class="note">{install.needs}</p>
  </Chapter>
  <SiteFooter locale={locale} />
</div>
