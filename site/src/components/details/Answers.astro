---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
}

import Chapter from './Chapter.astro'

const { answers } = Astro.props.copy
---

<Chapter id="questions" title={answers.title}>
  <div class="questions">
    {answers.items.map(([question, answer]) => (
      <details>
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>
    ))}
  </div>
</Chapter>
