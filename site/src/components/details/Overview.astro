---
import type { Copy, Details } from '../../content/types.ts'

interface Props {
  copy: Copy & Details
}

import { facts } from '../../lib/plugin.ts'
import Chapter from './Chapter.astro'

const { box, why, projects, features } = Astro.props.copy
---

<Chapter id="contents" title={box.title} lead={box.lead}>
  <dl class="inventory">
    {box.contents(facts).map(([amount, label]) => <div><dt>{amount}</dt><dd>{label}</dd></div>)}
  </dl>
</Chapter>

<Chapter id="all-reasons" title={why.title} lead={why.lead}>
  <table class="compare">
    <thead>
      <tr><th scope="col">{why.without}</th><th scope="col">{why.with}</th></tr>
    </thead>
    <tbody>
      {why.pairs.map(([without, withKit]) => <tr><td>{without}</td><td>{withKit}</td></tr>)}
    </tbody>
  </table>
  <div class="two">
    {[why.fit, why.skip].map(({ title, items }) => (
      <div>
        <h3>{title}</h3>
        <ul class="plain">{items.map((item) => <li>{item}</li>)}</ul>
      </div>
    ))}
  </div>
</Chapter>

<Chapter id="all-projects" title={projects.title} lead={projects.lead}>
  <div class="two">
    {projects.items.map(({ name, text, stack }) => (
      <div>
        <h3>{name}</h3>
        <p>{text}</p>
        <ul class="tags">{stack.map((item) => <li><bdi>{item}</bdi></li>)}</ul>
      </div>
    ))}
  </div>
</Chapter>

<Chapter id="all-features" title={features.title} lead={features.lead}>
  {features.groups.map((group) => (
    <div class="group">
      <h3>{group.title}</h3>
      <dl class="described">
        {group.items.map(([name, text]) => <div><dt>{name}</dt><dd>{text}</dd></div>)}
      </dl>
    </div>
  ))}
</Chapter>
