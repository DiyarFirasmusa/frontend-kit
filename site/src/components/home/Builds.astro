---
import { home } from '../../content/guide/home.ts'
import { projects } from '../../content/guide/projects.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// The three things a beginner can ask for. The fourth kind is for people who already have their own tools.
const kinds = projects.filter(({ id }) => id !== 'react')
---

<section id="builds" class="builds">
  <div class="column section-head">
    <h2>{home.builds.title[locale]}</h2>
    <p>{home.builds.lead[locale]}</p>
  </div>
  <ul class="column build-cards">
    {
      kinds.map(({ id, name, fits, gets, example }) => (
        <li class="build-card" data-kind={id}>
          <div class="build-picture" aria-hidden="true" dir="ltr">
            {id !== 'dashboard' && (
              <div class="mock mock-site">
                <div class="mock-nav">
                  <i class="mock-logo"></i>
                  <span class="mock-links"><i></i><i></i><i></i></span>
                  <i class="mock-button"></i>
                </div>
                <div class="mock-hero">
                  <i class="mock-line is-long"></i>
                  <i class="mock-line"></i>
                  <i class="mock-cta"></i>
                </div>
                <div class="mock-products">
                  <span><i></i><b></b></span>
                  <span><i></i><b></b></span>
                  <span><i></i><b></b></span>
                </div>
              </div>
            )}
            {id !== 'website' && (
              <div class="mock mock-dash">
                <div class="mock-side">
                  <i class="mock-logo"></i>
                  <i class="is-on"></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
                <div class="mock-main">
                  <div class="mock-stats">
                    <span><b></b><i></i></span>
                    <span><b></b><i></i></span>
                    <span><b></b><i></i></span>
                  </div>
                  <div class="mock-table">
                    <span><i></i><b class="is-done"></b></span>
                    <span><i></i><b class="is-wait"></b></span>
                    <span><i></i><b class="is-done"></b></span>
                    <span><i></i><b class="is-wait"></b></span>
                  </div>
                </div>
              </div>
            )}
          </div>
          <div class="build-words">
            <h3>{name[locale]}</h3>
            <p class="build-fits">{fits[locale]}</p>
            <ul class="ticks build-gets">
              {gets.slice(0, 3).map((item) => <li>{item[locale]}</li>)}
            </ul>
            <p class="build-say">
              <small>{home.builds.say[locale]}</small>
              <span>{example[locale]}</span>
            </p>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="column hero-ways">
    <a href={pageUrl(locale, 'project-types')}>{home.builds.more[locale]}</a>
  </p>
</section>
