---
import Board from './Board.astro'
import Mock from './Mock.astro'
import { home } from '../../content/guide/home.ts'
import { showcase } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<!-- What can you build: a board like "Start" (as tall as it), with the three kinds side by side. Each has a window that shows
     it, its name and one line. -->
<section id="builds" class="builds">
  <div class="column section-head">
    <h2>{home.builds.title[locale]}</h2>
    <p>{home.builds.lead[locale]}</p>
  </div>
  <div class="column">
    <Board locale={locale} part={1} label={home.types[locale]} tone="orange">
      <ul class="kinds" data-alive>
        {
          showcase.map((kind, i) => (
            <li class={`kind is-${kind.id}`} style={`--k:${i}`} data-tilt>
              <div class="browser kind-window" aria-hidden="true">
                <div class="browser-bar">
                  <span class="chat-lights"><i></i><i></i><i></i></span>
                  <span class="browser-url" dir="ltr">{kind.url}</span>
                </div>
                <div class="kind-page">
                  <Mock kind={kind.id} />
                </div>
              </div>
              <h3>{kind.tab[locale]}</h3>
              <p class="kind-line">{home.builds.examples[kind.id as keyof typeof home.builds.examples]?.[locale]}</p>
            </li>
          ))
        }
      </ul>
      <div slot="note">
        <p>{home.madeUp[locale]}</p>
        <a class="note-cta" href={pageUrl(locale, 'project-types')}>{home.builds.more[locale]}</a>
      </div>
    </Board>
  </div>
</section>
