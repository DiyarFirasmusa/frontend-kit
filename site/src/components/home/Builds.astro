---
import { home } from '../../content/guide/home.ts'
import { showcase } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import Mock from './Mock.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section id="builds" class="builds" data-kinds>
  <div class="column section-head">
    <h2>{home.builds.title[locale]}</h2>
    <p>{home.builds.lead[locale]}</p>
  </div>
  <div class="column show">
    <nav class="show-tabs" aria-label={home.builds.title[locale]}>
      {
        showcase.map(({ id, tab }, i) => (
          <a href={`#kind-${id}`} data-kind-link={i} aria-current={i === 0 ? 'true' : undefined}>
            {tab[locale]}
          </a>
        ))
      }
    </nav>
    {
      showcase.map(({ id, title, text, chips, say, url }, i) => (
        <article class="show-panel" id={`kind-${id}`} data-kind={i}>
          <div class="show-words">
            <h3>{title[locale]}</h3>
            <p>{text[locale]}</p>
            <ul class="show-chips">{chips.map((chip) => <li>{chip[locale]}</li>)}</ul>
            <p class="build-say">
              <small>{home.builds.say[locale]}</small>
              <span>{say[locale]}</span>
            </p>
          </div>
          <div class="show-picture" aria-hidden="true">
            <div class="browser">
              <div class="browser-bar">
                <span class="chat-lights"><i></i><i></i><i></i></span>
                <span class="browser-url" dir="ltr">{url}</span>
              </div>
              <div class="browser-page">
                <Mock kind={id} />
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
  <p class="column hero-ways">
    <a href={pageUrl(locale, 'project-types')}>{home.builds.more[locale]}</a>
  </p>
</section>
