---
import Board from './Board.astro'
import Mock from './Mock.astro'
import { home } from '../../content/guide/home.ts'
import { showcase } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const examples = home.builds.examples as Record<string, { en: string; ar: string }>
---

<!-- What can you build: a board like "Start" (as tall as it). On one side the three kinds, each a button with its name and
     real examples; on the other one big window that shows the picked kind. The kinds take turns by themselves while the
     board is on screen (a line under the picked one fills), until the visitor picks one (tabs.ts). -->
<section id="builds" class="builds">
  <div class="column section-head">
    <h2>{home.builds.title[locale]}</h2>
    <p>{home.builds.lead[locale]}</p>
  </div>
  <div class="column">
    <Board locale={locale} part={1} label={home.types[locale]} tone="orange" side="ink">
      <div class="make" data-kinds data-alive>
        <div class="make-tabs" role="tablist" aria-label={home.builds.title[locale]}>
          <i class="make-track" aria-hidden="true"></i>
          {
            showcase.map((kind, i) => (
              <button
                type="button"
                class={`make-tab is-${kind.id}`}
                role="tab"
                id={`make-tab-${kind.id}`}
                aria-controls={`make-panel-${kind.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-kind-tab
              >
                <span class="make-number">{i + 1}</span>
                <span class="make-name">{kind.tab[locale]}</span>
                <span class="make-examples">
                  {(examples[kind.id]?.[locale] ?? '').split(/[،,]\s*/).map((example) => <span>{example}</span>)}
                </span>
                <i class="make-time" aria-hidden="true"></i>
              </button>
            ))
          }
        </div>
        <div class="make-stage" data-tilt>
          {
            showcase.map((kind, i) => (
              <div
                class={`make-panel is-${kind.id}`}
                role="tabpanel"
                id={`make-panel-${kind.id}`}
                aria-labelledby={`make-tab-${kind.id}`}
                data-kind
                data-hidden={i === 0 ? undefined : ''}
              >
                <div class="browser make-window" aria-hidden="true">
                  <div class="browser-bar">
                    <span class="chat-lights"><i></i><i></i><i></i></span>
                    <span class="browser-url" dir="ltr">
                      <span class="make-url">{kind.url}</span>
                    </span>
                  </div>
                  <div class="make-page">
                    <Mock kind={kind.id} />
                  </div>
                </div>
                <p class="make-caption">{examples[kind.id]?.[locale]}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div slot="note">
        <p>{home.madeUp[locale]}</p>
        <a class="note-cta" href={pageUrl(locale, 'project-types')}>{home.builds.more[locale]}</a>
      </div>
    </Board>
  </div>
</section>
