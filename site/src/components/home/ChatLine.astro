---
import type { Bilingual } from '../../content/catalogue.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
  /** What Claude says it did, in plain words. */
  label: string | Bilingual
  /** A second, quieter line under it. */
  detail?: string | Bilingual | undefined
  /** ok: a check was done. bad: a risky step was stopped. ask: Claude asks you something. */
  mark?: 'ok' | 'bad' | 'ask' | undefined
}

const { locale, label, detail, mark } = Astro.props
const say = (text: string | Bilingual | undefined) => (typeof text === 'string' ? text : text?.[locale])
const yes = locale === 'ar' ? 'نعم، احفظ' : 'Yes, save it'
const no = locale === 'ar' ? 'ليس الآن' : 'Not yet'
---

<div class:list={['chat-line', mark && `is-${mark}`]} data-line>
  {
    mark === 'ask' ? (
      <>
        <p class="chat-say">{say(label)}</p>
        <p class="chat-choices" aria-hidden="true">
          <span class="is-main">{yes}</span>
          <span>{no}</span>
        </p>
      </>
    ) : (
      <>
        <i class="chat-mark" aria-hidden="true">{mark === 'bad' ? '✕' : '✓'}</i>
        <p class="chat-say">
          {say(label)}
          {detail && <small>{say(detail)}</small>}
        </p>
      </>
    )
  }
</div>
