---
import type { Bilingual } from '../../content/catalogue.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
  /** What Claude Code prints after the bullet: a tool call like Skill(name), a hook, or a plain message. */
  call: string
  /** The result line under it. */
  note?: string | Bilingual | undefined
  mark?: 'ok' | 'bad' | 'ask' | undefined
}

const { locale, call, note, mark } = Astro.props
const result = typeof note === 'string' ? note : note?.[locale]
// A call is a tool name and its argument, shown in two colours as Claude Code does.
const open = call.indexOf('(')
const tool = mark === 'ask' || open < 1 ? call : call.slice(0, open)
const argument = mark === 'ask' || open < 1 ? '' : call.slice(open)
---

<div class:list={['cc-line', mark && `is-${mark}`]} data-line>
  <p class="cc-call">
    <i aria-hidden="true">●</i>
    <span dir="ltr">
      <b class="cc-tool">{tool}</b>{argument && <span class="cc-args">{argument}</span>}
    </span>
  </p>
  {
    result && (
      <p class="cc-note">
        <i aria-hidden="true">⎿</i>
        <span class="cc-result">
          {mark === 'ok' && <b class="cc-tick" aria-hidden="true">✓</b>}
          {mark === 'bad' && <b class="cc-tick" aria-hidden="true">✕</b>}
          <span dir="auto">{result}</span>
        </span>
      </p>
    )
  }
</div>
