---
import { home } from '../../content/guide/home.ts'
import { projects } from '../../content/guide/projects.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import Commands from '../Commands.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { install, why } = content[locale]
---

<section id="install" class="get-it" data-stage-shape="mark">
  <div class="column">
    <h2 data-rise>{home.install[locale]}</h2>
    <Commands install={install} />
    <p class="needs">{home.host[locale]} {install.needs}</p>
    <h3>{home.types[locale]}</h3>
    <ul class="works-for">
      {projects.map(({ name, fits }) => <li><strong>{name[locale]}</strong><span>{fits[locale]}</span></li>)}
    </ul>
    <div class="fit">
      <div>
        <h3>{why.fit.title}</h3>
        <ul class="ticks">{why.fit.items.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h3>{why.skip.title}</h3>
        <ul class="crosses">{why.skip.items.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
    <p class="hero-ways"><a href={pageUrl(locale, 'docs')}>{home.docs[locale]}</a></p>
  </div>
</section>
