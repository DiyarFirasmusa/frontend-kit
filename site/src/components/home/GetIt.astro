---
import { home } from '../../content/guide/home.ts'
import { projects } from '../../content/guide/projects.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { INSTALL_COMMANDS } from '../../lib/plugin.ts'
import CommandBox from '../CommandBox.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { install, why } = content[locale]
---

<section id="install" class="get-it">
  <div class="column section-head">
    <h2>{home.install[locale]}</h2>
    <p>{install.needs}</p>
  </div>
  <div class="column">
    <ol class="install-steps">
      {
        INSTALL_COMMANDS.map((command, i) => (
          <li>
            <span class="step-number" dir="ltr">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p>{install.steps[i]}</p>
            <CommandBox command={command} install={install} />
          </li>
        ))
      }
    </ol>

    <h3 class="get-it-title">{home.types[locale]}</h3>
    <ul class="works-for">
      {
        projects.map(({ name, fits }) => (
          <li>
            <strong>{name[locale]}</strong>
            <span>{fits[locale]}</span>
          </li>
        ))
      }
    </ul>

    <div class="fit">
      <div>
        <h3>{why.fit.title}</h3>
        <ul class="ticks">{why.fit.items.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h3>{why.skip.title}</h3>
        <ul class="crosses">{why.skip.items.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
    <p class="hero-ways"><a href={pageUrl(locale, 'docs')}>{home.docs[locale]}</a></p>
  </div>
</section>
