---
import { home } from '../../content/guide/home.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { installFlow } from '../../content/guide/start.ts'
import CommandBox from '../CommandBox.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { install } = content[locale]
---

<section id="install" class="get-it">
  <div class="column section-head">
    <h2>{home.install[locale]}</h2>
    <p>{install.needs}</p>
  </div>
  <div class="column">
    <ol class="install-steps">
      {
        installFlow.map(({ title, text, copy }, i) => (
          <li>
            <span class="step-number" dir="ltr">
              {i + 1}
            </span>
            <p>
              <strong>{title[locale]}</strong> {text[locale]}
            </p>
            {copy && <CommandBox command={typeof copy === 'string' ? copy : copy[locale]} install={install} message={typeof copy !== 'string'} />}
          </li>
        ))
      }
    </ol>


    <p class="hero-ways">
      <a href={pageUrl(locale, 'get-started')}>{locale === 'ar' ? 'عندك مشروع جاهز أو قديم؟ اقرأ كيف تبدأ منه' : 'Already have a project, or an old one? Read how to start from it'}</a>
    </p>
    <p class="hero-ways"><a href={pageUrl(locale, 'docs')}>{home.docs[locale]}</a></p>
  </div>
</section>
