---
import { compare, installWords as words } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const w = compare.slider
const rows = [w.row1, w.row2, w.row3, w.row4]
---

<section id="why" class="compare-section">
  <div class="column section-head">
    <h2>{compare.title[locale]}</h2>
    <p>{w.lead[locale]}</p>
  </div>

  <div class="column">
    <p class="ba-ask"><span>{w.ask[locale]}</span></p>

    <div class="ba" data-ba style="--pos: 50%">
      <div class="ba-layer ba-good" aria-label={compare.with[locale]} role="img">
        <div class="dash" dir={locale === 'ar' ? 'rtl' : 'ltr'}>
          <div class="dash-side">
            <b class="dash-logo">▣ my-shop</b>
            <span class="is-on">{w.orders[locale]}</span>
            <span>{w.customers[locale]}</span>
            <span>{w.products[locale]}</span>
          </div>
          <div class="dash-main">
            <div class="dash-top">
              <strong>{w.orders[locale]}</strong>
              <span class="dash-search">{w.search[locale]}</span>
              <span class="dash-button">{w.newOrder[locale]}</span>
            </div>
            <div class="dash-stats">
              <span><b>128</b>{w.statAll[locale]}</span>
              <span><b>24</b>{w.statWait[locale]}</span>
              <span><b>96%</b>{w.statDone[locale]}</span>
            </div>
            <div class="dash-table">
              {
                rows.map((row, i) => (
                  <p>
                    <span>{row[locale]}</span>
                    <i class:list={['dash-pill', i === 1 ? 'is-wait' : 'is-done']}>{i === 1 ? w.wait[locale] : w.done[locale]}</i>
                  </p>
                ))
              }
            </div>
            <p class="dash-toast">✓ {w.saved[locale]}</p>
          </div>
        </div>
      </div>

      <div class="ba-layer ba-bad" aria-label={compare.without[locale]} role="img">
        <div class="dash is-broken" dir={locale === 'ar' ? 'rtl' : 'ltr'}>
          <div class="dash-side">
            <b class="dash-logo">▣ my-shop</b>
            <span>{w.orders[locale]}</span>
            <span>Customers</span>
            <span>{w.products[locale]}</span>
          </div>
          <div class="dash-main">
            <p class="dash-error">✕ {w.error[locale]}</p>
            <div class="dash-top">
              <strong dir="ltr">{w.broken[locale]}</strong>
              <span class="dash-button">{w.newOrder[locale]}</span>
            </div>
            <div class="dash-stats">
              <span><b>NaN</b>{w.statAll[locale]}</span>
              <span><b>undefined</b></span>
              <span><b>0%</b>{w.statDone[locale]}</span>
            </div>
            <div class="dash-table">
              {
                rows.map((row, i) => (
                  <p style={`--n:${i}`}>
                    <span>{row[locale]}</span>
                    <i class="dash-pill">{i % 2 ? 'status' : '...'}</i>
                  </p>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <span class="ba-tag is-bad"><span aria-hidden="true">✕ </span>{compare.without[locale]}</span>
      <span class="ba-tag is-good"><span aria-hidden="true">✓ </span>{compare.with[locale]}</span>
      <span class="ba-handle" aria-hidden="true"><i>⟷</i></span>
      <input class="ba-range" type="range" min="0" max="100" value="50" aria-label={w.drag[locale]} data-ba-range data-bad={compare.without[locale]} data-good={compare.with[locale]} />
    </div>
    <p class="ba-note">{words.illustration[locale]}</p>

    <ul class="ba-results">
      {
        w.results.map((result) => (
          <li>
            <i aria-hidden="true">✓</i>
            {result[locale]}
          </li>
        ))
      }
    </ul>
    <p class="ba-note ba-differs">{words.differs[locale]}</p>
  </div>
</section>
