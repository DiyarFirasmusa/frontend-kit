---
import { chatWords } from '../../content/guide/chat.ts'
import { compare } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// The same project, twice: once as an AI alone leaves it, once as the kit builds it.
const messy: [string, number, boolean?][] = [
  ['src/', 0],
  ['Button.tsx', 1],
  ['Button2.tsx', 1, true],
  ['components/', 1],
  ['button-new.tsx', 2, true],
  ['helpers.js', 1],
  ['utils/helpers2.js', 1, true],
  ['page-final-v3.tsx', 1, true],
]
const tidy: [string, number, string?][] = [
  ['src/', 0],
  ['pages/', 1, 'orders · customers'],
  ['components/', 1, 'Button.tsx'],
  ['features/orders/', 1],
  ['i18n/', 1, 'ar · en'],
]
---

<section id="why" class="compare-section">
  <div class="column section-head">
    <h2>{compare.title[locale]}</h2>
    <p>{compare.lead[locale]}</p>
  </div>

  <div class="column">
    <figure class="vs-box" data-alive>
      <div class="chat-bar" aria-hidden="true">
        <span class="chat-lights"><i></i><i></i><i></i></span>
        <span class="chat-title"><i>✻</i> <bdi>{chatWords.title[locale]}</bdi></span>
      </div>
      <div class="vs-halves">
        <div class="vs-half is-without">
          <p class="vs-label">{compare.without[locale]}</p>
          <ul class="vs-tree is-messy" dir="ltr" aria-hidden="true">
            {messy.map(([name, depth, wrong], i) => (
              <li class:list={{ 'is-wrong': wrong, 'is-folder': name.endsWith('/') }} style={`--d:${depth};--n:${i}`}>
                {name}
              </li>
            ))}
          </ul>
          <ul class="vs-log is-bad">
            {compare.gains.map(({ instead }, i) => (
              <li style={`--n:${i}`}>
                <i aria-hidden="true">✕</i>
                {instead[locale]}
              </li>
            ))}
          </ul>
          <p class="vs-status is-bad"><i aria-hidden="true">✕</i>{compare.broken[locale]}</p>
        </div>

        <span class="vs-badge" aria-hidden="true">vs</span>

        <div class="vs-half is-with">
          <p class="vs-label"><i aria-hidden="true">✻</i>{compare.with[locale]}</p>
          <ul class="vs-tree" dir="ltr" aria-hidden="true">
            {tidy.map(([name, depth, inside]) => (
              <li class="is-folder" style={`--d:${depth}`}>
                {name} {inside && <span>{inside}</span>}
              </li>
            ))}
          </ul>
          <ul class="vs-log is-good">
            {compare.gains.map(({ name }, i) => (
              <li style={`--n:${i}`}>
                <i aria-hidden="true">✓</i>
                {name[locale]}
              </li>
            ))}
          </ul>
          <p class="vs-status is-good"><i aria-hidden="true">✓</i>{compare.fine[locale]}</p>
        </div>
      </div>
    </figure>
  </div>
</section>
