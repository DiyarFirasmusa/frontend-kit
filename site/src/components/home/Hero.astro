---
import type { Bilingual } from '../../content/catalogue.ts'
import { home } from '../../content/guide/home.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { verdicts } from '../../lib/verdicts.ts'
import Commands from '../Commands.astro'
import CcLine from './CcLine.astro'
import CcWelcome from './CcWelcome.astro'

interface Props {
  locale: Locale
}

interface Line {
  call: string
  note?: string | Bilingual
  mark?: 'ok' | 'bad' | 'ask'
}

const { locale } = Astro.props
const main = verdicts.find(({ id }) => id === 'main')!
const gate = (what: Bilingual): Line => ({ call: 'Stop hook', note: what, mark: 'ok' })
const checked: Bilingual = { en: 'no mistakes found, tests passed', ar: 'لا أخطاء، ونجحت الاختبارات' }

// Four real requests, played one after another in the console. Names and answers come from the kit itself.
const demos: { prompt: Bilingual; lines: Line[] }[] = [
  {
    prompt: home.prompt,
    lines: [
      { call: 'Skill(setup)', note: { en: 'asks you five simple questions', ar: 'تسألك خمسة أسئلة بسيطة' } },
      { call: 'Skill(dash-create-table)', note: { en: 'builds orders, customers, products', ar: 'تبني الطلبات والعملاء والمنتجات' } },
      gate(checked),
    ],
  },
  {
    prompt: { en: 'Make it look like a site I like', ar: 'اجعله يشبه موقعا يعجبني' },
    lines: [
      { call: 'Skill(frontend-design)', note: { en: 'takes the colours and the feel, not a copy', ar: 'تأخذ الألوان والإحساس، لا نسخة' } },
      { call: 'Agent(frontend-reviewer)', note: home.session.reviewing },
      gate(checked),
    ],
  },
  {
    prompt: { en: 'Add Arabic next to English', ar: 'أضف العربية بجانب الإنجليزية' },
    lines: [
      { call: 'Skill(i18n-conventions)', note: { en: 'both languages, right-to-left works', ar: 'اللغتان معا، والكتابة من اليمين لليسار تعمل' } },
      gate(checked),
    ],
  },
  {
    prompt: { en: 'Send my changes straight to the live version', ar: 'أرسل تغييراتي مباشرة إلى النسخة الحية' },
    lines: [{ call: `Bash(${main.command})`, note: main.reason, mark: 'bad' }],
  },
]
---

<section id="intro" class="hero" data-hero>
  <div class="column hero-copy">
    <h1 class="enter">{home.title[locale].split(/(?<=\.) /).map((part) => <span>{part}</span>)}</h1>
    <p class="hero-lead enter">{home.lead[locale]}</p>
    <div class="enter">
      <Commands install={content[locale].install} first />
    </div>
    <p class="hero-ways enter">
      <a href="#example">{home.see[locale]}</a>
      <a href={pageUrl(locale, 'docs')}>{home.docs[locale]}</a>
    </p>
  </div>
  <div class="hero-side">
    <figure class="cc live" dir="ltr" data-live aria-label={home.example[locale]}>
      <CcWelcome />
      {
        demos.map(({ prompt, lines }, i) => (
          <div class="demo" data-demo={i} hidden={i > 0}>
            <p class="cc-user">
              <i aria-hidden="true">&gt;</i>
              <q data-type dir="auto">{prompt[locale]}</q>
            </p>
            <div class="cc-lines">
              {lines.map((line) => <CcLine locale={locale} {...line} />)}
            </div>
          </div>
        ))
      }
      <p class="cc-status" data-status hidden aria-hidden="true"><i data-spinner>✻</i> <span>Thinking…</span> <small>(esc to interrupt)</small></p>
      <div class="cc-input" aria-hidden="true" data-box>
        <i>&gt;</i>
        <span class="cc-placeholder">Try “fix lint errors”</span>
        <span class="cc-typed" data-input dir="auto"></span>
        <b class="caret"></b>
      </div>
      <div class="cc-foot" aria-hidden="true">
        <span>? for shortcuts</span>
        <ol class="demo-dots">{demos.map((_, i) => <li data-dot={i} class:list={{ 'is-on': i === 0 }}></li>)}</ol>
      </div>
    </figure>
  </div>
</section>
