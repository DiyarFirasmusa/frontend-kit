---
import { firstRun } from '../../content/guide/chat.ts'
import { home } from '../../content/guide/home.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import Board from './Board.astro'
import ChatEvent from './ChatEvent.astro'
import ChatWindow from './ChatWindow.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section id="intro" class="hero" data-hero>
  <div class="column hero-copy">
    <h1 class="enter">{home.title[locale].split(/(?<=\.) /).map((part) => <span>{part}</span>)}</h1>
    <p class="hero-lead enter">{home.lead[locale]}</p>
    <div class="hero-phone enter" data-hero-phone>
      <strong>{home.phoneTitle[locale]}</strong>
      <span>{home.phoneBody[locale]}</span>
      <button type="button" data-share-link data-done={home.phoneDone[locale]} data-shared={home.phoneShared[locale]}>{home.phoneCopy[locale]}</button>
      <span class="sr-only" role="status" data-share-status></span>
      <a href="#example">{home.phoneOr[locale]}</a>
    </div>
    <p class="hero-actions enter">
      <a class="hero-start" href="#install">{home.start[locale]}</a>
      <a href="#example">{home.see[locale]}</a>
    </p>
    <p class="hero-trust enter">{home.trust[locale]}</p>
    <p class="hero-audience-label enter" id="hero-who">{home.audienceLabel[locale]}</p>
    <ul class="hero-audience enter" aria-labelledby="hero-who">
      {home.audience.map(({ label, to }) => <li><a href={to.startsWith('#') ? to : pageUrl(locale, 'developers') + to.replace('developers', '')}>{label[locale]}</a></li>)}
    </ul>
  </div>
  <div class="hero-side">
    <Board locale={locale} part={-1} label={home.board.top[locale]} tone="orange">
      <ChatWindow locale={locale} label={home.example[locale]} live>
        {firstRun.map((event) => <ChatEvent locale={locale} event={event} />)}
      </ChatWindow>
      <Fragment slot="side">
        <p class="board-side-title">{home.board.getTitle[locale]}</p>
        <ul class="board-list">
          {home.board.get.map((item, i) => <li>{item[locale]}<small>{home.board.getDetail[i]?.[locale]}</small></li>)}
        </ul>
      </Fragment>
      <p slot="note">{home.board.note[locale]}</p>
    </Board>
  </div>
</section>
