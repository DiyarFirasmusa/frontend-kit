---
import { home } from '../../content/guide/home.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { facts } from '../../lib/plugin.ts'
import Commands from '../Commands.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { kinds } = home
const counts = [
  [kinds.skills, facts.skills, 'skills'],
  [kinds.agents, facts.agents, 'agents'],
  [kinds.rules, facts.rules, 'rules'],
  [kinds.checks, facts.events, 'checks'],
] as const
---

<section id="intro" class="hero">
  <div class="column hero-copy">
    <h1 class="enter">{home.title[locale].split(/(?<=\.) /).map((part) => <span>{part}</span>)}</h1>
    <p class="hero-lead enter">{home.lead[locale]}</p>
    <div class="enter">
      <Commands install={content[locale].install} first />
    </div>
    <p class="hero-ways enter">
      <a href="#example">{home.see[locale]}</a>
      <a href={pageUrl(locale, 'docs')}>{home.docs[locale]}</a>
    </p>
  </div>
  <div class="hero-grid">
    <ul class="points">
      {
        home.points.map(({ name, text }, i) => (
          <li class="enter">
            <span class="point-number" dir="ltr">0{i + 1}</span>
            <h2>{name[locale]}</h2>
            <p>{text[locale]}</p>
          </li>
        ))
      }
    </ul>
    <ul class="counts">
      {
        counts.map(([name, count, page]) => (
          <li class="enter">
            <a href={pageUrl(locale, page)}>
              <b dir="ltr">{count}</b>
              <span>{name[locale]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
