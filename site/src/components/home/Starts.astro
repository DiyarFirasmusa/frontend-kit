---
import type { PageId } from '../../content/guide/pages.ts'
import { home } from '../../content/guide/home.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { title, lead, cases, more } = home.starts
---

<section id="starts" class="starts">
  <div class="column section-head">
    <h2>{title[locale]}</h2>
    <p>{lead[locale]}</p>
  </div>
  <div class="column">
    <ul class="start-cases">
      {
        cases.map(({ mode, name, text, command, page }) => (
          <li>
            <span class="start-mode" dir="ltr">
              mode: {mode}
            </span>
            <h3>{name[locale]}</h3>
            <p>{text[locale]}</p>
            <a class="start-command" href={pageUrl(locale, page as PageId)} dir="ltr">
              <code>{command}</code>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="hero-ways">
      <a href={pageUrl(locale, 'modes')}>{more[locale]}</a>
    </p>
  </div>
</section>
