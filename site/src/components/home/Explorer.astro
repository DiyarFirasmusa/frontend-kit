---
import { agentGuides } from '../../content/guide/agents.ts'
import { home } from '../../content/guide/home.ts'
import { agentPurpose, hookPurpose, rulePurpose, skillPurpose } from '../../content/guide/purpose.ts'
import { ruleGuides } from '../../content/guide/rules.ts'
import { skillGuides } from '../../content/guide/skills/index.ts'
import { content } from '../../content/index.ts'
import type { Bilingual } from '../../content/catalogue.ts'
import type { Locale } from '../../content/types.ts'
import { agentOrder, hookOrder, skillOrder } from '../../lib/kit-map.ts'
import { agentUrl, hookUrl, ruleUrl, skillUrl } from '../../lib/links.ts'
import { ruleGroups } from '../../lib/plugin.ts'

interface Props {
  locale: Locale
}

interface Choice {
  id: string
  name: string
  href: string
  facts: [label: Bilingual, text: string][]
  say?: string
}

const { locale } = Astro.props
const copy = content[locale]
const { why, when, does } = home
const kinds: { kind: keyof typeof home.kinds; choices: Choice[] }[] = [
  {
    kind: 'skills',
    choices: skillOrder.map((name) => ({
      id: `skill-${name}`,
      name,
      href: skillUrl(locale, name),
      facts: [
        [does, skillGuides[name]!.plain[locale]],
        [why, skillPurpose[name]!.why[locale]],
        [when, skillPurpose[name]!.when[locale]],
      ],
      say: skillGuides[name]!.ask[0]![locale],
    })),
  },
  {
    kind: 'agents',
    choices: agentOrder.map((name) => ({
      id: `agent-${name}`,
      name,
      href: agentUrl(locale, name),
      facts: [
        [does, agentGuides[name]!.plain[locale]],
        [why, agentPurpose[name]!.why[locale]],
        [when, agentPurpose[name]!.when[locale]],
      ],
      say: agentGuides[name]!.ask[locale],
    })),
  },
  {
    kind: 'rules',
    choices: ruleGroups.flatMap(({ group, names }) =>
      names.map((name) => ({
        id: `rule-${group.replaceAll('/', '-')}-${name.replace('.md', '')}`,
        name: group === 'shared' ? name : `${group.split('/').at(-1)}/${name}`,
        href: ruleUrl(locale, group, name),
        facts: [
          [does, ruleGuides[`${group}/${name}`]![locale]],
          [why, rulePurpose[`${group}/${name}`]![locale]],
        ] as [Bilingual, string][],
      })),
    ),
  },
  {
    kind: 'checks',
    choices: hookOrder.map((event) => ({
      id: `hook-${event}`,
      name: event,
      href: hookUrl(locale, event),
      facts: [
        [when, copy.session.events[event][0]],
        [does, copy.session.events[event][1]],
        [why, hookPurpose[event][locale]],
      ],
    })),
  },
]
---

<section id="inside" class="inside" data-explorer>
  <div class="column section-head">
    <h2>{home.inside[locale]}</h2>
    <p>{home.insideLead[locale]}</p>
  </div>
  <div class="column">
    <div class="kinds">
      {
        kinds.map(({ kind, choices }, i) => (
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-kind={kind}>
            <b dir="ltr">{choices.length}</b>
            <span>{home.kinds[kind][locale]}</span>
          </button>
        ))
      }
    </div>
    <div class="inside-body">
      <div class="inside-list">
        {
          kinds.map(({ kind, choices }) => (
            <ul class="choices" data-kind-list={kind}>
              {choices.map(({ id, name, href }) => (
                <li>
                  <a href={href} data-choice={id} data-kind-of={kind}>
                    <bdi>{name}</bdi>
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
      <div class="detail" aria-live="polite" data-detail>
        {
          kinds.flatMap(({ kind, choices }) =>
            choices.map(({ id, name, href, facts, say }, i) => (
              <article data-panel={id} hidden={kind !== 'skills' || i > 0}>
                <p class="detail-kind">{home.kindIs[kind][locale]}</p>
                <h3>
                  <bdi>{name}</bdi>
                </h3>
                <dl>
                  {facts.map(([label, text]) => (
                    <div>
                      <dt>{label[locale]}</dt>
                      <dd>{text}</dd>
                    </div>
                  ))}
                </dl>
                {say && (
                  <div class="detail-say">
                    <p>{home.type[locale]}</p>
                    <q dir="auto">{say}</q>
                  </div>
                )}
                <a class="detail-open" href={href}>
                  {home.open[locale]}
                  <span class="sr-only">: {name}</span>
                </a>
              </article>
            )),
          )
        }
      </div>
    </div>
  </div>
</section>
