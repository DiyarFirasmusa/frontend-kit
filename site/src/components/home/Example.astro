---
import Board from './Board.astro'
import ChatEvent from './ChatEvent.astro'
import ChatWindow from './ChatWindow.astro'
import Mock from './Mock.astro'
import { home } from '../../content/guide/home.ts'
import { howWords as h, journeyWords as w } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const last = h.steps.length - 1
---

<section id="example" class="example">
  <!-- No title above it: the four steps say it themselves. The heading stays for screen readers. -->
  <h2 class="sr-only">{home.example[locale]}</h2>
  <div class="column">
    <Board locale={locale} part={1} label={locale === 'ar' ? 'كيف تعمل' : 'How it works'} tone="orange" bare>
      <!-- The whole first run on one road, from the first message to the project you open. Each step explains itself. -->
      <ol class="path road" data-alive>
        {
          h.steps.map((step, i) => (
            <li class:list={['path-stop', { 'is-current': i === 0, 'is-last': i === last }]} data-who={step.who} style={`--n:${i}`}>
              <span class="road-pin path-dot">{i + 1}</span>
              <div class="road-screen" aria-hidden="true">
                {step.chat ? (
                  <ChatWindow locale={locale} label={step.title[locale]}>
                    {step.chat.map((event) => <ChatEvent locale={locale} event={event} />)}
                  </ChatWindow>
                ) : (
                  <div class="browser">
                    <div class="browser-bar">
                      <span class="chat-lights"><i></i><i></i><i></i></span>
                      <span class="browser-url" dir="ltr">my-shop</span>
                    </div>
                    <div class="browser-page">
                      <Mock kind="dashboard" />
                    </div>
                    <p class="road-save"><span>{w.save[locale]}</span><b>{w.yes[locale]}</b><i>{w.no[locale]}</i></p>
                  </div>
                )}
              </div>
              <button type="button" class="path-pick">
                <strong>{step.title[locale]}</strong>
                <span class="path-text">{step.text[locale]}</span>
                <span class="road-move"><b>{step.who === 'kit' ? h.kit[locale] : h.move[locale]}</b>{step.move[locale]}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </Board>
  </div>
</section>
