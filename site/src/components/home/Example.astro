---
import Board from './Board.astro'
import ChatEvent from './ChatEvent.astro'
import ChatWindow from './ChatWindow.astro'
import Mock from './Mock.astro'
import { home } from '../../content/guide/home.ts'
import { howWords as h, journeyWords as w } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section id="example" class="example">
  <div class="column section-head">
    <h2>{home.example[locale]}</h2>
    <p>{w.lead[locale]}</p>
  </div>
  <div class="column">
    <Board locale={locale} part={1} label={locale === 'ar' ? 'كيف تعمل' : 'How it works'} tone="orange">
      <div class="hw">
        <!-- The four steps, in a row. Pointing at one, or pressing it, shows it in both windows below. -->
        <ol class="path">
          {
            w.stops.map((stop, i) => (
              <li class:list={['path-stop', { 'is-current': i === 0 }]} data-who={i === 2 ? 'kit' : 'you'} style={`--n:${i}`}>
                <button type="button" class="path-pick">
                  <span class="path-dot" dir="ltr">{i + 1}</span>
                  <strong>{stop[locale]}</strong>
                  <span class="path-text">{w.details[i]![locale]}</span>
                </button>
              </li>
            ))
          }
        </ol>
        <div class="hw-stage" aria-hidden="true">
          <div class="hw-pane is-you">
            <p class="hw-label">{h.you[locale]}</p>
            <ChatWindow locale={locale} label={h.you[locale]}>
              <div class="hw-steps">
                {
                  h.chat.map((events, i) => (
                    <div class:list={['hw-step', { 'is-current': i === 0 }]} data-step={i}>
                      <div class="hw-events">{events.map((event) => <ChatEvent locale={locale} event={event} />)}</div>
                      <p class="hw-cap is-you"><strong>{h.move[locale]}</strong>{h.youDo[i]![locale]}</p>
                    </div>
                  ))
                }
              </div>
            </ChatWindow>
          </div>
          <div class="hw-pane is-get">
            <p class="hw-label">{h.get[locale]}</p>
            <div class="browser">
              <div class="browser-bar">
                <span class="chat-lights"><i></i><i></i><i></i></span>
                <span class="browser-url" dir="ltr">my-shop</span>
              </div>
              <div class="browser-page hw-steps">
                <div class="hw-step is-current" data-step="0">
                  <div class="hw-folder" dir="ltr">
                    <p>my-shop/</p>
                    <span>{h.folder[locale]}</span>
                  </div>
                  <p class="hw-cap"><strong>{h.result[0]!.title[locale]}</strong>{h.result[0]!.text[locale]}</p>
                </div>
                <div class="hw-step" data-step="1">
                  <div class="hw-plan">
                    <p>{h.plan[locale]}</p>
                    <ul>
                      {h.planItems.map((item) => <li>{item[locale]}</li>)}
                    </ul>
                  </div>
                  <p class="hw-cap"><strong>{h.result[1]!.title[locale]}</strong>{h.result[1]!.text[locale]}</p>
                </div>
                <div class="hw-step" data-step="2">
                  <div class="hw-shot"><Mock kind="dashboard" /></div>
                  <p class="hw-cap"><strong>{h.result[2]!.title[locale]}</strong>{h.result[2]!.text[locale]}</p>
                </div>
                <div class="hw-step" data-step="3">
                  <div class="hw-shot"><Mock kind="dashboard" /></div>
                  <p class="hw-cap"><strong>{h.result[3]!.title[locale]}</strong>{h.result[3]!.text[locale]}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div slot="note">
        <p>{w.noteLine[locale]}</p>
        <a class="hero-start" href="#install">{home.start[locale]}</a>
      </div>
    </Board>
  </div>
</section>
