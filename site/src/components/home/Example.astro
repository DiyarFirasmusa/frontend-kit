---
import Board from './Board.astro'
import { home } from '../../content/guide/home.ts'
import { journeyWords as w } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section id="example" class="example">
  <div class="column section-head">
    <h2>{home.example[locale]}</h2>
    <p>{w.lead[locale]}</p>
  </div>
  <div class="column">
    <Board locale={locale} part={1} label={locale === 'ar' ? 'كيف تعمل' : 'How it works'} tone="orange">
    <ol class="path" data-alive>
      <li class="path-track" role="presentation" aria-hidden="true"><i></i></li>
      {
        w.stops.map((stop, i) => (
          <li class="path-stop" data-who={i === 2 ? 'kit' : 'you'} style={`--n:${i}`}>
            <div class="path-picture" aria-hidden="true">
              {i === 0 && (
                <div class="jp-input">
                  <span class="jp-typed">{w.install[locale]}</span>
                  <i class="chat-send">↑</i>
                </div>
              )}
              {i === 1 && (
                <div class="jp-ask">
                  <p>{w.ask[locale]}</p>
                  <ul>
                    {w.options.map((option, n) => (
                      <li class:list={{ 'is-pick': n === 0 }} style={`--o:${n}`}>
                        <span class="ce-key" dir="ltr">{n + 1}</span>
                        {option[locale]}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {i === 2 && (
                <ul class="jp-build">
                  {w.pages.map((page, n) => (
                    <li style={`--o:${n}`}>
                      <span>{page[locale]}</span>
                      <i class="jp-bar"><b></b></i>
                    </li>
                  ))}
                </ul>
              )}
              {i === 3 && (
                <div class="jp-save">
                  <p>{w.save[locale]}</p>
                  <span class="jp-pill jp-yes">{w.yes[locale]}</span>
                  <span class="jp-pill is-quiet">{w.no[locale]}</span>
                </div>
              )}
            </div>
            <div class="path-label">
              <span class="path-dot" dir="ltr">{i + 1}</span>
              <strong>{stop[locale]}</strong>
              <p>{w.details[i]![locale]}</p>
            </div>
          </li>
        ))
      }
    </ol>
      <Fragment slot="side">
        <p class="board-side-title">{w.endTitle[locale]}</p>
        <ul class="board-list">
          {w.end.map((line, i) => <li>{line[locale]}<small>{w.endDetail[i]?.[locale]}</small></li>)}
        </ul>
      </Fragment>
      <div slot="note">
        <p>{w.noteLine[locale]}</p>
        <a class="hero-start" href="#install">{home.start[locale]}</a>
      </div>
    </Board>
  </div>

</section>

<style is:global>
  /* In the home page's layer (the order is explained in styles/site.css; it is repeated here in case this loads first),
     so these rules compete with the home page's own by specificity, like every other page rule. */
  @layer astro, shared, page, skin, skin-page;

  @layer page {
    /* Four steps, four windows: you send, you answer, Claude builds, you decide. */
    ol.path {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }

    /* Who acts at each step: you in orange, the kit in turquoise, dark digits on both. */
    .board .path .path-stop[data-who='you'] .path-dot {
      background: var(--accent);
      color: var(--on-accent);
    }

    .board .path .path-stop[data-who='kit'] .path-dot {
      background: var(--turq);
      color: var(--on-accent);
    }

    /* The question window shows two choices, so none is cut off. */
    .jp-ask ul li:nth-child(n + 3) {
      display: none;
    }

    @media (width < 48rem) {
      ol.path {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }
</style>
