---
import type { Bilingual } from '../../content/catalogue.ts'
import { home } from '../../content/guide/home.ts'
import type { Locale } from '../../content/types.ts'
import { verdicts } from '../../lib/verdicts.ts'
import CcLine from './CcLine.astro'
import CcWelcome from './CcWelcome.astro'

interface Props {
  locale: Locale
}

interface Line {
  call: string
  note?: string | Bilingual
  mark?: 'ok' | 'bad' | 'ask'
}

const { locale } = Astro.props
const refused = verdicts.find(({ id }) => id === 'force')!
const { skills, rules, guard, gate: gate_, review, done } = home.steps
const say = home.session
const gate = (what: Bilingual): Line => ({ call: 'Stop hook', note: what, mark: 'ok' })
// What the console shows at each step: real names from the kit, the real answer of its guard.
const steps: { name: Bilingual; text: Bilingual; lines: Line[] }[] = [
  { ...skills, lines: [{ call: 'Skill(dash-create-table)' }, { call: 'Skill(dash-create-filter-bar)' }] },
  {
    ...rules,
    lines: [{ call: 'Rule(dashboard/data-tables.md)' }, { call: 'Rule(dashboard/permissions.md)' }, { call: 'Rule(dashboard/api-layer.md)' }],
  },
  { ...guard, lines: [{ call: `Bash(${refused.command})`, note: refused.reason, mark: 'bad' }] },
  {
    ...gate_,
    lines: [
      gate({ en: 'typecheck passed', ar: 'نجح فحص الأنواع' }),
      gate({ en: 'related tests passed', ar: 'نجحت الاختبارات المرتبطة' }),
    ],
  },
  { ...review, lines: [{ call: 'Agent(frontend-reviewer)', note: say.reviewing }] },
  { ...done, lines: [{ call: say.ask[locale], mark: 'ask' }] },
]
---

<section id="example" class="example" data-example>
  <div class="column example-head">
    <h2>{home.example[locale]}</h2>
    <p>{home.exampleLead[locale]}</p>
  </div>
  <div class="column example-body">
    <ol class="run">
      {
        steps.map(({ name, text }, i) => (
          <li data-step={i} aria-current={i === 0 ? 'step' : undefined}>
            <span class="run-number" dir="ltr">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{name[locale]}</h3>
            <p>{text[locale]}</p>
          </li>
        ))
      }
    </ol>
    <figure class="cc" dir="ltr" aria-label={home.example[locale]}>
      <CcWelcome />
      <p class="cc-user">
        <i aria-hidden="true">&gt;</i>
        <q dir="auto">{home.prompt[locale]}</q>
      </p>
      <div class="session-lines">
        {
          steps.map(({ lines }, i) => (
            <div class="session-group" data-shows={i}>
              <div class="group-inner">{lines.map((line) => <CcLine locale={locale} {...line} />)}</div>
            </div>
          ))
        }
      </div>
      <div class="cc-input" aria-hidden="true">
        <i>&gt;</i>
        <span>Try “fix lint errors”</span>
      </div>
      <div class="cc-foot" aria-hidden="true"><span>? for shortcuts</span></div>
    </figure>
  </div>
</section>
