---
import { home } from '../../content/guide/home.ts'
import { journeyWords as w } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section id="example" class="example">
  <div class="column section-head">
    <h2>{home.example[locale]}</h2>
    <p>{w.lead[locale]}</p>
  </div>
  <ol class="column path" data-alive>
    {
      w.stops.map((stop, i) => (
        <li class="path-stop" style={`--n:${i}`}>
          <div class="path-picture" aria-hidden="true">
            {i === 0 && (
              <div class="jp-input">
                <span class="jp-typed">{w.install[locale]}</span>
                <i class="chat-send">↑</i>
              </div>
            )}
            {i === 1 && (
              <div class="jp-ask">
                <p>{w.ask[locale]}</p>
                <ul>
                  {w.options.map((option, n) => (
                    <li class:list={{ 'is-pick': n === 0 }} style={`--o:${n}`}>
                      <span class="ce-key" dir="ltr">{n + 1}</span>
                      {option[locale]}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {i === 2 && (
              <div class="jp-plan">
                <ul>{w.plan.map((line, n) => <li style={`--o:${n}`}>{line[locale]}</li>)}</ul>
                <span class="jp-pill jp-go">{w.start[locale]}</span>
              </div>
            )}
            {i === 3 && (
              <ul class="jp-build">
                {w.pages.map((page, n) => (
                  <li style={`--o:${n}`}>
                    <span>{page[locale]}</span>
                    <i class="jp-bar"><b></b></i>
                  </li>
                ))}
              </ul>
            )}
            {i === 4 && (
              <ul class="jp-checks">
                {w.checks.map((check, n) => (
                  <li style={`--o:${n}`}>
                    <i class="ce-tool-icon">✓</i>
                    {check[locale]}
                  </li>
                ))}
              </ul>
            )}
            {i === 5 && (
              <div class="jp-save">
                <p>{w.save[locale]}</p>
                <span class="jp-pill jp-yes">{w.yes[locale]}</span>
                <span class="jp-pill is-quiet">{w.no[locale]}</span>
              </div>
            )}
          </div>
          <div class="path-label">
            <span class="path-dot" dir="ltr">{i + 1}</span>
            <strong>{stop[locale]}</strong>
            <p>{w.details[i]![locale]}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <div class="column path-after">
    <p>{w.after[locale]}</p>
    <ul>{w.asks.map((ask) => <li>{ask[locale]}</li>)}</ul>
  </div>
</section>
