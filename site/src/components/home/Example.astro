---
import type { Bilingual } from '../../content/catalogue.ts'
import { home } from '../../content/guide/home.ts'
import type { Locale } from '../../content/types.ts'
import { verdicts } from '../../lib/verdicts.ts'

interface Props {
  locale: Locale
}

interface Line {
  /** A short tag at the start of the line, if any. */
  tag?: Bilingual
  text: string
  mark?: 'ok' | 'bad' | 'ask'
}

const { locale } = Astro.props
const refused = verdicts.find(({ id }) => id === 'force')!
const { skills, rules, guard, gate, review, done } = home.steps
const say = home.session
// What the session shows at each step: real names from the kit, the real answer of its guard.
const steps: { name: Bilingual; text: Bilingual; lines: Line[] }[] = [
  {
    ...skills,
    lines: [
      { tag: say.skill, text: 'dash-create-table' },
      { tag: say.skill, text: 'dash-create-filter-bar' },
    ],
  },
  {
    ...rules,
    lines: [
      { tag: say.rule, text: 'dashboard/data-tables.md' },
      { tag: say.rule, text: 'dashboard/permissions.md' },
      { tag: say.rule, text: 'dashboard/api-layer.md' },
    ],
  },
  {
    ...guard,
    lines: [
      { text: `$ ${refused.command}` },
      { tag: say.blocked, text: refused.reason.replace(/^Blocked:\s*/i, ''), mark: 'bad' },
    ],
  },
  {
    ...gate,
    lines: [
      { tag: say.passed, text: say.typecheck[locale], mark: 'ok' },
      { tag: say.passed, text: say.tests[locale], mark: 'ok' },
    ],
  },
  { ...review, lines: [{ tag: { en: 'agent', ar: 'وكيل' }, text: `frontend-reviewer · ${say.reviewing[locale]}` }] },
  { ...done, lines: [{ text: say.ask[locale], mark: 'ask' }] },
]
---

<section id="example" class="example" data-example>
  <div class="column example-head">
    <h2 class="enter">{home.example[locale]}</h2>
    <p class="enter">{home.exampleLead[locale]}</p>
  </div>
  <div class="column example-body">
    <ol class="run">
      {
        steps.map(({ name, text }, i) => (
          <li data-step={i} aria-current={i === 0 ? 'step' : undefined}>
            <span class="run-number" dir="ltr">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{name[locale]}</h3>
            <p>{text[locale]}</p>
          </li>
        ))
      }
    </ol>
    <figure class="session" aria-label={home.example[locale]}>
      <div class="session-bar" aria-hidden="true">
        <i></i><i></i><i></i>
        <span dir="ltr">claude</span>
      </div>
      <p class="session-prompt">
        <span aria-hidden="true">&gt;</span>
        {home.prompt[locale]}
      </p>
      <ol class="session-lines">
        {
          steps.map(({ lines }, i) => (
            <li data-shows={i}>
              {lines.map(({ tag, text, mark }) => (
                <p class:list={['session-line', mark && `is-${mark}`]}>
                  {tag && <span class="session-tag">{tag[locale]}</span>}
                  <span dir="auto">{text}</span>
                </p>
              ))}
            </li>
          ))
        }
      </ol>
    </figure>
  </div>
</section>
