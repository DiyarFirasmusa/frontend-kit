---
import Board from './Board.astro'
import ChatEvent from './ChatEvent.astro'
import ChatWindow from './ChatWindow.astro'
import Mock from './Mock.astro'
import { home } from '../../content/guide/home.ts'
import { howWords as h, journeyWords as w } from '../../content/guide/showcase.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const last = w.stops.length - 1
---

<section id="example" class="example">
  <div class="column section-head">
    <h2>{home.example[locale]}</h2>
    <p>{w.lead[locale]}</p>
  </div>
  <div class="column">
    <Board locale={locale} part={1} label={locale === 'ar' ? 'كيف تعمل' : 'How it works'} tone="orange">
      <!-- Four screens side by side, one road between them, from the first message to the project you open. -->
      <ol class="path road" data-alive>
        {
          w.stops.map((stop, i) => (
            <li class:list={['path-stop', { 'is-current': i === 0, 'is-last': i === last }]} data-who={i === 2 ? 'kit' : 'you'} style={`--n:${i}`}>
              <span class="road-pin path-dot">{i + 1}</span>
              <div class="road-screen" aria-hidden="true">
                {i < last ? (
                  <ChatWindow locale={locale} label={stop[locale]}>
                    {h.chat[i]!.map((event) => <ChatEvent locale={locale} event={event} />)}
                  </ChatWindow>
                ) : (
                  <div class="browser">
                    <div class="browser-bar">
                      <span class="chat-lights"><i></i><i></i><i></i></span>
                      <span class="browser-url" dir="ltr">my-shop</span>
                    </div>
                    <div class="browser-page">
                      <Mock kind="dashboard" />
                    </div>
                    <p class="road-save"><span>{w.save[locale]}</span><b>{w.yes[locale]}</b><i>{w.no[locale]}</i></p>
                  </div>
                )}
              </div>
              <button type="button" class="path-pick">
                <strong>{stop[locale]}</strong>
                <span class="path-text">{w.details[i]![locale]}</span>
                <span class="road-move"><b>{i === 2 ? h.kit[locale] : h.move[locale]}</b>{h.youDo[i]![locale]}</span>
              </button>
            </li>
          ))
        }
      </ol>
      <div slot="note">
        <p>{w.noteLine[locale]}</p>
        <a class="hero-start" href="#install">{home.start[locale]}</a>
      </div>
    </Board>
  </div>
</section>
