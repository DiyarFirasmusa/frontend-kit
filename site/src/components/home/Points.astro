---
import { home } from '../../content/guide/home.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section class="points-band" aria-label={home.title[locale]}>
  <ul class="points glow-grid">
    {
      home.points.map(({ name, text }, i) => (
        <li class="glow-cell">
          <span class="point-number" dir="ltr">0{i + 1}</span>
          <h2>{name[locale]}</h2>
          <p>{text[locale]}</p>
        </li>
      ))
    }
  </ul>
</section>
