---
import { agents, skillGroups } from '../content/catalogue.ts'
import { PAGES, SECTIONS, type PageId } from '../content/guide/pages.ts'
import { ui } from '../content/guide/ui.ts'
import { ruleGuides } from '../content/guide/rules.ts'
import { content } from '../content/index.ts'
import type { HookEvent, Locale } from '../content/types.ts'
import Layout from '../layouts/Layout.astro'
import { viewOfRoute } from '../lib/kit-map.ts'
import { agentUrl, asset, hookUrl, pageUrl, ruleUrl, skillUrl } from '../lib/links.ts'
import { hookEvents, ruleGroups } from '../lib/plugin.ts'
import type { Route } from '../lib/routes.ts'
import DocsTree from './docs/DocsTree.astro'
import Header from './Header.astro'
import SiteFooter from './SiteFooter.astro'

interface Props {
  locale: Locale
  route: Exclude<Route, { kind: 'home' }>
}

const { locale, route } = Astro.props
const copy = content[locale]
const PARENT = { skill: 'skills', agent: 'agents', rule: 'rules', hook: 'checks' } as const
const parent: PageId = route.kind === 'page' ? route.id : PARENT[route.kind]
const info = PAGES[parent]

/** The pages of this kind, in their order: the pager walks them and the side lists them. */
interface Sibling {
  key: string
  name: string
  /** Tells two of the same name apart. */
  among?: string
  href: string
  about: string
}
let siblings: Sibling[]
switch (route.kind) {
  case 'page':
    siblings = SECTIONS.flatMap(({ pages }) => pages).map((id) => ({ key: id, name: PAGES[id].name[locale], href: pageUrl(locale, id), about: PAGES[id].lead[locale] }))
    break
  case 'skill':
    siblings = skillGroups.flatMap(({ skills }) =>
      Object.entries(skills).map(([name, what]) => ({ key: name, name, href: skillUrl(locale, name), about: what[locale] })),
    )
    break
  case 'agent':
    siblings = Object.entries(agents).map(([name, what]) => ({ key: name, name, href: agentUrl(locale, name), about: what[locale] }))
    break
  case 'rule':
    siblings = ruleGroups.flatMap(({ group, names }) =>
      names.map((name) => ({
        key: `${group}/${name}`,
        name,
        among: copy.rules.groups[group] ?? group,
        href: ruleUrl(locale, group, name),
        about: ruleGuides[`${group}/${name}`]![locale],
      })),
    )
    break
  case 'hook':
    siblings = (Object.keys(copy.session.events) as HookEvent[])
      .filter((event) => hookEvents.includes(event))
      .map((event) => ({ key: event, name: event, href: hookUrl(locale, event), about: copy.session.events[event][0] }))
}
const key = route.kind === 'page' ? route.id : route.kind === 'rule' ? `${route.group}/${route.name}` : route.kind === 'hook' ? route.event : route.name
const at = siblings.findIndex((sibling) => sibling.key === key)
const here = siblings[at]!
const before = siblings[at - 1]
const after = siblings[at + 1]
const detail = route.kind !== 'page'
const summary = here.about
const heading = detail ? here.name : info.title[locale]
const label = detail ? `${here.name}: ${info.name[locale]}${here.among ? ` (${here.among})` : ''}` : info.name[locale]
const { shape, stop } = viewOfRoute(route)
---

<Layout locale={locale} route={route} title={`${label} | frontend-kit`} description={summary ?? ''}>
  <Header locale={locale} route={route} />
  <main id="content" class="doc" tabindex="-1" data-stage-shape={shape} data-stage-stop={stop} data-stage-layout="far">
    <DocsTree locale={locale} route={route} />
    <div class="column">
      <header class="doc-head">
        <nav class="crumbs" aria-label={ui.whereYouAre[locale]}>
          {parent !== 'docs' && <a href={pageUrl(locale, 'docs')}>{PAGES.docs.name[locale]}</a>}
          {detail ? <a href={pageUrl(locale, parent)}>{info.name[locale]}</a> : <span aria-current="page">{info.name[locale]}</span>}
        </nav>
        <h1 class:list={{ 'is-name': detail }} data-rise={detail ? undefined : ''}>{detail ? <bdi>{heading}</bdi> : heading}</h1>
        <p class="doc-summary">{summary}</p>
        <img class="still" src={asset(`stills/${info.still}.jpg`)} width="1000" height="620" alt="" />
      </header>
      <article class="doc-article">
        <slot />
        <nav class="pager" aria-label={`${ui.previous[locale]} / ${ui.next[locale]}`}>
          {before && (
            <a href={before.href}>
              <span>{ui.previous[locale]}</span>
              <bdi>{before.name}</bdi>
            </a>
          )}
          {after && (
            <a class="pager-next" href={after.href}>
              <span>{ui.next[locale]}</span>
              <bdi>{after.name}</bdi>
            </a>
          )}
        </nav>
      </article>
    </div>
  </main>
  <SiteFooter locale={locale} />
</Layout>
