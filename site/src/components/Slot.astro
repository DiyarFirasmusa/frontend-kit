---
import type { FormationName } from '../scene/formations.ts'
import { poster } from '../scene/poster.ts'

interface Props {
  stage: FormationName
  /** The other formations the page can switch this slot to. */
  others?: FormationName[]
}

const { stage, others = [] } = Astro.props
---

<div class="slot" data-stage={stage} aria-hidden="true">
  {
    [stage, ...others].map((name) => {
      const { viewBox, body } = poster(name)
      return <svg class="poster" data-poster={name} viewBox={viewBox} focusable="false" set:html={body} />
    })
  }
</div>
