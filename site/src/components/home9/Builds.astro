---
import SectionMark from './SectionMark.astro'
import { home } from '../../content/home9/home.ts'
import { showcase } from '../../content/home9/showcase.ts'
import type { Locale } from '../../content/types.ts'
import Showpiece from './Showpiece.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<section id="builds" class="builds" data-kinds>
  <div class="column section-head">
    <SectionMark locale={locale} part={0} label={locale === 'ar' ? 'ماذا تبني' : 'What you can build'} />
    <h2>{home.builds.title[locale]}</h2>
    <p>{home.builds.lead[locale]}</p>
  </div>
  <div class="column show" data-alive>
    <div class="show-tabs" role="tablist" aria-label={home.builds.title[locale]}>
      {
        showcase.map(({ id, tab }, i) => (
          <button type="button" role="tab" id={`tab-${id}`} aria-controls={`kind-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-kind-tab={i}>
            {tab[locale]}
          </button>
        ))
      }
    </div>
    {
      showcase.map(({ id, title, text, url }, i) => (
        <div class="show-panel" role="tabpanel" tabindex="0" id={`kind-${id}`} aria-labelledby={`tab-${id}`} data-kind={i} data-hidden={i > 0 ? '' : undefined}>
          <div class="show-words">
            <h3>{title[locale]}</h3>
            <p>{text[locale]}</p>
          </div>
          <div class="show-picture" aria-hidden="true">
            <div class="browser">
              <div class="browser-bar">
                <span class="chat-lights"><i></i><i></i><i></i></span>
                <span class="browser-url" dir="ltr">{url}</span>
              </div>
              <div class="browser-page">
                <Showpiece locale={locale} kind={id} />
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
