---
import { visualWords as v, type ChatEvent } from '../../content/home9/chat.ts'
import type { Locale } from '../../content/types.ts'

interface Props {
  locale: Locale
  event: ChatEvent
}

const { locale, event } = Astro.props
const say = (text: string | { en: string; ar: string } | undefined) => (typeof text === 'string' ? text : text?.[locale])
---

{
  event.kind === 'user' && (
    <div class="ce ce-user" data-ev="user">
      <p class:list={{ 'is-command': event.command }} dir={event.command ? 'ltr' : 'auto'} data-say>
        {say(event.text)}
      </p>
    </div>
  )
}
{
  event.kind === 'claude' && (
    <div class="ce ce-claude" data-ev="claude">
      <i class="ce-spark" aria-hidden="true">✻</i>
      <p>{say(event.text)}</p>
    </div>
  )
}
{
  event.kind === 'tool' && (
    <div class:list={['ce ce-tool', event.mark && `is-${event.mark}`]} data-ev="tool">
      <i class="ce-tool-icon" aria-hidden="true">{event.mark === 'bad' ? '✕' : '✓'}</i>
      <p>
        {say(event.text)}
        {event.detail && <small>{say(event.detail)}</small>}
      </p>
      <i class="ce-chevron" aria-hidden="true">›</i>
    </div>
  )
}
{
  event.kind === 'ask' && (
    <div class="ce ce-ask" data-ev="ask">
      <p class="ce-question">{say(event.question)}</p>
      <ol>
        {event.options.map((option, i) => (
          <li class:list={{ 'is-pick': i === event.picked }}>
            <span class="ce-key" dir="ltr">{i + 1}</span>
            <span>{say(option)}</span>
          </li>
        ))}
      </ol>
    </div>
  )
}
{
  event.kind === 'visual' && event.show === 'plan' && (
    <div class="ce ce-visual is-plan" data-ev="visual">
      <p class="cv-head"><i aria-hidden="true">✻</i> {v.plan[locale]} <span>{v.drawn[locale]}</span></p>
      <div class="cv-map" aria-hidden="true">
        <span class="cv-node is-root" style="--d:0">{v.signIn[locale]}</span>
        <svg class="cv-links" viewBox="0 0 300 40" preserveAspectRatio="none">
          <path d="M150 0 V14 M150 14 H50 V40 M150 14 V40 M150 14 H250 V40" />
        </svg>
        <span class="cv-row">
          {v.pages.map((page, i) => <span class="cv-node" style={`--d:${i + 1}`}>{page[locale]}</span>)}
        </span>
      </div>
      <p class="cv-chips">{v.chips.map((chip, i) => <span style={`--d:${i + 4}`}>{chip[locale]}</span>)}</p>
    </div>
  )
}
{
  event.kind === 'visual' && event.show === 'todo' && (
    <div class="ce ce-visual is-todo" data-ev="visual">
      <p class="cv-head"><i aria-hidden="true">✻</i> {v.todo[locale]} <b class="cv-count" dir="ltr"></b></p>
      <ul class="cv-tasks">
        {v.tasks.map((task, i) => <li style={`--d:${i}`}><i aria-hidden="true"></i>{task[locale]}</li>)}
      </ul>
    </div>
  )
}
{
  event.kind === 'visual' && event.show === 'build' && (
    <div class="ce ce-visual is-build" data-ev="visual">
      <p class="cv-head"><i class="is-busy" aria-hidden="true">✻</i> {v.build[locale]} <b class="cv-percent" dir="ltr"></b></p>
      <span class="cv-bar" aria-hidden="true"><i></i></span>
      <ul class="cv-files" dir="ltr">
        {v.files.map((file, i) => <li style={`--d:${i}`}><i aria-hidden="true">✓</i>{file}</li>)}
      </ul>
      <p class="cv-counts">{v.counts.map((count, i) => <span style={`--d:${i + 5}`}>{count[locale]}</span>)}</p>
    </div>
  )
}
{
  event.kind === 'ready' && (
    <div class="ce ce-ready is-rich" data-ev="ready">
      <p class="cv-head"><i aria-hidden="true">✻</i> {say(event.title)} <span class="ce-open" dir="ltr">localhost:5173</span></p>
      <div class="cv-dash" aria-hidden="true">
        <div class="cv-kpis">
          {v.kpis.map(({ label, value, trend }, i) => (
            <span style={`--d:${i}`}>
              <small>{label[locale]}</small>
              <b dir="ltr">{value}</b>
              <em dir="ltr">{trend}</em>
            </span>
          ))}
        </div>
        <div class="cv-chart">
          {[42, 58, 50, 74, 66, 88, 96].map((h, i) => (
            <span style={`--h:${h}%;--d:${i}`}>
              <i></i>
              <small>{v.week[i]?.[locale]}</small>
            </span>
          ))}
        </div>
        <ul class="cv-table">
          {v.rows.map(({ who, what, state, tone }, i) => (
            <li style={`--d:${i}`}>
              <span>{who[locale]}</span>
              <span>{what[locale]}</span>
              <b class={`is-${tone}`}>{state[locale]}</b>
            </li>
          ))}
        </ul>
      </div>
      <p class="cv-report"><i aria-hidden="true">✓</i> {v.report[locale]} · <small>{say(event.text)}</small></p>
    </div>
  )
}
