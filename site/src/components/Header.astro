---
import { content } from '../content/index.ts'
import type { Locale } from '../content/types.ts'
import { localePath } from '../lib/links.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { chrome } = content[locale]
const other: Locale = locale === 'en' ? 'ar' : 'en'
const { nav } = chrome
const links = [
  ['without', nav.why],
  ['how', nav.how],
  ['website', nav.projects],
  ['skills', nav.skills],
  ['agents', nav.agents],
  ['checks', nav.checks],
  ['guards', nav.guards],
  ['details', nav.details],
] as const
---

<a class="skip" href="#details">{chrome.skip}</a>
<header class="top">
  <a class="brand" href="#intro"><bdi>frontend-kit</bdi></a>
  <nav class="top-nav" aria-label={chrome.sections}>
    {links.map(([id, label]) => <a data-nav href={`#${id}`}>{label}</a>)}
  </nav>
  <button class="motion" type="button" data-motion data-pause={chrome.pause} data-play={chrome.play} title={chrome.pause}>
    <i aria-hidden="true"></i><span class="sr-only">{chrome.pause}</span>
  </button>
  <a class="language" href={localePath(other)} lang={other} hreflang={other} data-language>{chrome.switchLanguage}</a>
  <a class="top-install" href="#install">{chrome.install}</a>
  <details class="menu" data-menu>
    <summary><span class="sr-only">{chrome.menu}</span><i aria-hidden="true"></i></summary>
    <nav aria-label={chrome.menu}>
      {links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>
  </details>
  <span class="progress" aria-hidden="true" data-progress></span>
</header>
