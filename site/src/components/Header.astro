---
import { PAGES, SECTIONS, type PageId } from '../content/guide/pages.ts'
import { t } from '../content/guide/text.ts'
import { content } from '../content/index.ts'
import type { Locale } from '../content/types.ts'
import { pageUrl, routeUrl } from '../lib/links.ts'
import { version } from '../lib/plugin.ts'
import type { Route } from '../lib/routes.ts'

interface Props {
  locale: Locale
  route: Route
}

const { locale, route } = Astro.props
const { chrome } = content[locale]
const other: Locale = locale === 'en' ? 'ar' : 'en'
const home = route.kind === 'home'
const start = home ? '' : routeUrl(locale, { kind: 'home' })
const PARENT = { home: undefined, skill: 'skills', agent: 'agents', rule: 'rules', hook: 'checks' } as const
const current: PageId | undefined = route.kind === 'page' ? route.id : PARENT[route.kind]
const places = [
  ['example', t('How it works', 'كيف تعمل')],
] as const
---

<a class="skip" href="#content">{chrome.skip}</a>
<header class="top">
  <a class="brand" href={home ? '#intro' : start}>
    <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
      <rect x="4" y="4" width="56" height="12" rx="3"></rect>
      <rect class="brand-menu" x="46" y="23" width="14" height="37" rx="3"></rect>
      <rect class="brand-block" x="4" y="23" width="35" height="17" rx="3"></rect>
      <rect x="4" y="47" width="35" height="13" rx="3"></rect>
    </svg>
    <bdi>Wajiha Kit</bdi>
    <small class="brand-version" dir="ltr">v{version}</small>
  </a>
  <nav class="top-nav" aria-label={chrome.sections}>
    {places.map(([id, name]) => <a href={`${start}#${id}`}>{name[locale]}</a>)}
    <a class="nav-docs" href={pageUrl(locale, 'docs')} aria-current={home ? undefined : 'true'}>{PAGES.docs.name[locale]}</a>
  </nav>
  <a class="top-docs" href={pageUrl(locale, 'docs')} aria-current={home ? undefined : 'true'}>{PAGES.docs.name[locale]}</a>
  <a class="language" href={routeUrl(other, route)} lang={other} hreflang={other} data-language data-astro-reload title={chrome.switchLanguage}>
    <svg class="language-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.6 2.4 4 5.6 4 9s-1.4 6.6-4 9c-2.6-2.4-4-5.6-4-9s1.4-6.6 4-9z"></path>
    </svg>
    <span class="sr-only">{chrome.switchLanguage}</span>
  </a>
  <a class="top-install" href={`${start}#install`}>{chrome.install}</a>
  <details class="menu" data-menu>
    <summary><span class="sr-only">{chrome.menu}</span><i aria-hidden="true"></i></summary>
    <nav aria-label={chrome.menu}>
      <div>
        {places.map(([id, name]) => <a href={`${start}#${id}`}>{name[locale]}</a>)}
      </div>
      {
        SECTIONS.map(({ title, pages }) => (
          <div>
            <p>{title[locale]}</p>
            {pages.map((id) => (
              <a href={pageUrl(locale, id)} aria-current={id === current ? 'true' : undefined}>
                {PAGES[id].name[locale]}
              </a>
            ))}
          </div>
        ))
      }
    </nav>
  </details>
  <span class="progress" aria-hidden="true" data-progress></span>
</header>
