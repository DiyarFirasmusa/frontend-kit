---
import { ruleGuides } from '../../content/guide/rules.ts'
import { t } from '../../content/guide/text.ts'
import { ui } from '../../content/guide/ui.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { ruleUrl } from '../../lib/links.ts'
import { ruleFiles } from '../../lib/plugin-details.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { rules } = content[locale]
const words = {
  what: t('What a rule is', 'ما هي القاعدة'),
  whatText: t(
    'A rule is a short written standard that the assistant follows, for example “every screen needs a loading state and an error state”. You do not write them. Setup puts them in your project, and the assistant reads the right one when it works on a matching file.',
    'القاعدة معيار مكتوب قصير يتبعه المساعد، مثل «لكل شاشة حالة تحميل وحالة خطأ». لا تكتبها أنت. يضعها الإعداد في مشروعك، ويقرأ المساعد القاعدة المناسبة عندما يعمل على ملف يطابقها.',
  ),
  how: t('How a rule works', 'كيف تعمل القاعدة'),
  steps: [
    t('Setup copies the rules for your project type into the folder .claude/rules/ and adapts them to the tools your project uses.', 'ينسخ الإعداد قواعد نوع مشروعك إلى مجلد ⁦.claude/rules/⁩ ويضبطها لتناسب الأدوات التي يستخدمها مشروعك.'),
    t('At the top of most files is a list of paths. The assistant reads the rule when it works on a file that matches one of them.', 'في أعلى أغلب الملفات قائمة مسارات. وعندما يعمل المساعد على ملف يطابق أحدها، يقرأ القاعدة.'),
    t('They are ordinary files in your project folder. Edit them, and your team reviews the change like any other.', 'هي ملفات عادية في مجلد مشروعك. عدّلها، وسيراجع فريقك التغيير كأي تغيير آخر.'),
  ],
  bar: t('The quality bar, the most important rule', 'معيار الجودة، وهو أهم قاعدة'),
  barItems: [
    t('Strict types: no any (a way to skip checks), no forced conversions, no ignored errors.', 'أنواع صارمة: لا any (وهي طريقة لتجاوز الفحص)، ولا تحويل بالإجبار، ولا أخطاء متجاهلة.'),
    t('Small files with honest names, and no unused code.', 'ملفات صغيرة بأسماء صادقة، وبلا كود غير مستخدم.'),
    t('Every screen has a design for loading, error, empty and success.', 'لكل شاشة تصميم لحالات التحميل والخطأ والفراغ والنجاح.'),
    t('Buttons big enough to touch (at least 44 pixels), and use by keyboard and screen readers.', 'أزرار كبيرة بما يكفي للمس (لا تقل عن 44 بكسل)، وتعمل بلوحة المفاتيح وقارئات الشاشة.'),
    t('Arabic and English, with right-to-left handled by logical CSS (styling that follows the reading direction).', 'دعم العربية والإنجليزية، مع معالجة الاتجاه من اليمين إلى اليسار بـ CSS منطقي (تنسيق يتبع اتجاه القراءة).'),
    t('Tests with every change, and no claim of a check that did not run.', 'اختبارات مع كل تغيير، ولا يقول المساعد إنه فحص شيئا لم يفحصه.'),
  ],
}
// The first few globs say enough.
// The paths in plain words: a reader sees "screen files", not a pattern like **/*.{jsx,tsx}. The exact paths are on each rule's page.
const KINDS = [
  [/^src\/|\*\*\/\*$|^\*\*$/, t('source files', 'ملفات المصدر')],
  [/\.(tsx|jsx|vue|svelte)|components|pages|routes/, t('screen files', 'ملفات الشاشات')],
  [/test|spec|e2e/, t('test files', 'ملفات الاختبار')],
  [/\.(css|scss)|styles?/, t('style files', 'ملفات التنسيق')],
  [/api|services?|auth|query|queries|hooks?/, t('data and service files', 'ملفات البيانات والخدمات')],
  [/\.(json|ya?ml)|config/, t('settings files', 'ملفات الإعدادات')],
  [/\.mdx?|docs/, t('documents', 'المستندات')],
  [/\.(ts|js|mjs)/, t('code files', 'ملفات الكود')],
] as const
const plain = (paths: string[]): string => {
  const text = paths.join(' ')
  const found = KINDS.filter(([pattern]) => pattern.test(text)).map(([, name]) => name[locale])
  return (found.length > 0 ? found.slice(0, 3) : [t('matching files', 'الملفات المطابقة')[locale]]).join(locale === 'ar' ? '، ' : ', ')
}
---

<Block id="what" title={words.what[locale]} lead={words.whatText[locale]} />
<Block id="how" title={words.how[locale]}><ol class="numbered">{words.steps.map((step) => <li>{step[locale]}</li>)}</ol></Block>
<Block id="quality-bar" title={words.bar[locale]}><ul class="ticks">{words.barItems.map((item) => <li>{item[locale]}</li>)}</ul></Block>
{
  Object.entries(ruleFiles).map(([group, files]) => (
    <Block title={rules.groups[group] ?? group}>
      <dl class="rows">
        {files.map(({ key, name, paths }) => (
          <div>
            <dt>
              <a href={ruleUrl(locale, group, name)}>
                <bdi>{name}</bdi>
              </a>
            </dt>
            <dd>
              {ruleGuides[key]?.[locale]}
              <small>
                {paths.length > 0 ? `${ui.loadsFor[locale]}: ${plain(paths)}` : ui.always[locale]}
              </small>
            </dd>
          </div>
        ))}
      </dl>
    </Block>
  ))
}
