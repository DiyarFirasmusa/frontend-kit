---
import { ruleGuides } from '../../content/guide/rules.ts'
import { t } from '../../content/guide/text.ts'
import { ui } from '../../content/guide/ui.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { ruleUrl } from '../../lib/links.ts'
import { ruleFiles } from '../../lib/plugin-details.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { rules } = content[locale]
const words = {
  how: t('How a rule works', 'شلون تشتغل القاعدة'),
  steps: [
    t('Setup copies the rules of your project type into .claude/rules/ and adapts them to your stack.', 'الإعداد ينسخ قواعد نوع مشروعك إلى‎.claude/rules/ ويكيّفها مع تقنياتك.'),
    t('At the top of most files is a list of paths. The assistant loads the rule when it works on a matching file.', 'ببداية أغلب الملفات قائمة مسارات، والمساعد يحمّل القاعدة لما يشتغل على ملف يطابقها.'),
    t('They are ordinary files in your repo. Edit them, and your team reviews the change like any other.', 'هي ملفات عادية بمستودعك. عدّلها، وفريقك يراجع التغيير مثل أي تغيير ثاني.'),
  ],
  bar: t('The quality bar, the most important one', 'معيار الجودة، وهو أهمها'),
  barItems: [
    t('Strict types: no any, no forced casts, no ignored errors.', 'أنواع صارمة: لا any، ولا تحويل بالقوة، ولا أخطاء متجاهلة.'),
    t('Small files with honest names, and no dead code.', 'ملفات صغيرة بأسماء صادقة، وبدون كود ميت.'),
    t('Loading, error, empty and success, each designed.', 'التحميل والخطأ والفراغ والنجاح، كل وحدة إلها تصميم.'),
    t('Touch targets of at least 44 pixels, keyboard and screen readers.', 'أهداف لمس 44 بكسل على الأقل، ولوحة المفاتيح وقارئات الشاشة.'),
    t('Arabic and English, with logical CSS only.', 'العربي والإنجليزي، بـ CSS منطقي بس.'),
    t('Tests with every change, and no claim of a check that did not run.', 'اختبارات مع كل تغيير، وما يدّعي فحص ما اشتغل.'),
  ],
}
// The first few globs say enough.
const PATHS_SHOWN = 3
---

<Block id="how" title={words.how[locale]}><ol class="numbered">{words.steps.map((step) => <li>{step[locale]}</li>)}</ol></Block>
<Block id="quality-bar" title={words.bar[locale]}><ul class="ticks">{words.barItems.map((item) => <li>{item[locale]}</li>)}</ul></Block>
{
  Object.entries(ruleFiles).map(([group, files]) => (
    <Block title={rules.groups[group] ?? group}>
      <dl class="rows">
        {files.map(({ key, name, paths }) => (
          <div>
            <dt>
              <a href={ruleUrl(locale, group, name)}>
                <bdi>{name}</bdi>
              </a>
            </dt>
            <dd>
              {ruleGuides[key]?.[locale]}
              <small>
                {paths.length > 0 ? `${ui.loadsFor[locale]}: ` : ui.always[locale]}
                {paths.slice(0, PATHS_SHOWN).map((path) => (
                  <code dir="ltr">{path}</code>
                ))}
              </small>
            </dd>
          </div>
        ))}
      </dl>
    </Block>
  ))
}
