---
import { beginnerQuestions, problems } from '../../content/guide/problems.ts'
import { t } from '../../content/guide/text.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { answers } = content[locale]
const trouble = t('When something does not work', 'عندما لا يعمل شيء')
const stuck = t('Still stuck? First ask Claude in the same chat: “Explain this error in plain words and fix it.” If that does not work, open a report on GitHub (a free account is needed) with the error text and what you did.', 'ما زلت عالقا؟ اطلب أولا من ⁦Claude⁩ في المحادثة نفسها: «اشرح لي هذا الخطأ بكلمات بسيطة وأصلحه». وإن لم ينجح فافتح بلاغا على ⁦GitHub⁩ (يلزمك حساب مجاني) وألصق نص الخطأ وما فعلته.')
const report = t('Report a problem', 'أبلغ عن مشكلة')
const first = t('Before you start', 'قبل أن تبدأ')
const firstLead = t('The questions most people ask first, answered plainly.', 'الأسئلة التي يسألها أغلب الناس أولا، مع إجابات واضحة.')
// The same questions, for search engines: plain text without the marks that keep Latin words in order.
const clean = (text: string) => text.replace(/[‎‏⁦-⁩]/g, '')
const faq = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...beginnerQuestions, ...answers.items.map(([q, a]) => [{ [locale]: q }, { [locale]: a }] as const), ...problems].map(([question, answer]) => ({
    '@type': 'Question',
    name: clean((question as Record<string, string>)[locale] ?? ''),
    acceptedAnswer: { '@type': 'Answer', text: clean((answer as Record<string, string>)[locale] ?? '') },
  })),
})
---

<script type="application/ld+json" set:html={faq} />
<Block id="before" title={first[locale]} lead={firstLead[locale]}>
  <div class="questions">
    {beginnerQuestions.map(([question, answer]) => <details><summary>{question[locale]}</summary><p>{answer[locale]}</p></details>)}
  </div>
</Block>
<Block id="answers" title={answers.title}>
  <div class="questions">
    {answers.items.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
  </div>
</Block>
<Block id="problems" title={trouble[locale]}>
  <div class="questions">
    {problems.map(([problem, fix]) => <details><summary>{problem[locale]}</summary><p>{fix[locale]}</p></details>)}
  </div>
  <p>{stuck[locale]}</p>
  <p class="links"><a class="source" href={`${REPO_URL}/issues`}>{report[locale]}</a></p>
</Block>
