---
import { content } from '../../content/index.ts'
import { agents, skillGroups } from '../../content/catalogue.ts'
import { PAGES } from '../../content/guide/pages.ts'
import { projects } from '../../content/guide/projects.ts'
import { skillPurpose } from '../../content/guide/purpose.ts'
import { skillGuides } from '../../content/guide/skills/index.ts'
import { ui } from '../../content/guide/ui.ts'
import type { Locale } from '../../content/types.ts'
import { agentUrl, skillUrl } from '../../lib/links.ts'
import { manualSkills, REPO_URL } from '../../lib/plugin.ts'
import { profilesOf } from '../../lib/plugin-details.ts'
import { skillReference } from '../../lib/reference.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'
import InShort from '../guide/InShort.astro'
import Prompt from '../guide/Prompt.astro'
import Source from '../guide/Source.astro'
import SourceBlock from '../guide/SourceBlock.astro'

interface Props {
  name: string
  locale: Locale
}

const { name, locale } = Astro.props
/** A skill page needs its entry in every list below; a missing one stops the build with the list it is missing from. */
function need<T>(value: T | undefined, where: string): T {
  if (value === undefined) throw new Error(`SkillPage: skill "${name}" (page /skills/${name}) is missing from ${where}.`)
  return value
}
const { matches, argument, borrowed, files, mentionedBy } = need(skillReference[name], 'skillReference (lib/reference.ts)')
const [playbook, ...others] = files
const guide = need(skillGuides[name], 'skillGuides (content/guide/skills)')
const purpose = need(skillPurpose[name], 'skillPurpose (content/guide/purpose.ts)')
const on = profilesOf(name)
const group = need(skillGroups.find(({ skills }) => name in skills), 'skillGroups (content/catalogue.ts)')
const types = on.length === projects.length ? ui.everyType[locale] : projects.filter(({ id }) => on.includes(id)).map((project) => project.name[locale]).join(locale === 'ar' ? '، ' : ', ')
const describe = (skill: string) => skillGroups.find(({ skills }) => skill in skills)?.skills[skill]?.[locale]
---

<dl class="glance">
  <div><dt>{ui.group[locale]}</dt><dd>{group.title[locale]}</dd></div>
  <div><dt>{ui.starts[locale]}</dt><dd>{(manualSkills.has(name) ? ui.manual : ui.auto)[locale]}</dd></div>
  <div><dt>{ui.worksIn[locale]}</dt><dd>{types}</dd></div>
</dl>

<InShort
  locale={locale}
  rows={[
    [ui.whatItIs[locale], guide.plain[locale]],
    [ui.why[locale], purpose.why[locale]],
    [ui.when[locale], purpose.when[locale]],
    [ui.needs[locale], guide.needs?.[locale]],
  ]}
/>

<Block id="ask" tone="act" title={ui.youType[locale]} lead={ui.anyWords[locale]}>
  {guide.ask.map((example) => <Prompt text={example[locale]} />)}
  <p class="by-name">{ui.byName[locale]}</p>
  <CommandBox command={`/wajiha-kit:${name}`} install={content[locale].install} />
</Block>

<Block id="steps" tone="get" title={ui.whatHappens[locale]}>
  <ol class="numbered">{guide.steps.map((step) => <li>{step[locale]}</li>)}</ol>
</Block>

<Block id="result" tone="get" title={ui.youGet[locale]}>
  <ul class="ticks">{guide.result.map((item) => <li>{item[locale]}</li>)}</ul>
  <h3 class="sub">{ui.wont[locale]}</h3>
  <ul class="crosses">{guide.limits.map((item) => <li>{item[locale]}</li>)}</ul>
</Block>

<Block id="related" title={ui.related[locale]}>
  <ul class="index">
    {
      guide.related.map((other) => (
        <li>
          <a href={skillUrl(locale, other)}>
            <bdi>{other}</bdi>
          </a>
          <p>{describe(other)}</p>
        </li>
      ))
    }
  </ul>
  {
    mentionedBy.length > 0 && (
      <>
        <h3 class="sub">{PAGES.agents.name[locale]}</h3>
        <ul class="index">
          {mentionedBy.map((agent) => (
            <li>
              <a href={agentUrl(locale, agent)}>
                <bdi>{agent}</bdi>
              </a>
              <p>{agents[agent]?.[locale]}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Block>

<SourceBlock locale={locale} href={`${REPO_URL}/blob/main/plugins/wajiha-kit/skills/${name}/SKILL.md`} lead={borrowed ? ui.borrowed[locale] : undefined}>
  <details class="fold">
    <summary><span>{ui.matches[locale]}</span></summary>
    <p>{ui.matchesLead[locale]}</p>
    <p class="quoted" lang="en" dir="ltr">{matches}</p>
    {argument && <p class="muted">{ui.argument[locale]} <code dir="ltr">{argument}</code></p>}
  </details>
  {
    borrowed ? (
      <dl class="rows">
        <div>
          <dt>{ui.origin[locale]}</dt>
          <dd dir="ltr">{borrowed.origin}</dd>
        </div>
        <div>
          <dt>{ui.licence[locale]}</dt>
          <dd dir="ltr">{borrowed.licence}</dd>
        </div>
      </dl>
    ) : (
      <>
        <Source file={`plugins/wajiha-kit/${playbook}`} label={ui.playbook[locale]} name="SKILL.md" />
        {others.map((file) => <Source file={`plugins/wajiha-kit/${file}`} label={ui.referenceFile[locale]} name={file.replace(`skills/${name}/`, '')} />)}
      </>
    )
  }
</SourceBlock>
