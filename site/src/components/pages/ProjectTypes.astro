---
import { projects } from '../../content/guide/projects.ts'
import { t } from '../../content/guide/text.ts'
import type { Locale } from '../../content/types.ts'
import { skillUrl } from '../../lib/links.ts'
import { skillNames } from '../../lib/plugin.ts'
import { profilesOf, ruleFiles } from '../../lib/plugin-details.ts'
import Block from '../guide/Block.astro'
import Prompt from '../guide/Prompt.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const words = {
  which: t('Pick what you want to build', 'ماذا تستطيع أن تبني؟'),
  whichLead: t('The setup asks this first. Pick the one closest to your idea.', 'يسألك الإعداد هذا أولا. اختر الأقرب إلى فكرتك.'),
  gets: t('What you get', 'ماذا تحصل عليه'),
  describe: t('How you could describe it in the setup', 'كيف تصفه في الإعداد'),
  ask: t('Later you could say', 'وبعد ذلك تستطيع أن تقول'),
  curious: t('For the curious', 'لمن يريد التفاصيل'),
  curiousText: t('You do not need to know any of this. The kit picks tools for you, and may ask which framework you want.', 'لا تحتاج أن تعرف شيئا من هذا. تختار الإضافة الأدوات عنك، وقد تسألك أي إطار تريد.'),
  stack: t('The tools it uses', 'الأدوات التي يستخدمها'),
  special: t('Skills only this type has', 'مهارات خاصة بهذا النوع'),
  neutral: t('It has no extra skills. The shared skills adapt to your project.', 'ليس له مهارات إضافية. والمهارات المشتركة تتكيف مع مشروعك.'),
  rules: t('Its rules, besides the shared ones', 'قواعده، غير القواعد المشتركة'),
}
const special = skillNames.filter((name) => profilesOf(name).length < projects.length)
// Only the kinds a new project can be today; the kit's fourth profile is for existing projects in other tools.
const kinds = projects.filter(({ id }) => id !== 'react')
---

<Block id="which" title={words.which[locale]} lead={words.whichLead[locale]}>
  <dl class="rows">
    {kinds.map(({ id, name, fits }) => <div><dt><a href={`#${id}`}>{name[locale]}</a></dt><dd>{fits[locale]}</dd></div>)}
  </dl>
</Block>
{
  kinds.map((project) => {
    const own = special.filter((name) => profilesOf(name).includes(project.id))
    const rules = new Set(project.rules.flatMap((group) => (ruleFiles[group] ?? []).map((rule) => rule.name)))
    return (
      <Block id={project.id} title={project.name[locale]} lead={project.fits[locale]}>
        <h3>{words.describe[locale]}</h3>
        <p class="big">{project.example[locale]}</p>
        <h3>{words.gets[locale]}</h3>
        <ul class="ticks">{project.gets.map((item) => <li>{item[locale]}</li>)}</ul>
        <h3>{words.ask[locale]}</h3>
        <Prompt text={project.ask[locale]} />
        <h3>{words.curious[locale]}</h3>
        <p class="muted">{words.curiousText[locale]}</p>
        <h3>{words.stack[locale]}</h3>
        <ul class="tags">{project.stack.map((item) => <li><bdi>{item}</bdi></li>)}</ul>
        <h3>{words.special[locale]}</h3>
        {own.length > 0 ? (
          <ul class="tags">{own.map((name) => <li><a href={skillUrl(locale, name)}><bdi>{name}</bdi></a></li>)}</ul>
        ) : (
          <p class="muted">{words.neutral[locale]}</p>
        )}
        <h3>{words.rules[locale]}</h3>
        <ul class="tags">{[...rules].map((name) => <li><bdi>{name}</bdi></li>)}</ul>
      </Block>
    )
  })
}
