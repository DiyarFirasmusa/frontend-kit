---
import { exampleProjects, recipes } from '../../content/guide/examples.ts'
import { t } from '../../content/guide/text.ts'
import { ui } from '../../content/guide/ui.ts'
import type { Locale } from '../../content/types.ts'
import { skillUrl } from '../../lib/links.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import Block from '../guide/Block.astro'
import Journey from '../guide/Journey.astro'
import Prompt from '../guide/Prompt.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const words = {
  full: t('A whole example, step by step', 'مثال كامل، خطوة بخطوة'),
  projects: t('Projects the kit was tried on', 'مشاريع جُربت عليها الإضافة'),
  projectsLead: t('Small projects that show what setup does with different tools. They are for the curious: you do not need them to start.', 'مشاريع صغيرة تعرض ما يفعله الإعداد مع أدوات مختلفة. وهي لمن يريد التفاصيل: لا تحتاجها لتبدأ.'),
}
---

{
  recipes.map(({ title, items }) => (
    <Block tone="act" title={title[locale]}>
      <ul class="recipes">
        {items.map(({ want, say, skills }) => (
          <li>
            <h3>{want[locale]}</h3>
            <Prompt text={say[locale]} />
            {skills.length > 0 && (
              <p>
                <span>{ui.use[locale]}</span>
                {skills.map((name) => <a href={skillUrl(locale, name)}><bdi>{name}</bdi></a>)}
              </p>
            )}
          </li>
        ))}
      </ul>
    </Block>
  ))
}
<Block id="full" title={words.full[locale]}><Journey locale={locale} /></Block>
<Block id="projects" title={words.projects[locale]} lead={words.projectsLead[locale]}>
  <dl class="rows">
    {Object.entries(exampleProjects).map(([name, text]) => (
      <div><dt><a href={`${REPO_URL}/tree/main/examples/${name}`}><bdi>{name}</bdi></a></dt><dd>{text[locale]}</dd></div>
    ))}
  </dl>
</Block>
