---
import type { PageId } from '../../content/guide/pages.ts'
import { t } from '../../content/guide/text.ts'
import { ui } from '../../content/guide/ui.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { facts } from '../../lib/plugin.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { features, box } = content[locale]
// In the order of the feature groups.
const DETAIL: (PageId | undefined)[] = ['get-started', 'rules', 'checks', 'checks', 'rules', undefined, 'project-types', 'configuration']
const tools = t('Extra tools', 'الأدوات الإضافية')
const toolsLead = t(
  'Small connections that give the assistant abilities it lacks. Their technical name is MCP servers.',
  'اتصالات صغيرة تعطي المساعد قدرات لا يملكها. واسمها التقني ⁦MCP servers⁩.',
)
const servers = [
  ['Chrome DevTools', t('Opens your page in a browser, shows its errors, takes screenshots and measures how fast it loads.', 'يفتح صفحتك في المتصفح، ويعرض أخطاءها، ويلتقط صور الشاشة، ويقيس سرعة تحميلها.')],
  ['Playwright', t('Clicks through your pages like a visitor, to check that they work.', 'ينتقل بين صفحاتك وينقر فيها كما يفعل الزائر، ليتأكد أنها تعمل.')],
  ['Context7', t('Looks up the current instructions of the libraries your project uses. A key from their website is optional.', 'يبحث عن أحدث تعليمات المكتبات التي يستخدمها مشروعك. والمفتاح من موقعهم اختياري.')],
] as const
---

<Block id="inventory" title={box.title}>
  <dl class="inventory">{box.contents(facts).map(([amount, label]) => <div><dt>{amount}</dt><dd>{label}</dd></div>)}</dl>
</Block>
{
  features.groups.map((group, i) => (
    <Block title={group.title}>
      <dl class="rows">
        {group.items.map(([name, text]) => (
          <div>
            <dt>{name}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
      {DETAIL[i] && (
        <a class="source" href={pageUrl(locale, DETAIL[i])}>
          {ui.learnMore[locale]}
        </a>
      )}
    </Block>
  ))
}
<Block id="tools" title={tools[locale]} lead={toolsLead[locale]}>
  <dl class="rows">{servers.map(([name, text]) => <div><dt><bdi>{name}</bdi></dt><dd>{text[locale]}</dd></div>)}</dl>
</Block>
