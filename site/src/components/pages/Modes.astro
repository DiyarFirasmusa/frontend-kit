---
import { modeGroups } from '../../content/guide/modes.ts'
import { t } from '../../content/guide/text.ts'
import { content } from '../../content/index.ts'
import type { Bilingual } from '../../content/catalogue.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl, skillUrl } from '../../lib/links.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'
import Source from '../guide/Source.astro'

interface Props {
  locale: Locale
}

type Mode = (typeof modeGroups)[number]['modes'][number][0]

const { locale } = Astro.props
const { install } = content[locale]
const keepsTests = t('No removed or skipped tests, and no refreshed test snapshots (saved results that tests compare with).', 'لا يحذف المساعد أي اختبار ولا يتخطاه، ولا يجدد لقطات الاختبار (النتائج المحفوظة التي تقارن بها الاختبارات).')
const also = (en: string, ar: string): Bilingual => t(`${keepsTests.en} ${en}`, `${keepsTests.ar} ${ar}`)
// What `/wajiha-kit:mode list` says is enforced.
const held: Record<Mode, Bilingual> = {
  new: t('Nothing extra.', 'لا شيء إضافي.'),
  existing: t('Nothing extra. It is the default.', 'لا شيء إضافي. هذا هو النمط الافتراضي.'),
  maintenance: also('No new libraries.', 'ولا يضيف مكتبات جديدة.'),
  refactor: also('No new comments that hide warnings.', 'ولا يضيف تعليقات جديدة تخفي التحذيرات.'),
  upgrade: also('No new comments that hide warnings, and no forced installs.', 'ولا يضيف تعليقات جديدة تخفي التحذيرات، ولا يثبّت المكتبات بالإجبار.'),
  freeze: also('No edits to package.json (the list of libraries), lock files or tool settings.', 'ولا يغير \u2066package.json\u2069 (قائمة المكتبات)، ولا ملفات القفل، ولا إعدادات الأدوات.'),
  hotfix: also('No edits to package.json (the list of libraries), lock files or tool settings, and at most five code files unless you set another number.', 'ولا يغير \u2066package.json\u2069 (قائمة المكتبات)، ولا ملفات القفل، ولا إعدادات الأدوات، ولا يلمس أكثر من خمسة ملفات كود إلا إذا حددت رقما آخر.'),
  'read-only': t('No edit outside the report folder. In the command window and in tools that connect to other services, it only reads.', 'لا يغير شيئا خارج مجلد التقارير. وفي نافذة الأوامر والأدوات التي تتصل بخدمات أخرى يقرأ فقط.'),
  prototype: t('No edit outside the prototype folder, no library changes, and no saving a version or uploading.', 'لا يغير شيئا خارج مجلد النموذج الأولي، ولا يغير المكتبات، ولا يحفظ نسخة ولا يرفع شيئا.'),
}
const why: Record<Mode, Bilingual> = {
  new: t('An empty folder has no habits yet, so the shortcuts of day one become the structure.', 'المجلد الفارغ لا عادات فيه بعد، فتصبح اختصارات اليوم الأول هي البنية.'),
  existing: t('A working project already has a shape. Forcing another shape turns each change into a rewrite.', 'المشروع الذي يعمل له شكله. وإذا فرضت عليه شكلا آخر، صار كل تغيير إعادة كتابة.'),
  maintenance: t('An old app that earns money should not be modernised by accident.', 'التطبيق القديم الذي يجلب المال يجب ألا يُحدَّث دون قصد.'),
  refactor: t('Cleaning the whole project while adding features breaks both.', 'إذا نظفت المشروع كله وأنت تضيف ميزات، يفسد الأمر كله.'),
  upgrade: t('An upgrade mixed with other work cannot be tested on its own or undone.', 'إذا اختلطت الترقية بعمل آخر، لا تستطيع اختبارها وحدها ولا التراجع عنها.'),
  freeze: t('The last days before a release are for making it stable, not bigger.', 'الأيام الأخيرة قبل الإصدار لجعله مستقرا، لا لجعله أكبر.'),
  hotfix: t('When the live site is broken, every extra line adds risk.', 'عندما يتعطل الموقع المنشور، كل سطر إضافي يزيد الخطر.'),
  'read-only': t('A review is worth more when the code cannot change while you read it.', 'قيمة المراجعة أكبر حين لا يتغير الكود أثناء قراءتك له.'),
  prototype: t('An experiment is fast only when it cannot leak into real code.', 'تكون التجربة سريعة فقط حين لا تختلط بالكود الحقيقي.'),
}
const words = {
  intro: t('You do not need this to start', 'لا تحتاج هذه الصفحة لتبدأ'),
  introText: t(
    'Modes are an advanced feature. They tell the assistant how careful and how fast to work. If you are building a new project, leave them alone: the kit picks the right one for you. Come back here later if you want to be extra careful, for example before a release or while fixing a live site.',
    'الأنماط ميزة متقدمة. تقول للمساعد كم يكون حذرا وكم يكون سريعا. إذا كنت تبني مشروعا جديدا فاتركها: الإضافة تختار لك النمط المناسب. ارجع إلى هنا لاحقا إذا أردت حذرا أكبر، مثلا قبل إصدار الموقع أو عند إصلاح موقع منشور.',
  ),
  switching: t('One switch', 'مفتاح واحد'),
  switchingLead: t(
    'Only you switch modes. A mode adds limits and never turns off a safety check.',
    'أنت وحدك تغير النمط. النمط يضيف قيودا ولا يوقف أي فحص أمان.',
  ),
  is: t('What it is', 'ما هو'),
  why: t('Why', 'لماذا'),
  held: t('What the safety checks hold', 'ماذا تفرض فحوص الأمان'),
  honest: t('What is enforced, honestly', 'ما الذي يُفرض فعلا، بصراحة'),
  honestText: t(
    'When the assistant edits a file, the safety checks see the file and the text, so those limits really hold. In the command window they catch only the common forms. Everything else is an instruction the assistant follows. It is a guard rail, not a locked room (a sandbox).',
    'عندما يعدل المساعد ملفا، ترى فحوص الأمان الملف والنص، لذلك تعمل هذه الحدود فعلا. وفي نافذة الأوامر تلتقط الصيغ الشائعة فقط. وكل شيء آخر مجرد تعليمات يتبعها المساعد. هو حاجز يحميك وليس غرفة مغلقة (sandbox).',
  ),
  skill: t('The mode skill', 'مهارة الأنماط'),
  config: t('Every key of the settings', 'كل مفاتيح الإعدادات'),
  report: t('The two report styles', 'أساليب التقرير'),
  reportLead: t(
    'A separate switch. These change how the assistant writes its report, not how it works. Their text, in English:',
    'مفتاح منفصل. يغير شكل التقرير الذي يكتبه المساعد، لا طريقة عمله. هذا نصها بالإنجليزية:',
  ),
}
const commands = ['/wajiha-kit:mode list', '/wajiha-kit:mode status', '/wajiha-kit:mode off']
---

<Block id="intro" title={words.intro[locale]} lead={words.introText[locale]} />
<Block id="switch" title={words.switching[locale]} lead={words.switchingLead[locale]}>
  <ol class="explained">{commands.map((command) => <li><CommandBox command={command} install={install} /></li>)}</ol>
</Block>
{
  modeGroups.map(({ title, lead, modes }) => (
    <Block title={title[locale]} lead={lead[locale]}>
      {modes.map(([name, text]) => (
        <div class="question">
          <h3 id={`mode-${name}`}>
            <code dir="ltr">{name}</code>
          </h3>
          <dl class="rows">
            {[
              [words.is, text],
              [words.why, why[name]],
              [words.held, held[name]],
            ].map(([label, value]) => (
              <div>
                <dt>{label![locale]}</dt>
                <dd>{value![locale]}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </Block>
  ))
}
<Block id="enforced" title={words.honest[locale]}>
  <p class="big">{words.honestText[locale]}</p>
  <p class="links">
    <a class="source" href={skillUrl(locale, 'mode')}>{words.skill[locale]}</a>
    <a class="source" href={pageUrl(locale, 'configuration')}>{words.config[locale]}</a>
  </p>
</Block>
<Block id="report" title={words.report[locale]} lead={words.reportLead[locale]}>
  <p><bdi>Frontend report</bdi></p>
  <Source file="plugins/wajiha-kit/output-styles/frontend-report.md" />
  <p><bdi>Audit report</bdi></p>
  <Source file="plugins/wajiha-kit/output-styles/audit-report.md" />
</Block>
