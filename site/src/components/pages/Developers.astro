---
import { developers as d } from '../../content/guide/developers.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import { t } from '../../content/guide/text.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { install } = content[locale]
const words = {
  readme: t('The kit’s README on GitHub', 'ملف README للإضافة على ⁦GitHub⁩'),
  modes: t('Working modes', 'أنماط العمل'),
  settings: t('The settings file', 'ملف الإعدادات'),
  changelog: t('The changelog', 'سجل التغييرات'),
  checks: t('Every safety check', 'كل فحوص الأمان'),
  examples: t('Example projects it built', 'مشاريع نموذجية بنتها'),
}
---

<Block id="who" title={d.who.title[locale]} lead={d.who.lead[locale]}>
  <ul class="plain">
    {d.who.items.map((item) => <li><strong>{item.name[locale]}.</strong> {item.text[locale]}</li>)}
  </ul>
</Block>
<Block id="tidy" title={d.tidy.title[locale]}>
  <ul class="ticks">
    {d.tidy.items.map((item) => <li>{item[locale]}</li>)}
  </ul>
  <p>{d.tidy.limits[locale]}</p>
</Block>
<Block id="existing" title={d.existing.title[locale]}>
  <p>{d.existing.text[locale]}</p>
</Block>
<Block id="install" title={d.terminal.title[locale]} lead={d.terminal.lead[locale]}>
  <ol class="explained">
    {d.terminal.commands.map((command) => <li><CommandBox command={command} install={install} /></li>)}
  </ol>
  <p>{d.terminal.needs[locale]}</p>
  <p>{d.terminal.note[locale]}</p>
</Block>
<Block id="safe" title={d.safe.title[locale]}>
  <p>{d.safe.text[locale]}</p>
  <p>{d.safe.undo[locale]}</p>
  <ol class="explained">
    {d.safe.commands.map((command) => <li><CommandBox command={command} install={install} /></li>)}
  </ol>
</Block>
<Block id="setup" title={d.setup.title[locale]} lead={d.setup.lead[locale]}>
  <ul class="plain">
    {d.setup.kinds.map((kind) => <li>{kind[locale]}</li>)}
  </ul>
  <p>{d.setup.keep[locale]}</p>
  <p>{d.setup.detects[locale]}</p>
  <dl class="rows">
    {
      d.setup.writes.map(([path, text]) => (
        <div>
          <dt><code dir="ltr">{path}</code></dt>
          <dd>{text[locale]}</dd>
        </div>
      ))
    }
  </dl>
  <p>{d.setup.approval[locale]}</p>
  <p>{d.setup.own[locale]}</p>
</Block>
<Block id="backend" title={d.backend.title[locale]}>
  <p>{d.backend.text[locale]}</p>
  <p>{d.backend.auth[locale]}</p>
</Block>
<Block id="checks" title={d.checks.title[locale]} lead={d.checks.lead[locale]}>
  <ul class="ticks">
    {d.checks.items.map((item) => <li>{item[locale]}</li>)}
  </ul>
  <p>{d.checks.limits[locale]}</p>
  <p class="links"><a class="source" href={pageUrl(locale, 'checks')}>{words.checks[locale]}</a></p>
</Block>
<Block id="more" title={d.more.title[locale]}>
  <p>{d.more.text[locale]}</p>
  <p class="links">
    <a class="source" href={pageUrl(locale, 'modes')}>{words.modes[locale]}</a>
    <a class="source" href={pageUrl(locale, 'configuration')}>{words.settings[locale]}</a>
    <a class="source" href={pageUrl(locale, 'changelog')}>{words.changelog[locale]}</a>
    <a class="source" href={`${REPO_URL}/blob/main/plugins/wajiha-kit/README.md`}>{words.readme[locale]}</a>
    <a class="source" href={`${REPO_URL}/tree/main/examples`}>{words.examples[locale]}</a>
  </p>
</Block>
