---
import { developers as d } from '../../content/guide/developers.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { ruleUrl } from '../../lib/links.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import { t } from '../../content/guide/text.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { install } = content[locale]
const words = {
  readme: t('The kit’s README on GitHub', 'ملف README للإضافة على ⁦GitHub⁩'),
  modes: t('Working modes', 'أنماط العمل'),
  settings: t('The settings file', 'ملف الإعدادات'),
  changelog: t('The changelog', 'سجل التغييرات'),
  checks: t('Every safety check', 'كل فحوص الأمان'),
  examples: t('Example projects it built', 'مشاريع نموذجية بنتها'),
  jump: t('All the install steps', 'كل خطوات التثبيت'),
}
const esc = (x: string): string => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
// A long paragraph is read as short ones: one to two sentences each.
const parts = (x: string): string[] => {
  const sentences = x.split(/(?<=[.؟!])\s+/)
  const out: string[] = []
  for (let i = 0; i < sentences.length; i += 2) out.push(sentences.slice(i, i + 2).join(' '))
  return out
}
const f = (x: string): string => esc(x).replace(/`([^`]+)`/g, '<code>$1</code>')
---

<div class="dev-quick">
  <CommandBox command="/plugin marketplace add DiyarFirasmusa/wajiha-kit" install={install} />
  <a href="#install">{words.jump[locale]}</a>
</div>
<Block id="who" title={d.who.title[locale]} lead={d.who.lead[locale]}>
  <ul class="plain">
    {d.who.items.map((item) => <li><strong><Fragment set:html={f(item.name[locale])} />.</strong> <Fragment set:html={f(item.text[locale])} /></li>)}
  </ul>
</Block>
<Block id="tidy" title={d.tidy.title[locale]}>
  <ul class="ticks">
    {d.tidy.items.map((item) => <li><Fragment set:html={f(item[locale])} /></li>)}
  </ul>
  <p><Fragment set:html={f(d.tidy.limits[locale])} /></p>
  <p class="links">
    <span><Fragment set:html={f(d.tidy.see[locale])} /></span>
    <a class="source" href={ruleUrl(locale, 'shared', 'naming.md')}>naming.md</a>
    <a class="source" href={ruleUrl(locale, 'shared', 'quality-bar.md')}>quality-bar.md</a>
  </p>
</Block>
<Block id="existing" title={d.existing.title[locale]}>
  <p><Fragment set:html={f(d.existing.text[locale])} /></p>
  <p><Fragment set:html={f(d.existing.messy[locale])} /> <a href={pageUrl(locale, 'refactor')}><Fragment set:html={f(d.existing.messyLink[locale])} /></a></p>
</Block>
<Block id="install" title={d.terminal.title[locale]} lead={d.terminal.lead[locale]}>
  <ol class="explained">
    {d.terminal.commands.map((command) => <li><CommandBox command={command} install={install} /></li>)}
  </ol>
  <p><Fragment set:html={f(d.terminal.needs[locale])} /></p>
  <p><Fragment set:html={f(d.terminal.note[locale])} /></p>
</Block>
<Block id="safe" title={d.safe.title[locale]}>
  {parts(d.safe.text[locale]).map((x) => <p><Fragment set:html={f(x)} /></p>)}
  {parts(d.safe.undo[locale]).map((x) => <p><Fragment set:html={f(x)} /></p>)}
  <ol class="explained">
    {d.safe.commands.map((command) => <li><CommandBox command={command} install={install} /></li>)}
  </ol>
</Block>
<Block id="setup" title={d.setup.title[locale]} lead={d.setup.lead[locale]}>
  <ul class="plain">
    {d.setup.kinds.map((kind) => <li><Fragment set:html={f(kind[locale])} /></li>)}
  </ul>
  <p><Fragment set:html={f(d.setup.scope[locale])} /></p>
  <p><Fragment set:html={f(d.setup.keep[locale])} /></p>
  <p><Fragment set:html={f(d.setup.detects[locale])} /></p>
  <dl class="rows">
    {
      d.setup.writes.map(([path, text]) => (
        <div>
          <dt><code dir="ltr">{path}</code></dt>
          <dd><Fragment set:html={f(text[locale])} /></dd>
        </div>
      ))
    }
  </dl>
  {parts(d.setup.approval[locale]).map((x) => <p><Fragment set:html={f(x)} /></p>)}
  <p><Fragment set:html={f(d.setup.own[locale])} /></p>
</Block>
<Block id="backend" title={d.backend.title[locale]}>
  <p><Fragment set:html={f(d.backend.text[locale])} /></p>
  <p><Fragment set:html={f(d.backend.auth[locale])} /></p>
</Block>
<Block id="checks" title={d.checks.title[locale]} lead={d.checks.lead[locale]}>
  <ul class="ticks">
    {d.checks.items.map((item) => <li><Fragment set:html={f(item[locale])} /></li>)}
  </ul>
  <p><Fragment set:html={f(d.checks.limits[locale])} /></p>
  <p class="links"><a class="source" href={pageUrl(locale, 'checks')}>{words.checks[locale]}</a></p>
</Block>
<Block id="more" title={d.more.title[locale]}>
  {parts(d.more.text[locale]).map((x) => <p><Fragment set:html={f(x)} /></p>)}
  <p class="links">
    <a class="source" href={pageUrl(locale, 'modes')}>{words.modes[locale]}</a>
    <a class="source" href={pageUrl(locale, 'configuration')}>{words.settings[locale]}</a>
    <a class="source" href={pageUrl(locale, 'changelog')}>{words.changelog[locale]}</a>
    <a class="source" href={`${REPO_URL}/blob/main/plugins/wajiha-kit/README.md`}>{words.readme[locale]}</a>
    <a class="source" href={`${REPO_URL}/tree/main/examples`}>{words.examples[locale]}</a>
  </p>
</Block>
