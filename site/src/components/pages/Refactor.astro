---
import { t } from '../../content/guide/text.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { skillUrl } from '../../lib/links.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { refactor, install } = content[locale]
const words = {
  how: t('The four commands', 'الأوامر الأربعة'),
  measured: t('What the audit measures', 'ماذا يقيس التدقيق'),
  measures: [
    t('The safety net: do typecheck, lint and tests pass today?', 'شبكة الأمان: هل تنجح الفحوص اليوم؟'),
    t('Structure: folders, huge files, circular imports, dead code.', 'البنية: المجلدات والملفات الضخمة والاستيراد الدائري والشيفرة الميتة.'),
    t('Types: any, ignored errors, untyped API data.', 'الأنواع: any والأخطاء المتجاهلة وبيانات الـ API بلا أنواع.'),
    t('Data: fetching in components and missing states.', 'البيانات: الجلب داخل المكوّنات والحالات الناقصة.'),
    t('Interface: duplicates, untranslated text, RTL and labels.', 'الواجهة: التكرار والنص غير المترجم والاتجاه والتسميات.'),
    t('Quality: coverage, skipped tests and secrets in the repo.', 'الجودة: التغطية والاختبارات المتخطاة والأسرار في المستودع.'),
  ],
  phases: t('The six phases', 'المراحل الست'),
  phaseList: [
    t('Green baseline: make the checks pass.', 'أساس ناجح: اجعل الفحوص تنجح.'),
    t('Mechanical: format, lint, renames and dead code.', 'آلية: تنسيق وتدقيق وتسمية وشيفرة ميتة.'),
    t('Types: strict and no any.', 'الأنواع: صارمة وبلا any.'),
    t('Structure: the layout you picked, by default your own, and smaller files.', 'البنية: الترتيب الذي اخترته، وافتراضياً ترتيبك، وملفات أصغر.'),
    t('Patterns: one way for data, forms and state.', 'الأنماط: طريقة واحدة للبيانات والنماذج والحالة.'),
    t('Quality: tests, accessibility, translations and speed.', 'الجودة: اختبارات ووصول وترجمة وسرعة.'),
  ],
  example: t('See a real audit', 'شاهد تدقيقاً حقيقياً'),
  skill: t('The skill behind it', 'المهارة التي خلفه'),
}
---

<Block id="commands" title={words.how[locale]}>
  <ol class="explained">
    {refactor.steps.map(([command, text]) => <li><CommandBox command={command} install={install} /><p>{text}</p></li>)}
  </ol>
</Block>
<Block id="audit" title={words.measured[locale]}><ul class="ticks">{words.measures.map((item) => <li>{item[locale]}</li>)}</ul></Block>
<Block id="phases" title={words.phases[locale]} lead={refactor.note}>
  <ol class="numbered">{words.phaseList.map((phase) => <li>{phase[locale]}</li>)}</ol>
  <p class="links">
    <a class="source" href={`${REPO_URL}/tree/main/examples/refactor-legacy`}>{words.example[locale]}</a>
    <a class="source" href={skillUrl(locale, 'refactor-mode')}>{words.skill[locale]}</a>
  </p>
</Block>
