---
import { rescue } from '../../content/guide/refactor.ts'
import { t } from '../../content/guide/text.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { skillUrl } from '../../lib/links.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { refactor, install } = content[locale]
const words = {
  intro: t('You do not need this to start', 'لا تحتاج هذه الصفحة لتبدأ'),
  introText: t(
    'This is for a project that already exists and has become messy or fragile, for example an old project that someone else built. If you are building a new project, you can skip it. “Fix an old project” first looks at the project and writes a plan. Then it cleans up one step at a time, and you approve each step before it starts.',
    'هذه الصفحة لمشروع موجود بالفعل وصار فوضويا أو هشا، مثل مشروع قديم بناه شخص آخر. إذا كنت تبني مشروعا جديدا فتجاوزها. «إصلاح مشروع قديم» ينظر أولا في المشروع ويكتب خطة. ثم ينظفه خطوة خطوة، وتوافق أنت على كل خطوة قبل أن تبدأ.',
  ),
  how: t('The four commands', 'الأوامر الأربعة'),
  measured: t('What the first look checks', 'ماذا يفحص النظر الأول'),
  ...rescue,
  phases: t('The six steps', 'الخطوات الست'),
  example: t('See a real example', 'شاهد مثالا حقيقيا'),
  skill: t('The skill behind it', 'المهارة التي يستخدمها'),
}
---

<Block id="intro" title={words.intro[locale]} lead={words.introText[locale]} />
<Block id="commands" title={words.how[locale]}>
  <ol class="explained">
    {refactor.steps.map(([command, text]) => <li><CommandBox command={command} install={install} /><p>{text}</p></li>)}
  </ol>
</Block>
<Block id="audit" title={words.measured[locale]}><ul class="ticks">{words.measures.map((item) => <li>{item[locale]}</li>)}</ul></Block>
<Block id="phases" title={words.phases[locale]} lead={refactor.note}>
  <ol class="numbered">{words.phaseList.map((phase) => <li>{phase[locale]}</li>)}</ol>
  <p class="links">
    <a class="source" href={`${REPO_URL}/tree/main/examples/refactor-legacy`}>{words.example[locale]}</a>
    <a class="source" href={skillUrl(locale, 'refactor-mode')}>{words.skill[locale]}</a>
  </p>
</Block>
