---
import { rescue } from '../../content/guide/refactor.ts'
import { t } from '../../content/guide/text.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { skillUrl } from '../../lib/links.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { refactor, install } = content[locale]
const words = {
  how: t('The four commands', 'الأوامر الأربعة'),
  measured: t('What the audit measures', 'ماذا يقيس التدقيق'),
  ...rescue,
  phases: t('The six phases', 'المراحل الست'),
  example: t('See a real audit', 'شاهد تدقيقاً حقيقياً'),
  skill: t('The skill behind it', 'المهارة التي خلفه'),
}
---

<Block id="commands" title={words.how[locale]}>
  <ol class="explained">
    {refactor.steps.map(([command, text]) => <li><CommandBox command={command} install={install} /><p>{text}</p></li>)}
  </ol>
</Block>
<Block id="audit" title={words.measured[locale]}><ul class="ticks">{words.measures.map((item) => <li>{item[locale]}</li>)}</ul></Block>
<Block id="phases" title={words.phases[locale]} lead={refactor.note}>
  <ol class="numbered">{words.phaseList.map((phase) => <li>{phase[locale]}</li>)}</ol>
  <p class="links">
    <a class="source" href={`${REPO_URL}/tree/main/examples/refactor-legacy`}>{words.example[locale]}</a>
    <a class="source" href={skillUrl(locale, 'refactor-mode')}>{words.skill[locale]}</a>
  </p>
</Block>
