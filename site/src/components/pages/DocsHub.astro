---
import { PAGES } from '../../content/guide/pages.ts'
import { t } from '../../content/guide/text.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import { facts } from '../../lib/plugin.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// The landing cards: the pages to start with, then the four parts of the kit with their counts.
const startCards = (['guide', 'get-started', 'project-types', 'examples', 'questions'] as const).map((id) => ({
  id,
  name: PAGES[id].name[locale],
  about: PAGES[id].lead[locale],
  href: pageUrl(locale, id),
}))
// In the order of the mark's blocks: top bar, orange block, column, bottom bar. The column, as tall as two blocks,
// lists a few specialists by name, so it is never an empty slab.
const kindCards = [
  { kind: 'rule', id: 'rules', count: facts.rules },
  { kind: 'skill', id: 'skills', count: facts.skills },
  { kind: 'agent', id: 'agents', count: facts.agents },
  { kind: 'hook', id: 'checks', count: facts.events },
].map(({ kind, id, count }) => ({ kind, count, name: PAGES[id as 'skills'].name[locale], about: PAGES[id as 'skills'].lead[locale], href: pageUrl(locale, id as 'skills') }))
const markBlocks = [
  { x: 5, y: 5, w: 54, h: 12 },
  { x: 5, y: 21, w: 36, h: 20 },
  { x: 45, y: 21, w: 14, h: 38 },
  { x: 5, y: 45, w: 36, h: 14 },
]
const glossary = {
  title: t('Words used in this guide', 'كلمات تُستعمل في هذا الدليل'),
  items: [
    [t('Kit', 'الإضافة'), t('Wajiha Kit itself: what you install.', '«واجهة» نفسها: ما تثبّته.')],
    [t('Claude', 'Claude'), t('The AI assistant you talk to, made by Anthropic.', 'المساعد الذكي الذي تحادثه، من شركة Anthropic.')],
    [t('Specialist', 'المختص'), t('A helper with one job, like a reviewer or a tester. Claude Code calls it an agent.', 'مساعد له مهمة واحدة، مثل المراجِع أو المختبِر. وتسميه Claude Code «وكيلا» (agent).')],
    [t('Skill', 'المهارة'), t('Ready instructions for one job, like building a table.', 'تعليمات جاهزة لمهمة واحدة، مثل بناء جدول.')],
    [t('Rule', 'القاعدة'), t('A written standard the assistant follows while it works.', 'معيار مكتوب يتبعه المساعد أثناء العمل.')],
    [t('Mode', 'النمط'), t('How careful the assistant is: building new, fixing fast, or only reading.', 'درجة حذر المساعد: بناء جديد، أو إصلاح سريع، أو قراءة فقط.')],
    [t('Backend', 'الخادم الخلفي'), t('The service that stores your data and does the work behind your pages.', 'الخدمة التي تخزّن بياناتك وتنفذ العمل خلف صفحاتك.')],
    [t('Command window', 'نافذة الأوامر'), t('The text window where you type commands: Terminal on a Mac, PowerShell on Windows.', 'نافذة تكتب فيها الأوامر: ⁦Terminal⁩ على ماك، و⁦PowerShell⁩ على ويندوز.')],
    [t('Safety check', 'فحص الأمان'), t('A small script that runs by itself and can stop a risky command. Claude Code calls it a hook.', 'سكربت صغير يعمل وحده ويستطيع إيقاف أمر خطر. وتسميه Claude Code «خطّافا» (hook).')],
  ] as const,
}
const hubWords = {
  start: t('Start here', 'ابدأ من هنا'),
  behind: t('Behind the scenes', 'في الخلفية'),
  behindLead: t('You do not need these to start. They show what works for you.', 'لا تحتاجها لتبدأ. تشرح ما يعمل لأجلك.'),
  more: t('More pages', 'صفحات أخرى'),
}
// The pages that are not on a card. Every single skill, specialist, rule and check is one click away in the page list
// and its search, so they are not listed here a second time.
const morePages = (['features', 'modes', 'configuration', 'refactor', 'changelog'] as const).map((id) => ({
  name: PAGES[id].name[locale],
  about: PAGES[id].lead[locale],
  href: pageUrl(locale, id),
}))
---

<Block id="start" tone="act" title={hubWords.start[locale]}>
  <ol class="hub-path">
    {
      startCards.map(({ name, about, href }) => (
        <li>
          <a href={href}>{name}</a>
          <p>{about}</p>
        </li>
      ))
    }
  </ol>
</Block>
<Block id="kinds" title={hubWords.behind[locale]} lead={hubWords.behindLead[locale]}>
  <!-- The four kinds are laid out as the mark: rules the top bar, skills the orange block, specialists the column, checks the bottom bar. -->
  <ul class="hub-kinds">
    {
      kindCards.map(({ kind, count, name, about, href }, lit) => (
        <li data-kind={kind}>
          <a href={href}>
            <span class="hub-kind-top">
              <svg class="doc-mark" viewBox="0 0 64 64" width="24" height="24" aria-hidden="true">
                {markBlocks.map((b, i) => (
                  <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" class:list={[`b${i}`, { dim: i !== lit }]} />
                ))}
              </svg>
              <b dir="ltr">{count}</b>
            </span>
            <strong>{name}</strong>
            <span class="hub-kind-about">{about}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Block>
<Block id="more" title={hubWords.more[locale]}>
  <ul class="index">
    {
      morePages.map(({ name, about, href }) => (
        <li>
          <a href={href}>{name}</a>
          <p>{about}</p>
        </li>
      ))
    }
  </ul>
</Block>
<Block id="words" title={glossary.title[locale]}>
  <dl class="about">
    {glossary.items.map(([name, text]) => <div><dt>{name[locale]}</dt><dd>{text[locale]}</dd></div>)}
  </dl>
</Block>
