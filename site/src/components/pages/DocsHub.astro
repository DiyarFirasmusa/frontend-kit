---
import { agents, skillGroups, type Bilingual } from '../../content/catalogue.ts'
import { PAGES, SECTIONS } from '../../content/guide/pages.ts'
import { agentPurpose, hookPurpose, rulePurpose, skillPurpose } from '../../content/guide/purpose.ts'
import { t } from '../../content/guide/text.ts'
import { content } from '../../content/index.ts'
import type { HookEvent, Locale } from '../../content/types.ts'
import { agentUrl, hookUrl, pageUrl, ruleUrl, skillUrl } from '../../lib/links.ts'
import { hookEvents, ruleGroups } from '../../lib/plugin.ts'

interface Props {
  locale: Locale
}

interface Entry {
  name: string
  href: string
  about: Bilingual
  /** A name that never translates. */
  fixed?: boolean
}

const { locale } = Astro.props
const copy = content[locale]
const words = {
  guides: t('Guides', 'الأدلة'),
  skills: t('Skills', 'المهارات'),
  agents: t('Agents', 'الوكلاء'),
  rules: t('Rules', 'القواعد'),
  hooks: t('Hooks', 'الحراس (Hooks)'),
  search: t('Search everything: table, RTL, push…', 'ابحث في كل شيء: جدول، RTL، رفع…'),
  none: t('Nothing matches. Try another word.', 'لا توجد نتائج. جرّب كلمة أخرى.'),
}
const groups: { id: string; title: string; entries: Entry[] }[] = [
  {
    id: 'guides',
    title: words.guides[locale],
    entries: SECTIONS.flatMap(({ pages }) => pages)
      .filter((id) => id !== 'docs')
      .map((id) => ({ name: PAGES[id].name[locale], href: pageUrl(locale, id), about: PAGES[id].lead })),
  },
  ...skillGroups.map(({ title, skills }, i) => ({
    id: i === 0 ? 'all-skills' : `skills-${i}`,
    title: `${words.skills[locale]}: ${title[locale]}`,
    entries: Object.keys(skills).map((name) => ({ name, href: skillUrl(locale, name), about: skillPurpose[name]!.why, fixed: true })),
  })),
  {
    id: 'all-agents',
    title: words.agents[locale],
    entries: Object.keys(agents).map((name) => ({ name, href: agentUrl(locale, name), about: agentPurpose[name]!.why, fixed: true })),
  },
  ...ruleGroups.map(({ group, names }) => ({
    id: `rules-${group.replaceAll('/', '-')}`,
    title: `${words.rules[locale]}: ${copy.rules.groups[group]}`,
    entries: names.map((name) => ({ name, href: ruleUrl(locale, group, name), about: rulePurpose[`${group}/${name}`]!, fixed: true })),
  })),
  {
    id: 'all-hooks',
    title: words.hooks[locale],
    entries: (Object.keys(copy.session.events) as HookEvent[])
      .filter((event) => hookEvents.includes(event))
      .map((event) => ({ name: event, href: hookUrl(locale, event), about: hookPurpose[event], fixed: true })),
  },
]
---

<div class="finder" data-finder>
  <label>
    <span class="sr-only">{words.search[locale]}</span>
    <input type="search" placeholder={words.search[locale]} autocomplete="off" data-finder-input />
  </label>
  <p role="status" class="muted" data-finder-empty hidden>{words.none[locale]}</p>
</div>
{
  groups.map(({ id, title, entries }) => (
    <section id={id} class="block" data-finder-group>
      <h2>{title}</h2>
      <ul class="index">
        {entries.map(({ name, href, about, fixed }) => (
          <li data-finder-item data-search={[name, title, about.en, about.ar].join(' ').toLowerCase()}>
            <a href={href} class:list={{ 'is-name': fixed }}>
              {fixed ? <bdi>{name}</bdi> : name}
            </a>
            <p>{about[locale]}</p>
          </li>
        ))}
      </ul>
    </section>
  ))
}
