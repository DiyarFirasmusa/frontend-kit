---
import { skillGroups } from '../../content/catalogue.ts'
import { skillGuides } from '../../content/guide/skills/index.ts'
import { skillUse, ui } from '../../content/guide/ui.ts'
import type { Locale } from '../../content/types.ts'
import { skillUrl } from '../../lib/links.ts'
import Block from '../guide/Block.astro'
import Prompt from '../guide/Prompt.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const sample = skillGuides['create-form']!
---

<Block id="how" tone="act" title={skillUse.title[locale]}>
  <ol class="ways">
    {skillUse.ways.map(({ name, text, example }) => (
      <li>
        <h3>{name[locale]}</h3>
        <p>{text[locale]}</p>
        <Prompt text={example[locale]} />
      </li>
    ))}
  </ol>
</Block>

<Block id="example" title={skillUse.anatomyTitle[locale]} lead={skillUse.anatomy[locale]}>
  <div class="anatomy">
    <div><h3>{ui.youType[locale]}</h3><Prompt text={sample.ask[0]![locale]} /></div>
    <div><h3>{ui.whatHappens[locale]}</h3><ol class="numbered">{sample.steps.map((step) => <li>{step[locale]}</li>)}</ol></div>
    <div><h3>{ui.youGet[locale]}</h3><ul class="ticks">{sample.result.map((item) => <li>{item[locale]}</li>)}</ul></div>
  </div>
</Block>

<div class="finder" id="all" data-finder>
  <label>
    <span class="sr-only">{ui.search[locale]}</span>
    <input type="search" placeholder={ui.search[locale]} autocomplete="off" data-finder-input />
  </label>
  <p role="status" class="muted" data-finder-empty hidden>{ui.noMatch[locale]}</p>
</div>

{
  skillGroups.map(({ title, skills }) => (
    <section class="block" id={`group-${title.en.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} data-finder-group>
      <h2>{title[locale]}</h2>
      <ul class="cards">
        {Object.entries(skills).map(([name, what]) => {
          const guide = skillGuides[name]!
          const search = [name, title.en, title.ar, what.en, what.ar, ...guide.ask.flatMap((ask) => [ask.en, ask.ar])].join(' ').toLowerCase()
          return (
            <li data-finder-item data-search={search}>
              <a class="card" href={skillUrl(locale, name)}>
                <strong><bdi>{name}</bdi></strong>
                <span>{what[locale]}</span>
                <span class="card-say">
                  <em>{ui.say[locale]}</em>
                  <q dir="auto">{guide.ask[0]![locale]}</q>
                </span>
              </a>
            </li>
          )
        })}
      </ul>
    </section>
  ))
}
