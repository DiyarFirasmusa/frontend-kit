---
import { agentGuides } from '../../content/guide/agents.ts'
import { agentPurpose } from '../../content/guide/purpose.ts'
import { t } from '../../content/guide/text.ts'
import { ui } from '../../content/guide/ui.ts'
import type { Locale } from '../../content/types.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import { skillUrl } from '../../lib/links.ts'
import { agentReference } from '../../lib/reference.ts'
import { agentFacts } from '../../lib/plugin-details.ts'
import Block from '../guide/Block.astro'
import Prompt from '../guide/Prompt.astro'
import Source from '../guide/Source.astro'
import WhyWhen from '../guide/WhyWhen.astro'

interface Props {
  name: string
  locale: Locale
}

const { name, locale } = Astro.props
const guide = agentGuides[name]!
const technical = t('Technical details', 'تفاصيل تقنية')
const { model, edits } = agentFacts[name]!
const { matches, effort, tools, skills } = agentReference[name]!
---

<dl class="glance">
  <div><dt>{ui.model[locale]}</dt><dd><bdi>{model}</bdi></dd></div>
  <div><dt>{ui.canEdit[locale]}</dt><dd>{(edits ? ui.editsYes : ui.editsNo)[locale]}</dd></div>
  <div><dt>{ui.effort[locale]}</dt><dd><bdi>{effort}</bdi></dd></div>
</dl>
<WhyWhen purpose={agentPurpose[name]!} locale={locale} masculine />

<Block id="ask" title={ui.youType[locale]} lead={ui.anyWords[locale]}><Prompt text={guide.ask[locale]} /></Block>
<Block id="does" title={ui.whatItChecks[locale]}><ol class="numbered">{guide.checks.map((check) => <li>{check[locale]}</li>)}</ol></Block>
<Block id="returns" title={ui.reports[locale]}>
  <p class="big">{guide.returns[locale]}</p>
  <a class="source" href={`${REPO_URL}/blob/main/plugins/wajiha-kit/agents/${name}.md`}>{ui.source[locale]}</a>
</Block>
<Block id="technical" title={technical[locale]}>
  <div class="questions">
    <details>
      <summary>{ui.matches[locale]}</summary>
      <p>{ui.matchesHe[locale]}</p>
      <p class="quoted" lang="en" dir="ltr">{matches}</p>
    </details>
    <details>
      <summary>{ui.tools[locale]}</summary>
      <p>{ui.toolsLead[locale]}</p>
      <ul class="tags">{tools.map((tool) => <li><code class="breaks" dir="ltr">{tool}</code></li>)}</ul>
    </details>
  </div>
</Block>
{
  skills.length > 0 && (
    <Block id="skills-used" title={ui.skillsRead[locale]}>
      <ul class="tags">
        {skills.map((skill) => (
          <li>
            <a href={skillUrl(locale, skill)}>
              <bdi>{skill}</bdi>
            </a>
          </li>
        ))}
      </ul>
    </Block>
  )
}
<Block id="instructions" title={ui.instructions[locale]} lead={ui.fullText[locale]}><Source file={`plugins/wajiha-kit/agents/${name}.md`} /></Block>
