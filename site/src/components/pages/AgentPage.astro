---
import { skillGroups } from '../../content/catalogue.ts'
import { agentGuides } from '../../content/guide/agents.ts'
import { agentPurpose } from '../../content/guide/purpose.ts'
import { ui } from '../../content/guide/ui.ts'
import type { Locale } from '../../content/types.ts'
import { REPO_URL } from '../../lib/plugin.ts'
import { skillUrl } from '../../lib/links.ts'
import { agentReference } from '../../lib/reference.ts'
import { agentFacts } from '../../lib/plugin-details.ts'
import Block from '../guide/Block.astro'
import InShort from '../guide/InShort.astro'
import Prompt from '../guide/Prompt.astro'
import Source from '../guide/Source.astro'
import SourceBlock from '../guide/SourceBlock.astro'

interface Props {
  name: string
  locale: Locale
}

const { name, locale } = Astro.props
/** An agent page needs its entry in every list below; a missing one stops the build with the list it is missing from. */
function need<T>(value: T | undefined, where: string): T {
  if (value === undefined) throw new Error(`AgentPage: agent "${name}" (page /agents/${name}) is missing from ${where}.`)
  return value
}
const guide = need(agentGuides[name], 'agentGuides (content/guide/agents.ts)')
const purpose = need(agentPurpose[name], 'agentPurpose (content/guide/purpose.ts)')
const { model, edits } = need(agentFacts[name], 'agentFacts (lib/plugin-details.ts)')
const { matches, effort, tools, skills } = need(agentReference[name], 'agentReference (lib/reference.ts)')
const describe = (skill: string) => skillGroups.find(({ skills: all }) => skill in all)?.skills[skill]?.[locale]
---

<dl class="glance">
  <div><dt>{ui.model[locale]}</dt><dd><bdi>{model}</bdi></dd></div>
  <div><dt>{ui.canEdit[locale]}</dt><dd>{(edits ? ui.editsYes : ui.editsNo)[locale]}</dd></div>
  <div><dt>{ui.effort[locale]}</dt><dd><bdi>{effort}</bdi></dd></div>
</dl>

<InShort
  locale={locale}
  rows={[
    [ui.agentIs[locale], guide.plain[locale]],
    [ui.whyHe[locale], purpose.why[locale]],
    [ui.whenHe[locale], purpose.when[locale]],
  ]}
/>

<Block id="ask" tone="act" title={ui.youType[locale]} lead={ui.anyWords[locale]}><Prompt text={guide.ask[locale]} /></Block>

<Block id="does" tone="get" title={ui.whatItChecks[locale]}>
  <ol class="numbered">{guide.checks.map((check) => <li>{check[locale]}</li>)}</ol>
  <h3 class="sub">{ui.reports[locale]}</h3>
  <p>{guide.returns[locale]}</p>
</Block>

{
  skills.length > 0 && (
    <Block id="skills-used" title={ui.skillsRead[locale]}>
      <ul class="index">
        {skills.map((skill) => (
          <li>
            <a href={skillUrl(locale, skill)}>
              <bdi>{skill}</bdi>
            </a>
            <p>{describe(skill)}</p>
          </li>
        ))}
      </ul>
    </Block>
  )
}

<SourceBlock locale={locale} href={`${REPO_URL}/blob/main/plugins/wajiha-kit/agents/${name}.md`}>
  <details class="fold">
    <summary><span>{ui.matches[locale]}</span></summary>
    <p>{ui.matchesHe[locale]}</p>
    <p class="quoted" lang="en" dir="ltr">{matches}</p>
  </details>
  <details class="fold">
    <summary><span>{ui.tools[locale]}</span></summary>
    <p>{ui.toolsLead[locale]}</p>
    <ul class="tags">{tools.map((tool) => <li><code class="breaks" dir="ltr">{tool}</code></li>)}</ul>
  </details>
  <Source file={`plugins/wajiha-kit/agents/${name}.md`} label={ui.instructions[locale]} name={`${name}.md`} />
</SourceBlock>
