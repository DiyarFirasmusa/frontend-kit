---
import { agents } from '../../content/catalogue.ts'
import { agentGuides } from '../../content/guide/agents.ts'
import { t } from '../../content/guide/text.ts'
import { ui } from '../../content/guide/ui.ts'
import type { Locale } from '../../content/types.ts'
import { agentUrl } from '../../lib/links.ts'
import AgentBasics from '../guide/AgentBasics.astro'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const words = {
  team: t('The specialists', 'المختصون'),
}
---

<AgentBasics locale={locale} />
<Block id="team" title={words.team[locale]}>
  <ul class="cards">
    {Object.entries(agents).map(([name, job]) => (
      <li>
        <a class="card" href={agentUrl(locale, name)}>
          <strong><bdi>{name}</bdi></strong>
          <span>{job[locale]}. {agentGuides[name]!.plain[locale]}</span>
          <span class="card-say">
            <em>{ui.say[locale]}</em>
            <q dir="auto">{agentGuides[name]!.ask[locale]}</q>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Block>
