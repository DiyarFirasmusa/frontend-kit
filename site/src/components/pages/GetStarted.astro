---
import { after, build, installFlow, limits, maintenance, needs, questions, questionsLead, summary } from '../../content/guide/start.ts'
import { t } from '../../content/guide/text.ts'
import { content } from '../../content/index.ts'
import type { Locale } from '../../content/types.ts'
import { pageUrl } from '../../lib/links.ts'
import CommandBox from '../CommandBox.astro'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { install } = content[locale]
const words = {
  before: t('What you need first', 'ما تحتاجه أولا'),
  beforeLead: t('Two things, once. Claude can help you with the second.', 'شيئان، مرة واحدة. ويستطيع ⁦Claude⁩ مساعدتك في الثاني.'),
  install: t('1. Install the kit', '1. ثبّت الإضافة'),
  answer: t('2. Answer a few questions', '2. أجب عن بضعة أسئلة'),
  approve: t('3. Say yes to the summary', '3. وافق على الملخص'),
  built: t('4. It builds your project', '4. يُبنى مشروعك'),
  files: t('What you get', 'ماذا تحصل عليه'),
  filesLead: t('Your project is ready to open and change. Besides your pages, the kit adds these files.', 'مشروعك جاهز لتفتحه وتغيّره. وإلى جانب صفحاتك، تضيف الإضافة هذه الملفات.'),
  next: t('5. Keep going in plain sentences', '5. تابع بجمل بسيطة'),
  nextLead: t('Say what you want, the way you would tell a person.', 'قل ما تريده كما تقوله لشخص.'),
  examples: t('See what you can say', 'شاهد ما يمكنك أن تقوله'),
  limits: t('What to keep in mind', 'ما يجب أن تتذكره'),
  keep: t('Update, share and remove', 'التحديث والمشاركة والإزالة'),
}
---

<Block id="before" title={words.before[locale]} lead={words.beforeLead[locale]}>
  <ul class="ticks">
    {needs.map(({ name, why, link, linkLabel }) => (
      <li>
        <strong>{name[locale]}.</strong> {why[locale]}
        {link && linkLabel && <> <a href={link} rel="noopener"><bdi>{linkLabel[locale]}</bdi></a></>}
      </li>
    ))}
  </ul>
</Block>
<Block id="install" title={words.install[locale]}>
  <ol class="explained">
    {installFlow.map(({ title, text, copy }) => (
      <li>
        <h3>{title[locale]}</h3>
        <p>{text[locale]}</p>
        {copy && <CommandBox command={typeof copy === 'string' ? copy : copy[locale]} install={install} message={typeof copy !== 'string'} />}
      </li>
    ))}
  </ol>
</Block>
<Block id="questions" title={words.answer[locale]} lead={questionsLead[locale]}>
  {questions.map(({ question, answers }) => (
    <div class="question">
      <h3>{question[locale]}</h3>
      <ul class="plain">{answers.map((answer) => <li>{answer[locale]}</li>)}</ul>
    </div>
  ))}
</Block>
<Block id="approve" title={words.approve[locale]}>
  <h3>{summary.title[locale]}</h3>
  <p class="big">{summary.text[locale]}</p>
</Block>
<Block id="build" title={words.built[locale]}>
  <p class="big">{build.text[locale]}</p>
</Block>
<Block id="after" title={words.next[locale]} lead={words.nextLead[locale]}>
  <ol class="numbered">{after.map((step) => <li>{step[locale]}</li>)}</ol>
  <p><a href={pageUrl(locale, 'examples')}>{words.examples[locale]}</a></p>
</Block>
<Block id="limits" title={words.limits[locale]}><ul class="ticks">{limits.map((item) => <li>{item[locale]}</li>)}</ul></Block>
<Block id="keep" title={words.keep[locale]}>
  {maintenance.map(({ title, text, command }) => (
    <div class="question">
      <h3>{title[locale]}</h3>
      <p class="muted">{text[locale]}</p>
      <CommandBox command={command} install={install} />
    </div>
  ))}
</Block>
