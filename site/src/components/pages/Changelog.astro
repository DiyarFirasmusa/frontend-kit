---
import { t } from '../../content/guide/text.ts'
import type { Locale } from '../../content/types.ts'
import Block from '../guide/Block.astro'
import Source from '../guide/Source.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const title = t('Every version', 'كل الإصدارات')
const note = t(
  'Versions before the rename call the kit frontend-kit. Read that as Wajiha Kit: the commands today use wajiha-kit.',
  'الإصدارات التي سبقت تغيير الاسم تسمي الإضافة ⁦frontend-kit⁩. اقرأها على أنها ⁦Wajiha Kit⁩؛ وتستخدم الأوامر اليوم ⁦wajiha-kit⁩.',
)
---

<Block id="versions" title={title[locale]} lead={note[locale]}><Source file="CHANGELOG.md" /></Block>
