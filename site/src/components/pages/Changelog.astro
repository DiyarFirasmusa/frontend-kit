---
import { t } from '../../content/guide/text.ts'
import type { Locale } from '../../content/types.ts'
import Block from '../guide/Block.astro'
import Source from '../guide/Source.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const title = t('Every version', 'كل الإصدارات')
const note = t(
  'This list is written for developers, in English. What matters to you: after an update, run setup again to get the new rules, because the rules already copied into your project do not change by themselves. Entries written before the rename call the kit frontend-kit. Read that as Wajiha Kit: the commands today use wajiha-kit.',
  'هذا السجل مكتوب للمطورين بالإنجليزية. وما يهمك أنت: بعد كل تحديث شغّل الإعداد مرة أخرى لتصلك القواعد الجديدة، لأن القواعد المنسوخة إلى مشروعك لا تتغير وحدها. والإدخالات المكتوبة قبل تغيير الاسم تسمي الإضافة ⁦frontend-kit⁩. اقرأها على أنها ⁦Wajiha Kit⁩؛ وتستخدم الأوامر اليوم ⁦wajiha-kit⁩.',
)
---

<Block id="versions" title={title[locale]} lead={note[locale]}><Source file="CHANGELOG.md" /></Block>
