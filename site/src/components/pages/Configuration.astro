---
import { sample, settings } from '../../content/guide/configuration.ts'
import { projects } from '../../content/guide/projects.ts'
import { t } from '../../content/guide/text.ts'
import type { Locale } from '../../content/types.ts'
import { templateJson } from '../../lib/reference.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const words = {
  intro: t('You do not need this to start', 'لا تحتاج هذه الصفحة لتبدأ'),
  introText: t(
    'These are the kit’s settings. Setup fills them in for you, so you can build a whole project without opening this page. It is here for the day you want to change something, such as which addresses the safety checks keep the assistant away from, or whether the automatic review runs. The settings live in one small file in your project, .claude/wajiha-kit.json.',
    'هذه إعدادات الإضافة. يملؤها الإعداد لك، فتستطيع بناء مشروع كامل دون أن تفتح هذه الصفحة. وهي هنا ليوم تريد فيه تغيير شيء، مثل العناوين التي يجب ألا يلمسها المساعد أبدا، أو تشغيل المراجعة التلقائية أو إيقافها. وتوجد الإعدادات في ملف صغير واحد داخل مشروعك: ⁦.claude/wajiha-kit.json⁩.',
  ),
  sample: t('An example', 'مثال'),
  shipped: t('What each project type starts with', 'بماذا يبدأ كل نوع مشروع'),
  shippedLead: t('The whole settings file and the whole permissions file that setup starts from, before it fills in your values.', 'محتوى ملف الإعدادات وملف الصلاحيات كاملا، كما يبدأ الإعداد منه قبل أن يضع قيمك.'),
  sampleLead: t('A dashboard with the most useful keys. Setup fills in the rest.', 'لوحة تحكم فيها أهم المفاتيح. ويضيف الإعداد الباقي.'),
}
---

<Block id="intro" title={words.intro[locale]} lead={words.introText[locale]} />
<Block id="example" title={words.sample[locale]} lead={words.sampleLead[locale]}>
  <pre dir="ltr" tabindex="0" role="region" aria-label=".claude/wajiha-kit.json"><code>{sample}</code></pre>
</Block>
{
  settings.map(({ title, keys }) => (
    <Block title={title[locale]}>
      <dl class="rows">
        {keys.map(([key, text]) => (
          <div>
            <dt><code dir="ltr">{key}</code></dt>
            <dd>{text[locale]}</dd>
          </div>
        ))}
      </dl>
    </Block>
  ))
}
<Block id="shipped" title={words.shipped[locale]} lead={words.shippedLead[locale]}>
  {
    projects.flatMap(({ id, name }) =>
      (['wajiha-kit.json', 'settings.json'] as const).map((file) => (
        <details class="file">
          <summary>
            {name[locale]}: <bdi>{file}</bdi>
          </summary>
          <pre dir="ltr" tabindex="0">
            <code>{templateJson(id, file)}</code>
          </pre>
        </details>
      )),
    )
  }
</Block>
