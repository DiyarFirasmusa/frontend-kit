---
import { sample, settings } from '../../content/guide/configuration.ts'
import { projects } from '../../content/guide/projects.ts'
import { t } from '../../content/guide/text.ts'
import type { Locale } from '../../content/types.ts'
import { templateJson } from '../../lib/reference.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const words = {
  sample: t('An example', 'مثال'),
  shipped: t('What each project type ships with', 'شنو يجي مع كل نوع مشروع'),
  shippedLead: t('The whole config and the whole permissions file that setup starts from, before it fills in your values.', 'ملف الإعدادات وملف الصلاحيات كاملين، مثل ما يبدأ منهم الإعداد قبل ما يعبّي قيمك.'),
  sampleLead: t('A dashboard with the most useful keys. Setup fills the rest.', 'لوحة تحكم بأفيد المفاتيح، والإعداد يعبّي الباقي.'),
}
---

<Block id="example" title={words.sample[locale]} lead={words.sampleLead[locale]}>
  <pre dir="ltr" tabindex="0" role="region" aria-label=".claude/frontend-kit.json"><code>{sample}</code></pre>
</Block>
{
  settings.map(({ title, keys }) => (
    <Block title={title[locale]}>
      <dl class="rows">
        {keys.map(([key, text]) => (
          <div>
            <dt><code dir="ltr">{key}</code></dt>
            <dd>{text[locale]}</dd>
          </div>
        ))}
      </dl>
    </Block>
  ))
}
<Block id="shipped" title={words.shipped[locale]} lead={words.shippedLead[locale]}>
  {
    projects.flatMap(({ id, name }) =>
      (['frontend-kit.json', 'settings.json'] as const).map((file) => (
        <details class="file">
          <summary>
            {name[locale]}: <bdi>{file}</bdi>
          </summary>
          <pre dir="ltr" tabindex="0">
            <code>{templateJson(id, file)}</code>
          </pre>
        </details>
      )),
    )
  }
</Block>
