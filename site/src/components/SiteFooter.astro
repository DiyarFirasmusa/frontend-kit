---
import { content } from '../content/index.ts'
import type { Locale } from '../content/types.ts'
import { REPO_URL, version } from '../lib/plugin.ts'

interface Props {
  locale: Locale
}

const { footer } = content[Astro.props.locale]
const links = [
  [REPO_URL, footer.source],
  [`${REPO_URL}/blob/main/CHANGELOG.md`, footer.changelog],
  [`${REPO_URL}/tree/main/examples`, footer.examples],
  [`${REPO_URL}/blob/main/plugins/wajiha-kit/THIRD_PARTY_NOTICES.md`, footer.notices],
] as const
---

<footer class="foot">
  <p dir="ltr">Wajiha Kit <span>v{version}</span></p>
  <ul>{links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
</footer>
