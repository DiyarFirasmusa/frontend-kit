---
import { chapters, tourWords } from '../../content/guide/tour.ts'
import type { Locale } from '../../content/types.ts'
import Block from '../guide/Block.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
// The first is this one.
const rest = chapters.slice(1)
---

<Block title={tourWords.docs[locale]}>
  <ol class="contents">{rest.map(({ id, name }) => <li><a href={`#${id}`}>{name[locale]}</a></li>)}</ol>
</Block>
