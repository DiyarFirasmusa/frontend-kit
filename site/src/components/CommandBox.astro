---
import type { Copy } from '../content/types.ts'

interface Props {
  command: string
  install: Copy['install']
  /** A message in words rather than a command: it wraps and follows the page's language. */
  message?: boolean
}

const { command, install, message = false } = Astro.props
// A message is words and then commands: each command is a line of code, left to right.
const isolates = new RegExp('[\u2066\u2069]', 'g')
const lines = message
  ? command.split(String.fromCharCode(10)).map((line) => {
      const text = line.replace(isolates, '')
      return { text: text.startsWith('claude plugin') ? text : line, command: text.startsWith('claude plugin') }
    })
  : []
const esc = (value: string): string => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
const tokens = (value: string): string => value.split(' ').map((word) => `<span class="tok">${esc(word)}</span>`).join(' ')
---

<div class:list={['command', { 'is-message': message }]} dir={message ? 'auto' : 'ltr'}>
  {
    message ? (
      <code>{lines.map(({ text, command: isCommand }) => (isCommand ? <span class="msg-command" dir="ltr" set:html={tokens(text)} /> : <span class="msg-line">{text}</span>))}</code>
    ) : (
      <code>{command}</code>
    )
  }
  <button type="button" data-copy={command} data-label={install.copy} data-done={install.copied} data-failed={install.failed} aria-label={`${install.copy}: ${command.length > 48 ? `${command.slice(0, 48)}…` : command}`}>
    <span aria-hidden="true" data-status>{install.copy}</span>
  </button>
  <span class="sr-only" role="status" data-announce></span>
</div>
