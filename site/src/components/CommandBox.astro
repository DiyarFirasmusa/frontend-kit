---
import type { Copy } from '../content/types.ts'

interface Props {
  command: string
  install: Copy['install']
}

const { command, install } = Astro.props
---

<div class="command" dir="ltr">
  <code>{command}</code>
  <button type="button" data-copy={command} data-label={install.copy} data-done={install.copied} data-failed={install.failed}>
    <span aria-live="polite" data-status>{install.copy}</span>
  </button>
</div>
