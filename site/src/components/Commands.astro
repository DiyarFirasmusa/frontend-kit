---
import type { Copy } from '../content/types.ts'
import { INSTALL_COMMANDS } from '../lib/plugin.ts'
import CommandBox from './CommandBox.astro'

interface Props {
  install: Copy['install']
  /** Just the first command, for the opening screen. */
  first?: boolean
}

const { install, first = false } = Astro.props
const commands = first ? INSTALL_COMMANDS.slice(0, 1) : INSTALL_COMMANDS
---

<ol class="commands">
  {
    commands.map((command, i) => (
      <li>
        <p class:list={['command-name', { 'sr-only': first }]}>{install.steps[i]}</p>
        <CommandBox command={command} install={install} />
      </li>
    ))
  }
</ol>
